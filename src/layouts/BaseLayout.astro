---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = "Blanc Engine: No-Code Visual Novel Engine",
  description = "An open-source, no-code desktop visual novel creation suite & standalone runtime. Write your story, customize menus visually, and export a Windows game.",
  ogImage = "/screenshots/SS_STORYFLOW.png",
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://getblanc.web.id";

function normalizePath(p: string): string {
  if (!p || p === "/" || p === "/index.html") return "/";
  const cleaned = p.replace(/\/index\.html$/, "");
  return cleaned.endsWith("/") ? cleaned : `${cleaned}/`;
}

const normalizedPath = normalizePath(Astro.url.pathname);
const canonicalUrl = `${siteOrigin}${normalizedPath}`;
const ogImageUrl = new URL(ogImage, siteOrigin).toString();
const isHome = normalizedPath === "/";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Blanc Engine",
  softwareVersion: "0.1.1",
  operatingSystem: "Windows 10, Windows 11",
  applicationCategory: "DeveloperApplication",
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  downloadUrl: `${siteOrigin}/download/`,
  screenshot: `${siteOrigin}/screenshots/SS_STORYFLOW.png`,
  featureList: [
    "No-code screenplay story setup",
    "Visual Story Flow node graph",
    "Live-preview UI Designer",
    "Multi-language CSV localization",
    "Standalone Windows Setup.exe and Portable export",
  ],
  description,
  url: siteOrigin,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Blanc Engine",
  url: siteOrigin,
  logo: `${siteOrigin}/logo.png`,
  sameAs: [
    "https://github.com/Kharisdestianmaulana-hub/blanc-engine",
    "https://discord.gg/GcQMrRXa9Z",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Blanc Engine",
  url: siteOrigin,
};

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((item, idx) => ({
          "@type": "ListItem",
          position: idx + 1,
          name: item.name,
          item: `${siteOrigin}${normalizePath(item.path)}`,
        })),
      }
    : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="iiaTVNmPL-JoNqBd8kL7hFx0UdiZMuqQg0JLoRd17wM" />
    <meta name="google-site-verification" content="X60FW2jNmPnz-gT65tlUcSe--ZAQoFq4nAEWVWUn0dY" />
    <meta name="theme-color" content="#17191D" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blanc Engine" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>

    {
      isHome && (
        <>
          <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
          <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
          <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
        </>
      )
    }
    {
      breadcrumbSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
      )
    }

    <script is:inline>
      (function () {
        const saved = localStorage.getItem("blanc-theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary selection:bg-accent-primary selection:text-text-on-accent">
    <slot />

    <!-- Global Flat Back to Top Button -->
    <button
      id="back-to-top"
      type="button"
      aria-label="Back to top"
      class="fixed right-5 bottom-5 z-40 hidden h-9 w-9 items-center justify-center rounded-md border border-border-default bg-surface-primary text-text-secondary transition-colors hover:border-border-default hover:bg-surface-hover hover:text-text-primary cursor-pointer shadow-md"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m18 15-6-6-6 6" />
      </svg>
    </button>

    <!-- Lenis Smooth Inertia Scroll (Public pages only - disabled on studio CMS for native desktop scrolling) -->
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const isStudio =
        window.location.pathname.includes("manage-cms") ||
        window.location.pathname.includes("admin");

      if (!isStudio) {
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: "vertical",
          gestureOrientation: "vertical",
          smoothWheel: true,
          wheelMultiplier: 1.0,
          touchMultiplier: 1.5,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        // Back to top & anchor clicks
        const backBtn = document.getElementById("back-to-top");
        if (backBtn) {
          const toggle = () => {
            if (window.scrollY > 400) {
              backBtn.classList.remove("hidden");
              backBtn.classList.add("inline-flex");
            } else {
              backBtn.classList.add("hidden");
              backBtn.classList.remove("inline-flex");
            }
          };
          window.addEventListener("scroll", toggle, { passive: true });
          backBtn.addEventListener("click", () => {
            lenis.scrollTo(0, { duration: 1.2 });
          });
          toggle();
        }

        // Smooth anchor scrolling
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            const href = anchor.getAttribute("href");
            if (!href || href === "#") return;
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, { offset: -70, duration: 1.2 });
            }
          });
        });
      }
    </script>
  </body>
</html>
