---
import { Milestone, ArrowRight, Calendar, Sparkles } from "lucide-astro";
---

<section id="roadmap" class="border-b border-border-default bg-bg-primary py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2">
          <Milestone class="h-4 w-4 text-accent-primary" />
          <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
            What's Next
          </span>
        </div>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
          Upcoming Features & Milestones
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
          A glimpse into active development and upcoming releases. Synced live directly from the core team.
        </p>
      </div>

      <a
        href="/roadmap"
        class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3.5 text-xs font-medium text-text-primary transition-colors hover:border-accent-primary hover:bg-surface-hover"
      >
        <span>View Full Roadmap</span>
        <ArrowRight class="h-3.5 w-3.5 text-accent-primary" />
      </a>
    </div>

    <!-- 3-Card Spotlight Grid -->
    <div id="landing-roadmap-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Skeleton Loading State -->
      <div class="h-48 rounded-lg border border-border-default bg-surface-primary p-5 animate-pulse"></div>
      <div class="h-48 rounded-lg border border-border-default bg-surface-primary p-5 animate-pulse"></div>
      <div class="h-48 rounded-lg border border-border-default bg-surface-primary p-5 animate-pulse"></div>
    </div>

    <!-- Bottom Action Pill -->
    <div class="mt-8 flex flex-col items-center justify-between gap-3 rounded-lg border border-border-default bg-surface-primary p-4 text-center sm:flex-row sm:text-left">
      <div class="flex items-center gap-2 text-xs text-text-secondary sm:text-sm">
        <Sparkles class="h-4 w-4 shrink-0 text-accent-primary" />
        <span>Want to suggest a new feature or shape the future of visual novel creation?</span>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a
          href="/feedback"
          class="rounded-md border border-border-default bg-surface-elevated px-3 py-1.5 text-xs font-medium text-text-primary transition-colors hover:bg-surface-hover"
        >
          Submit Feedback
        </a>
        <a
          href="/roadmap"
          class="rounded-md bg-accent-primary px-3 py-1.5 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover"
        >
          Explore All Features
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const SHEET_GVIZ_URL =
    "https://docs.google.com/spreadsheets/d/1VCNAuxsX3QyiQtOONYbZYZIUbRRhjrd9oaMddh_8O7g/gviz/tq?tqx=out:json&gid=49098070&headers=1";

  const gridEl = document.getElementById("landing-roadmap-grid");

  function esc(str: string): string {
    if (!str) return "";
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatDateString(rawVal: string, formattedVal?: string): string {
    if (formattedVal && !formattedVal.startsWith("Date(")) {
      const parsed = new Date(formattedVal);
      if (!isNaN(parsed.getTime())) {
        return parsed.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
      }
      return formattedVal;
    }

    const match = rawVal.match(/Date\((\d+),\s*(\d+),\s*(\d+)\)/);
    if (match) {
      const y = parseInt(match[1], 10);
      const m = parseInt(match[2], 10);
      const d = parseInt(match[3], 10);
      const dateObj = new Date(y, m, d);
      if (!isNaN(dateObj.getTime())) {
        return dateObj.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
      }
    }

    return rawVal;
  }

  function getStatusClasses(status: string) {
    const s = (status || "").toLowerCase().trim();
    if (s === "in progress" || s === "progress") {
      return {
        badge: "border-accent-primary text-accent-primary bg-accent-subtle",
        dot: "bg-accent-primary",
        label: "In Progress",
      };
    }
    if (s === "coming soon" || s === "soon") {
      return {
        badge: "border-status-info text-status-info bg-surface-primary",
        dot: "bg-status-info",
        label: "Coming Soon",
      };
    }
    if (s === "completed" || s === "done" || s === "released") {
      return {
        badge: "border-status-success text-status-success bg-surface-primary",
        dot: "bg-status-success",
        label: "Ready for Release",
      };
    }
    return {
      badge: "border-status-warning text-status-warning bg-surface-primary",
      dot: "bg-status-warning",
      label: s ? status : "Planned",
    };
  }

  interface RoadmapCardItem {
    version: string;
    targetDate: string;
    status: string;
    category: string;
    title: string;
    description: string;
  }

  const fallbackItems: RoadmapCardItem[] = [
    {
      version: "v0.1.1",
      targetDate: "Nov 20, 2026",
      status: "Completed",
      category: "Security & Core",
      title: "Atomic File Writes & Corruption Guard",
      description:
        "Replaced direct writes with atomic temp-file writes for .blanc, scenes, settings, and saves to prevent corruption on unexpected shutdowns.",
    },
    {
      version: "v0.2.0",
      targetDate: "Dec 25, 2026",
      status: "Planned",
      category: "UI & UX",
      title: "Next-Gen Free-Form UI Canvas Studio",
      description:
        "3-panel studio (Hierarchy, 1920x1080 Gizmo Canvas, Inspector) for free-form drag-and-drop menu design, nine-slice margins, and zero-code data binding.",
    },
    {
      version: "v0.2.0",
      targetDate: "Dec 25, 2026",
      status: "Planned",
      category: "Core & Story Flow",
      title: "Visual Variables & Condition Branching",
      description:
        "Variable Manager (Boolean, Number, String), Modify Variable action blocks, and Condition Nodes in Story Flow for multi-ending route logic.",
    },
  ];

  function renderCards(items: RoadmapCardItem[]) {
    if (!gridEl) return;

    gridEl.innerHTML = items
      .map((item) => {
        const st = getStatusClasses(item.status);
        return `
        <article class="flex flex-col justify-between rounded-lg border border-border-default bg-surface-primary p-5 transition-colors hover:border-accent-primary">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-border-subtle pb-3">
              <div class="flex items-center gap-1.5">
                <span class="rounded border border-border-default bg-accent-subtle px-2 py-0.5 font-mono text-xs font-bold text-accent-primary">
                  ${esc(item.version)}
                </span>
                <span class="rounded border border-border-default bg-surface-elevated px-1.5 py-0.5 font-mono text-[11px] text-text-secondary">
                  ${esc(item.category || "General")}
                </span>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded border px-2 py-0.5 text-[11px] font-semibold ${st.badge}">
                <span class="h-1.5 w-1.5 rounded-full ${st.dot}"></span>
                <span>${esc(st.label)}</span>
              </span>
            </div>

            <h3 class="mt-3.5 text-base font-semibold text-text-primary leading-snug">
              ${esc(item.title)}
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-text-secondary sm:text-sm line-clamp-3">
              ${esc(item.description)}
            </p>
          </div>

          ${
            item.targetDate
              ? `
            <div class="mt-4 flex items-center gap-1.5 border-t border-border-subtle pt-3 text-[11px] text-text-muted">
              <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Target: <strong class="text-text-secondary font-medium">${esc(item.targetDate)}</strong></span>
            </div>
          `
              : ""
          }
        </article>
      `;
      })
      .join("");
  }

  async function loadRoadmapPreview() {
    if (!gridEl) return;

    try {
      const res = await fetch(SHEET_GVIZ_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]+)\);?/);
      if (!match) throw new Error("Invalid sheet response");

      const json = JSON.parse(match[1]);
      const rows = json?.table?.rows || [];

      const parsed: RoadmapCardItem[] = [];
      for (const row of rows) {
        const c = row.c || [];
        const getVal = (idx: number) => (c[idx] && c[idx].v != null ? String(c[idx].v).trim() : "");
        const getFmt = (idx: number) => (c[idx] && c[idx].f != null ? String(c[idx].f).trim() : "");

        const version = getVal(0);
        const title = getVal(4);
        if (!title || title.toLowerCase() === "title") continue;

        const dateRaw = getVal(1);
        const dateFmt = getFmt(1);
        const targetDate = formatDateString(dateRaw, dateFmt);

        parsed.push({
          version: version || "Upcoming",
          targetDate,
          status: getVal(2) || "Planned",
          category: getVal(3) || "General",
          title,
          description: getVal(5) || "",
        });
      }

      if (parsed.length > 0) {
        // Pick 1 from earliest version (e.g. v0.1.1) and 2 from next major version (e.g. v0.2.0)
        const v1Items = parsed.filter((i) => i.version.toLowerCase() === "v0.1.1");
        const v2Items = parsed.filter((i) => i.version.toLowerCase() !== "v0.1.1");

        let selected: RoadmapCardItem[] = [];
        if (v1Items.length > 0 && v2Items.length > 0) {
          selected = [v1Items[0], v2Items[0], v2Items[1] || v1Items[1] || v2Items[0]];
        } else {
          selected = parsed.slice(0, 3);
        }

        renderCards(selected);
      } else {
        renderCards(fallbackItems);
      }
    } catch {
      renderCards(fallbackItems);
    }
  }

  loadRoadmapPreview();
</script>
