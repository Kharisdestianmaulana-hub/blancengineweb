---
import { Check } from "lucide-astro";

const steps = [
  {
    num: "01",
    title: "Write Your Story",
    tag: "Story Setup",
    description:
      "Type your script like a simple movie screenplay with speaker names, emotions, background music, and player choices.",
    highlights: [
      "Natural dialogue format, no coding syntax",
      "Automatic conversion into editable visual scenes",
      "Built-in support for branching choices",
    ],
  },
  {
    num: "02",
    title: "Design Flow & Menus",
    tag: "Visual Editor",
    description:
      "Connect chapters and endings on a visual map, adjust character expressions, and style your Title Screen and Dialogue Box with live preview.",
    highlights: [
      "Drag-and-drop Story Flow map for routes and endings",
      "Live preview for Title Screen, HUD, and Save/Load menus",
      "Easy visual effects like Fade, Flash, and Shake",
    ],
  },
  {
    num: "03",
    title: "Share Your Game",
    tag: "One-Click Export",
    description:
      "Export a standalone Windows game or a branded Setup installer so anyone can play your visual novel right away.",
    highlights: [
      "Portable build for instant play from a folder",
      "Windows Setup.exe with custom icon and uninstaller",
      "Built-in multi-language support via Excel/CSV",
    ],
  },
];
---

<section id="workflow" class="border-b border-border-default bg-bg-secondary py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
        How It Works
      </span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Three simple steps from story idea to playable game
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
        Made for writers, artists, and indie creators who want to focus on storytelling.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        steps.map((step) => (
          <article class="flex min-w-0 flex-col justify-between rounded-lg border border-border-default bg-surface-primary p-5">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-accent-primary">{step.num}</span>
                <span class="rounded border border-border-default bg-bg-secondary px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                  {step.tag}
                </span>
              </div>
              <h3 class="mt-4 text-lg font-semibold text-text-primary">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-secondary">{step.description}</p>
            </div>

            <ul class="mt-5 space-y-2 border-t border-border-subtle pt-4">
              {
                step.highlights.map((item) => (
                  <li class="flex items-start gap-2 text-xs leading-relaxed text-text-secondary">
                    <Check class="mt-0.5 h-3.5 w-3.5 shrink-0 text-status-success" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
