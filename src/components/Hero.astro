---
import { Download, Sparkles, Gamepad2, ArrowUpRight } from "lucide-astro";
---

<section
  id="hero-section"
  class="relative flex min-h-[calc(100dvh-7rem)] items-center border-b border-border-default bg-bg-primary py-10 sm:py-14 lg:py-16 overflow-hidden"
>
  <!-- Parallax Slideshow Background (Populated dynamically when approved showcase games exist) -->
  <div id="hero-bg-wrapper" class="pointer-events-none absolute inset-0 z-0 opacity-0 transition-opacity duration-1000">
    <div
      id="hero-bg-layer-1"
      class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-1000"
      style="background-attachment: fixed;"
    ></div>
    <div
      id="hero-bg-layer-2"
      class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0 transition-opacity duration-1000"
      style="background-attachment: fixed;"
    ></div>

    <!-- Soft Readability Overlays: gentle gradient behind text, clear artwork on the right -->
    <div class="absolute inset-0 bg-gradient-to-r from-bg-primary/80 via-bg-primary/40 to-transparent"></div>
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6">
    <div class="max-w-3xl">
      <!-- Headline -->
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-text-primary drop-shadow-[0_2px_4px_rgba(0,0,0,0.7)] sm:text-4xl xl:text-5xl">
        Create &amp; Share Your Own <span class="text-accent-primary">Visual Novel</span>, Zero Code.
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-secondary drop-shadow-[0_1px_3px_rgba(0,0,0,0.6)] sm:text-lg">
        Write your story like a screenplay, design your characters and menus visually, and package a ready-to-play Windows game in one simple desktop app.
      </p>

      <!-- CTA Buttons: Godot-Style Split Download Group (Version Left + Download Right) -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <!-- Connected Download Group -->
        <div class="inline-flex rounded-md shadow-lg transition-transform active:scale-[0.99]">
          <!-- Left: Version Pill -->
          <a
            href="/download#previous-versions"
            id="hero-version-badge"
            class="inline-flex h-11 items-center justify-center rounded-l-md bg-accent-primary px-3.5 sm:px-4 font-mono text-xs font-bold text-text-on-accent transition-colors hover:bg-accent-hover border-r border-black/10 cursor-pointer"
            title="View version details and history"
          >
            v0.1.1
          </a>
          <!-- Right: Download Latest Button -->
          <a
            id="hero-download-btn"
            href="/download"
            class="inline-flex h-11 items-center gap-2 rounded-r-md bg-white px-4 sm:px-5 text-sm font-bold text-slate-950 transition-colors hover:bg-slate-100"
          >
            <Download class="h-4 w-4 shrink-0 text-slate-950" />
            <span>Download Latest</span>
          </a>
        </div>

        <!-- What's New Button (Glassmorphic) -->
        <a
          href="/changelog"
          class="inline-flex h-11 items-center gap-2 rounded-md border border-white/20 bg-black/40 px-4 sm:px-5 text-sm font-medium text-white backdrop-blur-md transition-colors hover:bg-black/60 hover:border-white/30 shadow-md"
        >
          <Sparkles class="h-4 w-4 text-accent-primary shrink-0" />
          <span>What's New</span>
        </a>
      </div>

      <!-- Metadata & Previous Version Links -->
      <div class="mt-6 space-y-1.5">
        <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-text-muted">
          <span>No-Code Visual Novel Studio</span>
          <span aria-hidden="true">·</span>
          <a href="/download" class="inline-flex items-center gap-1.5 text-text-secondary transition-colors hover:text-accent-primary">
            <Download class="h-3.5 w-3.5 text-accent-primary" />
            <span id="hero-total-downloads">0 downloads</span>
          </a>
        </p>

        <p class="text-xs text-text-muted">
          Want to see{" "}
          <a
            href="/download#previous-versions"
            class="font-medium text-indigo-400 underline underline-offset-2 transition-colors hover:text-indigo-300"
          >
            previous version?
          </a>
        </p>
      </div>
    </div>
  </div>

  <!-- Community Showcase Credit Badge (Bottom Right) -->
  <a
    id="hero-credit-badge"
    href="/showcase"
    class="pointer-events-auto absolute bottom-4 right-4 sm:bottom-5 sm:right-6 z-20 hidden items-center gap-2 rounded-full border border-border-default bg-surface-primary/90 px-3.5 py-1.5 font-mono text-xs text-text-secondary shadow-lg backdrop-blur-md transition-all hover:border-accent-primary hover:bg-surface-hover hover:text-text-primary"
    title="View this game in showcase"
  >
    <Gamepad2 class="h-3.5 w-3.5 text-accent-primary shrink-0" />
    <span class="text-text-muted">Art:</span>
    <span id="hero-credit-text" class="truncate max-w-[180px] sm:max-w-xs font-semibold text-text-primary">Featured Game</span>
    <ArrowUpRight class="h-3.5 w-3.5 text-text-muted shrink-0" />
  </a>
</section>

<script>
  interface ShowcaseGame {
    title: string;
    author: string;
    cover: string;
    url: string;
  }

  const SHEET_URL =
    "https://docs.google.com/spreadsheets/d/1VCNAuxsX3QyiQtOONYbZYZIUbRRhjrd9oaMddh_8O7g/gviz/tq?tqx=out:json&gid=658897965&headers=1";

  const heroDownloadsEl = document.getElementById("hero-total-downloads");
  const heroVersionBadge = document.getElementById("hero-version-badge");
  const heroBgWrapper = document.getElementById("hero-bg-wrapper");
  const heroBgLayer1 = document.getElementById("hero-bg-layer-1");
  const heroBgLayer2 = document.getElementById("hero-bg-layer-2");
  const heroCreditBadge = document.getElementById("hero-credit-badge") as HTMLAnchorElement | null;
  const heroCreditText = document.getElementById("hero-credit-text");

  function setDownloadsText(n: number) {
    if (!heroDownloadsEl) return;
    heroDownloadsEl.textContent = `${n.toLocaleString("en-US")} download${n === 1 ? "" : "s"}`;
  }

  async function loadHeroStats() {
    // 1. Restore cached version if exists
    const savedVersion = localStorage.getItem("blanc-latest-version");
    if (savedVersion && heroVersionBadge) {
      heroVersionBadge.textContent = savedVersion;
    }

    // 2. Restore cached download count
    const savedDownloads = localStorage.getItem("blanc-last-total-downloads");
    if (savedDownloads !== null && !Number.isNaN(Number(savedDownloads))) {
      setDownloadsText(Number(savedDownloads));
    }

    // 3. Fetch latest release version from GitHub API
    try {
      const relRes = await fetch("https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases/latest", {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (relRes.ok) {
        const relData = await relRes.json();
        if (relData && relData.tag_name && heroVersionBadge) {
          heroVersionBadge.textContent = relData.tag_name;
          localStorage.setItem("blanc-latest-version", relData.tag_name);
        }
      }
    } catch {
      // Keep fallback version
    }

    // 4. Fetch total downloads
    try {
      const apiRes = await fetch("/api/github-stats");
      if (apiRes.ok) {
        const stats = await apiRes.json();
        if (typeof stats.totalDownloads === "number") {
          localStorage.setItem("blanc-last-total-downloads", String(stats.totalDownloads));
          setDownloadsText(stats.totalDownloads);
          return;
        }
      }
    } catch {
      // Fallback
    }

    try {
      const res = await fetch("https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases", {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!res.ok) return;
      const releases = await res.json();
      if (!Array.isArray(releases)) return;

      let total = 0;
      for (const rel of releases) {
        if (rel.draft || !Array.isArray(rel.assets)) continue;
        for (const asset of rel.assets) {
          if (typeof asset.download_count === "number") {
            total += asset.download_count;
          }
        }
      }

      localStorage.setItem("blanc-last-total-downloads", String(total));
      setDownloadsText(total);
    } catch {
      // Keep last known count
    }
  }

  async function initShowcaseHeroBackground() {
    if (!heroBgWrapper || !heroBgLayer1 || !heroBgLayer2 || !heroCreditBadge || !heroCreditText) return;

    try {
      const res = await fetch(SHEET_URL);
      if (!res.ok) return;
      const text = await res.text();
      const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]+)\);?/);
      if (!match) return;

      const json = JSON.parse(match[1]);
      const rows = json?.table?.rows || [];
      const games: ShowcaseGame[] = [];

      const toSlug = (str: string) =>
        str
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");

      for (const row of rows) {
        const c = row.c || [];
        const getVal = (idx: number) => (c[idx] && c[idx].v != null ? String(c[idx].v).trim() : "");
        const approvedRaw = getVal(8).toLowerCase();
        const isApproved = approvedRaw === "true" || approvedRaw === "1" || approvedRaw === "yes";
        const title = getVal(1);
        const cover = getVal(5);

        if (!title || title.toLowerCase() === "game title" || !isApproved || !cover) continue;

        games.push({
          title,
          author: getVal(2) || "Community Creator",
          cover,
          url: `/showcase/game/?id=${encodeURIComponent(toSlug(title))}`,
        });
      }

      if (games.length === 0) {
        // Fallback: keep clean default hero background
        return;
      }

      // Approved showcase games exist: activate background and credit badge
      heroBgWrapper.classList.remove("opacity-0");
      heroCreditBadge.classList.remove("hidden");
      heroCreditBadge.classList.add("inline-flex");

      let currentIndex = 0;
      let activeLayer = 1;

      const applyGame = (game: ShowcaseGame, targetLayer: number) => {
        const targetEl = targetLayer === 1 ? heroBgLayer1 : heroBgLayer2;
        const otherEl = targetLayer === 1 ? heroBgLayer2 : heroBgLayer1;

        targetEl.style.backgroundImage = `url("${game.cover}")`;
        targetEl.classList.remove("opacity-0");
        otherEl.classList.add("opacity-0");

        heroCreditText.textContent = `${game.title} by ${game.author}`;
        heroCreditBadge.href = game.url;
      };

      // Apply initial game to layer 1
      applyGame(games[0], 1);

      // If multiple approved games exist, rotate every 30 seconds
      if (games.length > 1) {
        setInterval(() => {
          currentIndex = (currentIndex + 1) % games.length;
          const nextGame = games[currentIndex];

          // Preload image before crossfading
          const img = new Image();
          img.src = nextGame.cover;
          img.onload = () => {
            activeLayer = activeLayer === 1 ? 2 : 1;
            applyGame(nextGame, activeLayer);
          };
        }, 30000);
      }
    } catch {
      // Silently fall back to default hero background
    }
  }

  loadHeroStats();
  initShowcaseHeroBackground();
</script>
