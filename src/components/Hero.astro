---
import { Gamepad2, Download } from "lucide-astro";

const previews = [
  {
    id: "story-flow",
    label: "Story Flow",
    caption: "Node-based branching graph connecting Main Menu, Scenes, Choices, and Endings.",
    src: "/screenshots/SS_STORYFLOW.png",
    alt: "Blanc Engine Story Flow Node Graph Editor",
  },
  {
    id: "ui-designer",
    label: "UI Designer",
    caption: "Live-preview customization for Title Screen, Dialogue Box, HUD, and Pause/Settings menus.",
    src: "/screenshots/SS_UI_DESIGNER.png",
    alt: "Blanc Engine Live Preview UI Designer",
  },
  {
    id: "gameplay",
    label: "Gameplay Runtime",
    caption: "Standalone Rust runtime with typewriter reveal, sprite transitions, Auto-Play, and Skip modes.",
    src: "/screenshots/SS_GAMEPLAY_2_CHARACTER.png",
    alt: "Blanc Engine Multi-Character Gameplay Runtime",
  },
  {
    id: "installer",
    label: "Setup Wizard",
    caption: "Built-in 6-language Windows Setup.exe packager with custom branding and clean uninstaller.",
    src: "/screenshots/SS_SETUP_WIZARD.png",
    alt: "Blanc Engine Windows Setup Wizard",
  },
];
---

<section class="flex min-h-[calc(100dvh-4rem)] items-center border-b border-border-default bg-bg-primary py-10 sm:py-12">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Left: Copy & Actions -->
      <div class="min-w-0 lg:col-span-5">
        <!-- Headline -->
        <h1 class="text-3xl font-bold leading-tight tracking-tight text-text-primary sm:text-4xl xl:text-5xl">
          Create &amp; Share Your Own <span class="text-accent-primary">Visual Novel</span>, Zero Code.
        </h1>
        <p class="mt-4 text-base leading-relaxed text-text-secondary">
          Write your story like a screenplay, design your characters and menus visually, and package a ready-to-play Windows game in one simple desktop app.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/download"
            class="inline-flex h-11 items-center gap-2 rounded-md bg-accent-primary px-5 text-sm font-semibold text-text-on-accent transition-colors hover:bg-accent-hover active:bg-accent-pressed"
          >
            <Download class="h-4 w-4" />
            <span>Download Free</span>
          </a>
          <a
            href="/showcase"
            class="inline-flex h-11 items-center gap-2 rounded-md border border-border-default bg-surface-primary px-5 text-sm font-medium text-text-primary transition-colors hover:bg-surface-hover"
          >
            <Gamepad2 class="h-4 w-4 text-text-secondary" />
            <span>Explore Showcase</span>
          </a>
        </div>

        <!-- Plain Metadata Text -->
        <p class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-text-muted">
          <span>No-Code Visual Novel Studio</span>
          <span aria-hidden="true">·</span>
          <a href="/download" class="inline-flex items-center gap-1.5 text-text-secondary transition-colors hover:text-accent-primary">
            <Download class="h-3.5 w-3.5 text-accent-primary" />
            <span id="hero-total-downloads">0 downloads</span>
          </a>
        </p>
      </div>

      <!-- Right: Flat Interactive Screenshot Showcase -->
      <div class="min-w-0 lg:col-span-7">
        <div class="rounded-lg border border-border-default bg-surface-primary">
          <!-- Window Header / Tab Bar -->
          <div class="flex flex-col gap-3 border-b border-border-default bg-bg-secondary px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Blanc Engine Editor Previews">
              {
                previews.map((item, idx) => (
                  <button
                    type="button"
                    role="tab"
                    data-preview-tab={item.id}
                    aria-selected={idx === 0 ? "true" : "false"}
                    class:list={[
                      "rounded-md border px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer",
                      idx === 0
                        ? "border-accent-primary bg-accent-subtle text-accent-primary"
                        : "border-transparent bg-transparent text-text-secondary hover:bg-surface-hover hover:text-text-primary",
                    ]}
                  >
                    {item.label}
                  </button>
                ))
              }
            </div>
            <span class="font-mono text-xs text-text-muted">Editor Preview</span>
          </div>

          <!-- Active Image Panels -->
          <div class="p-3 sm:p-4">
            {
              previews.map((item, idx) => (
                <div data-preview-panel={item.id} class:list={[idx !== 0 && "hidden"]}>
                  <div class="overflow-hidden rounded-md border border-border-subtle bg-bg-primary">
                    <img
                      src={item.src}
                      alt={item.alt}
                      class="aspect-video w-full object-cover object-top"
                      loading={idx === 0 ? "eager" : "lazy"}
                    />
                  </div>
                  <p class="mt-3 text-xs text-text-secondary sm:text-sm">
                    {item.caption}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-preview-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-preview-panel]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.getAttribute("data-preview-tab");

      tabs.forEach((t) => {
        const active = t.getAttribute("data-preview-tab") === target;
        t.setAttribute("aria-selected", String(active));
        t.classList.toggle("border-accent-primary", active);
        t.classList.toggle("bg-accent-subtle", active);
        t.classList.toggle("text-accent-primary", active);
        t.classList.toggle("border-transparent", !active);
        t.classList.toggle("bg-transparent", !active);
        t.classList.toggle("text-text-secondary", !active);
      });

      panels.forEach((panel) => {
        const match = panel.getAttribute("data-preview-panel") === target;
        panel.classList.toggle("hidden", !match);
      });
    });
  });

  const heroDownloadsEl = document.getElementById("hero-total-downloads");

  function setDownloadsText(n: number) {
    if (!heroDownloadsEl) return;
    heroDownloadsEl.textContent = `${n.toLocaleString("en-US")} download${n === 1 ? "" : "s"}`;
  }

  async function loadHeroTotalDownloads() {
    if (!heroDownloadsEl) return;

    const savedLast = localStorage.getItem("blanc-last-total-downloads");
    if (savedLast !== null && !Number.isNaN(Number(savedLast))) {
      setDownloadsText(Number(savedLast));
    }

    try {
      const apiRes = await fetch("/api/github-stats");
      if (apiRes.ok) {
        const stats = await apiRes.json();
        if (typeof stats.totalDownloads === "number") {
          localStorage.setItem("blanc-last-total-downloads", String(stats.totalDownloads));
          setDownloadsText(stats.totalDownloads);
          return;
        }
      }
    } catch {
      // Fallback to direct GitHub API in local dev
    }

    try {
      const res = await fetch("https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases", {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!res.ok) return;
      const releases = await res.json();
      if (!Array.isArray(releases)) return;

      let total = 0;
      for (const rel of releases) {
        if (rel.draft || !Array.isArray(rel.assets)) continue;
        for (const asset of rel.assets) {
          if (typeof asset.download_count === "number") {
            total += asset.download_count;
          }
        }
      }

      localStorage.setItem("blanc-last-total-downloads", String(total));
      setDownloadsText(total);
    } catch {
      // Keep last known count
    }
  }

  loadHeroTotalDownloads();
</script>
