---
import { Moon, Sun, Github, Download, Menu, X, Star, MoreHorizontal, History, MessageSquare, Gamepad2, ArrowRight } from "lucide-astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const mainNavLinks = [
  { href: "/docs", label: "Docs" },
  { href: "/blog", label: "Blog" },
  { href: "/showcase", label: "Showcase" },
  { href: "/roadmap", label: "Roadmap" },
];

const mobileNavLinks = [
  ...mainNavLinks,
  { href: "/changelog", label: "Changelog" },
  { href: "/feedback", label: "Feedback" },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full transition-all duration-200">
  <div
    id="nav-shell"
    class="w-full border-b border-border-default/80 bg-bg-secondary/80 backdrop-blur-md transition-all duration-200"
  >
    <div id="nav-inner" class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 transition-all duration-200">
      <!-- Left Side: Brand + Primary Desktop Nav (Aligned Left ala Godot) -->
      <div class="flex items-center gap-4 lg:gap-6">
        <!-- Brand -->
        <a href="/" class="group flex items-center gap-2.5 rounded-md px-1 py-1 text-text-primary transition-colors hover:text-white shrink-0">
          <img src="/logo.png" alt="Blanc Engine Logo" class="h-8 w-8 rounded-md object-contain transition-transform group-hover:scale-105" />
          <span id="nav-brand-text" class="text-base font-semibold tracking-tight transition-all duration-200">Blanc Engine</span>
          <span id="nav-version-tag" class="hidden rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] font-medium text-text-secondary sm:inline-block transition-all duration-200">
            v0.1.0
          </span>
        </a>

        <!-- Desktop Navigation: 4 Main Links + More Popover -->
        <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
          {
            mainNavLinks.map((link) => {
              const isActive = pathname === link.href;
              return (
                <a
                  href={link.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "rounded-md px-2.5 lg:px-3 py-1.5 text-xs lg:text-[13px] font-medium transition-colors",
                    isActive
                      ? "bg-surface-elevated text-text-primary font-semibold"
                      : "text-text-secondary hover:bg-surface-hover hover:text-text-primary",
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }

          <!-- More Popover (•••) -->
          <div class="relative group/more">
            <button
              id="nav-more-btn"
              type="button"
              aria-label="More navigation links"
              class="inline-flex items-center justify-center rounded-md px-2 py-1.5 text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer group-hover/more:bg-surface-hover group-hover/more:text-text-primary"
            >
              <MoreHorizontal class="h-4 w-4" />
            </button>

            <!-- Popover floating card -->
            <div class="pointer-events-none absolute left-0 top-full pt-2 opacity-0 translate-y-1 transition-all duration-150 ease-out group-hover/more:pointer-events-auto group-hover/more:opacity-100 group-hover/more:translate-y-0 z-50">
              <div class="w-64 rounded-xl border border-border-default bg-surface-primary/95 p-1.5 shadow-2xl backdrop-blur-xl">
                <!-- Changelog -->
                <a
                  href="/changelog"
                  class="flex items-start gap-3 rounded-lg p-2.5 transition-colors hover:bg-surface-hover group/item"
                >
                  <div class="rounded-md border border-border-default bg-surface-elevated p-1.5 text-text-muted group-hover/item:border-accent-primary/40 group-hover/item:text-accent-primary transition-colors shrink-0">
                    <History class="h-4 w-4" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-semibold text-text-primary group-hover/item:text-accent-primary transition-colors">
                      Changelog
                    </p>
                    <p class="text-[11px] text-text-muted leading-tight mt-0.5">
                      Technical release notes & versions
                    </p>
                  </div>
                </a>

                <!-- Feedback -->
                <a
                  href="/feedback"
                  class="flex items-start gap-3 rounded-lg p-2.5 transition-colors hover:bg-surface-hover group/item"
                >
                  <div class="rounded-md border border-border-default bg-surface-elevated p-1.5 text-text-muted group-hover/item:border-accent-primary/40 group-hover/item:text-accent-primary transition-colors shrink-0">
                    <MessageSquare class="h-4 w-4" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-semibold text-text-primary group-hover/item:text-accent-primary transition-colors">
                      Community Feedback
                    </p>
                    <p class="text-[11px] text-text-muted leading-tight mt-0.5">
                      Propose features & report bugs
                    </p>
                  </div>
                </a>

                <div class="my-1 border-t border-border-subtle"></div>

                <!-- Discord Community -->
                <a
                  href="https://discord.gg/GcQMrRXa9Z"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-3 rounded-lg p-2.5 transition-colors hover:bg-surface-hover group/item"
                >
                  <div class="rounded-md border border-border-default bg-surface-elevated p-1.5 text-text-muted group-hover/item:border-[#5865F2]/40 group-hover/item:text-[#5865F2] transition-colors shrink-0">
                    <Gamepad2 class="h-4 w-4" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5">
                      <p class="text-xs font-semibold text-text-primary group-hover/item:text-accent-primary transition-colors">
                        Discord Community
                      </p>
                      <span class="rounded bg-[#5865F2]/10 px-1 py-0.5 font-mono text-[9px] font-semibold text-[#5865F2]">Chat</span>
                    </div>
                    <p class="text-[11px] text-text-muted leading-tight mt-0.5">
                      Connect with visual novel creators
                    </p>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <!-- Right Side: Actions (Theme, Compact GitHub, Download) -->
      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle Dark or Light theme"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border-default bg-surface-primary text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary cursor-pointer"
        >
          <Sun class="hidden h-4 w-4 [html[data-theme='dark']_&]:block" />
          <Moon class="hidden h-4 w-4 [html[data-theme='light']_&]:block" />
        </button>

        <a
          id="nav-github-btn"
          href="https://github.com/Kharisdestianmaulana-hub/blanc-engine"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden h-9 items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-2.5 text-sm font-medium text-text-primary transition-colors hover:bg-surface-hover sm:inline-flex"
        >
          <Github class="h-4 w-4 text-text-secondary" />
          <span id="nav-github-text">GitHub</span>
          <span id="nav-star-wrap" class="hidden items-center gap-1 border-l border-border-default pl-2 font-mono text-xs text-text-secondary">
            <Star class="h-3 w-3 text-status-warning" />
            <span id="nav-star-count"></span>
          </span>
        </a>

        <a
          id="nav-download-btn"
          href="/download"
          aria-current={pathname === "/download" ? "page" : undefined}
          class="inline-flex h-9 items-center gap-1.5 rounded-md bg-accent-primary px-3.5 text-sm font-semibold text-text-on-accent transition-colors hover:bg-accent-hover active:bg-accent-pressed"
        >
          <Download class="h-4 w-4" />
          <span>Download</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border-default bg-surface-primary text-text-secondary hover:bg-surface-hover hover:text-text-primary md:hidden cursor-pointer"
        >
          <Menu id="menu-icon-open" class="h-4 w-4" />
          <X id="menu-icon-close" class="hidden h-4 w-4" />
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden border-t border-border-default bg-bg-secondary px-4 py-3 md:hidden">
      <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
        {
          mobileNavLinks.map((link) => {
            const isActive = pathname === link.href;
            return (
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                  isActive
                    ? "bg-surface-elevated text-text-primary font-semibold"
                    : "text-text-secondary hover:bg-surface-hover hover:text-text-primary",
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
        <a
          href="/download"
          class="rounded-md px-3 py-2 text-sm font-medium text-text-primary hover:bg-surface-hover"
        >
          Download Releases
        </a>
        <a
          href="https://github.com/Kharisdestianmaulana-hub/blanc-engine"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary"
        >
          <Github class="h-4 w-4" />
          <span>GitHub Repository</span>
        </a>
      </nav>
    </div>
  </div>

  <!-- Sticky Release Announcement Banner (connects to pill navbar on desktop scroll) -->
  <div
    id="release-banner"
    class="hidden w-full border-b border-border-default bg-surface-elevated transition-all duration-200"
    role="region"
    aria-label="Latest release announcement"
  >
    <div class="mx-auto flex min-h-10 max-w-7xl items-center justify-between gap-2.5 px-4 py-1.5 sm:px-6">
      <div class="flex min-w-0 flex-1 items-center gap-2.5">
        <button
          id="release-banner-close"
          type="button"
          aria-label="Dismiss release announcement"
          class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-border-default bg-surface-primary text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary cursor-pointer"
        >
          <X class="h-3.5 w-3.5" />
        </button>

        <p class="min-w-0 truncate text-xs text-text-primary">
          <span class="font-mono font-semibold text-text-primary sm:hidden">
            New: <span id="release-banner-tag-mobile">v0.1.0-beta</span>
          </span>
          <span class="hidden sm:inline">
            <span class="mr-1.5 rounded border border-border-default bg-bg-secondary px-1.5 py-0.5 font-mono text-[11px] font-semibold text-text-secondary">
              New Release
            </span>
            <span id="release-banner-tag-desktop" class="font-mono font-semibold">v0.1.0-beta</span>
            <span class="text-text-secondary"> is now available.</span>
          </span>
        </p>
      </div>

      <a
        href="/changelog"
        class="inline-flex h-7 shrink-0 items-center gap-1 rounded-full bg-accent-primary px-3 text-[11px] font-semibold text-text-on-accent transition-colors hover:bg-accent-hover sm:text-xs"
      >
        <span>Changelog</span>
        <ArrowRight class="h-3 w-3" />
      </a>
    </div>
  </div>
</header>

<script>
  const themeBtn = document.getElementById("theme-toggle");
  themeBtn?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("blanc-theme", next);
  });

  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  mobileBtn?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.toggle("hidden");
    mobileBtn.setAttribute("aria-expanded", String(!isHidden));
    openIcon?.classList.toggle("hidden", !isHidden);
    closeIcon?.classList.toggle("hidden", Boolean(isHidden));
  });

  // Morphing Pill Navbar on desktop scroll
  const siteHeader = document.getElementById("site-header");
  const navShell = document.getElementById("nav-shell");
  const navInner = document.getElementById("nav-inner");
  const navDownloadBtn = document.getElementById("nav-download-btn");
  const releaseBanner = document.getElementById("release-banner");
  const navBrandText = document.getElementById("nav-brand-text");
  const navVersionTag = document.getElementById("nav-version-tag");
  const navGithubText = document.getElementById("nav-github-text");

  let bannerEligible = false;

  function updateNavbarMode() {
    const isDesktop = window.innerWidth >= 768;
    const isScrolled = window.scrollY > 24;
    const pillActive = isDesktop && isScrolled;
    const connectedPill = pillActive && bannerEligible;
    const singlePill = pillActive && !bannerEligible;

    if (siteHeader && navShell && navInner) {
      siteHeader.classList.toggle("md:pt-3", pillActive);
      siteHeader.classList.toggle("md:px-6", pillActive);

      navShell.classList.toggle("md:mx-auto", pillActive);
      navShell.classList.toggle("md:max-w-4xl", pillActive);
      navShell.classList.toggle("md:border", pillActive);
      navShell.classList.toggle("md:rounded-full", singlePill);
      navShell.classList.toggle("md:rounded-t-3xl", connectedPill);
      navShell.classList.toggle("md:border-b-0", connectedPill);
      navShell.classList.toggle("border-b", !pillActive);
      navShell.classList.toggle("shadow-2xl", pillActive);
      navShell.classList.toggle("shadow-black/25", pillActive);

      navInner.classList.toggle("h-14", pillActive);
      navInner.classList.toggle("h-16", !pillActive);
    }

    if (navBrandText) {
      navBrandText.classList.toggle("md:hidden", pillActive);
    }

    if (navVersionTag) {
      navVersionTag.classList.toggle("md:hidden", pillActive);
    }

    if (navGithubText) {
      navGithubText.classList.toggle("hidden", pillActive);
    }

    if (navDownloadBtn) {
      navDownloadBtn.classList.toggle("md:rounded-full", pillActive);
      navDownloadBtn.classList.toggle("rounded-md", !pillActive);
    }

    if (releaseBanner) {
      releaseBanner.classList.toggle("hidden", !bannerEligible);
      releaseBanner.classList.toggle("md:mx-auto", connectedPill);
      releaseBanner.classList.toggle("md:max-w-4xl", connectedPill);
      releaseBanner.classList.toggle("md:border", connectedPill);
      releaseBanner.classList.toggle("md:rounded-b-3xl", connectedPill);
      releaseBanner.classList.toggle("border-b", !connectedPill);
    }
  }

  window.addEventListener("scroll", updateNavbarMode, { passive: true });
  window.addEventListener("resize", updateNavbarMode, { passive: true });

  const starWrap = document.getElementById("nav-star-wrap");
  const starCount = document.getElementById("nav-star-count");
  const releaseBannerClose = document.getElementById("release-banner-close");
  const releaseTagMobile = document.getElementById("release-banner-tag-mobile");
  const releaseTagDesktop = document.getElementById("release-banner-tag-desktop");

  function showReleaseBannerIfNeeded(tag: string) {
    if (!releaseBanner || !tag) return;
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
    if (currentPath === "/changelog") return;

    const dismissed = localStorage.getItem("blanc-dismissed-release");
    if (dismissed === tag) return;

    bannerEligible = true;
    if (releaseTagMobile) releaseTagMobile.textContent = tag;
    if (releaseTagDesktop) releaseTagDesktop.textContent = tag;
    updateNavbarMode();

    releaseBannerClose?.addEventListener("click", () => {
      bannerEligible = false;
      localStorage.setItem("blanc-dismissed-release", tag);
      updateNavbarMode();
    });
  }

  async function loadNavbarMeta() {
    let stars: number | null = null;
    let latestTag: string | null = null;

    try {
      const apiRes = await fetch("/api/github-stats");
      if (apiRes.ok) {
        const stats = await apiRes.json();
        if (typeof stats.stars === "number") stars = stats.stars;
        if (typeof stats.latestTag === "string" && stats.latestTag) latestTag = stats.latestTag;
      }
    } catch {
      // Fallback below
    }

    if (stars === null || !latestTag) {
      try {
        const cachedRaw = sessionStorage.getItem("blanc-gh-meta-v3");
        if (cachedRaw) {
          const parsed = JSON.parse(cachedRaw) as { stars?: number; tag?: string; ts: number };
          if (Date.now() - parsed.ts < 2 * 60 * 1000) {
            if (stars === null && typeof parsed.stars === "number") stars = parsed.stars;
            if (!latestTag && parsed.tag) latestTag = parsed.tag;
          }
        }
      } catch {
        // Ignore storage errors
      }
    }

    if (stars === null || !latestTag) {
      try {
        const [repoRes, relRes] = await Promise.all([
          fetch("https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine", {
            headers: { Accept: "application/vnd.github+json" },
          }),
          fetch("https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases?per_page=1", {
            headers: { Accept: "application/vnd.github+json" },
          }),
        ]);
        if (repoRes.ok) {
          const repo = await repoRes.json();
          if (typeof repo.stargazers_count === "number") stars = repo.stargazers_count;
        }
        if (relRes.ok) {
          const rels = await relRes.json();
          if (Array.isArray(rels) && rels[0]?.tag_name) latestTag = String(rels[0].tag_name);
        }
        if (stars !== null || latestTag) {
          sessionStorage.setItem(
            "blanc-gh-meta-v3",
            JSON.stringify({ stars, tag: latestTag, ts: Date.now() })
          );
        }
      } catch {
        // Keep fallback
      }
    }

    if (starWrap && starCount && stars !== null) {
      starCount.textContent = String(stars);
      starWrap.classList.remove("hidden");
      starWrap.classList.add("inline-flex");
    }

    if (latestTag) {
      if (navVersionTag) navVersionTag.textContent = latestTag;
      showReleaseBannerIfNeeded(latestTag);
    }
  }

  updateNavbarMode();

  // Instant local cache restore for 0ms initial paint
  try {
    const cachedRaw = sessionStorage.getItem("blanc-gh-meta-v3");
    if (cachedRaw) {
      const parsed = JSON.parse(cachedRaw) as { stars?: number; tag?: string };
      if (typeof parsed.stars === "number" && starWrap && starCount) {
        starCount.textContent = String(parsed.stars);
        starWrap.classList.remove("hidden");
        starWrap.classList.add("inline-flex");
      }
      if (parsed.tag) {
        if (navVersionTag) navVersionTag.textContent = parsed.tag;
        showReleaseBannerIfNeeded(parsed.tag);
      }
    }
  } catch {}

  // Defer live GitHub metadata fetch until main thread is idle
  if ("requestIdleCallback" in window) {
    (window as any).requestIdleCallback(loadNavbarMeta, { timeout: 2000 });
  } else {
    setTimeout(loadNavbarMeta, 350);
  }
</script>
