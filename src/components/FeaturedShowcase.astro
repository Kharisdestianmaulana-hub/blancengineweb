---
import { Gamepad2, ArrowRight } from "lucide-astro";
---

<section id="featured-games" class="border-b border-border-default bg-bg-secondary py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2">
          <Gamepad2 class="h-4 w-4 text-accent-primary" />
          <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
            Community Showcase
          </span>
        </div>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
          Made With Blanc Engine
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
          Visual novels created and shared by the community, or browse all 17 engine module previews.
        </p>
      </div>

      <a
        href="/showcase"
        class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3.5 text-xs font-medium text-text-primary transition-colors hover:border-accent-primary hover:bg-surface-hover"
      >
        <span>Explore Showcase</span>
        <ArrowRight class="h-3.5 w-3.5 text-accent-primary" />
      </a>
    </div>

    <div id="featured-games-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <div class="col-span-full rounded-lg border border-border-default bg-surface-primary p-6 text-sm text-text-secondary">
        Loading featured games...
      </div>
    </div>
  </div>
</section>

<script>
  const SHEET_URL =
    "https://docs.google.com/spreadsheets/d/1VCNAuxsX3QyiQtOONYbZYZIUbRRhjrd9oaMddh_8O7g/gviz/tq?tqx=out:json&gid=658897965&headers=1";

  const featuredGrid = document.getElementById("featured-games-grid");

  function esc(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function renderInviteCard() {
    if (!featuredGrid) return;
    featuredGrid.innerHTML = `
      <div class="col-span-full flex flex-col justify-between gap-4 rounded-lg border border-border-default bg-surface-primary p-6 sm:flex-row sm:items-center">
        <div>
          <h3 class="text-base font-semibold text-text-primary">Showcase Your Visual Novel</h3>
          <p class="mt-1 text-sm text-text-secondary">
            Built a project with Blanc Engine? Submit your game to the community directory or inspect all 17 editor screenshots.
          </p>
        </div>
        <a
          href="/showcase"
          class="inline-flex h-10 shrink-0 items-center justify-center rounded-md bg-accent-primary px-4 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover"
        >
          Open Showcase
        </a>
      </div>
    `;
  }

  async function loadFeaturedGames() {
    if (!featuredGrid) return;
    try {
      const res = await fetch(SHEET_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]+)\);?/);
      if (!match) throw new Error("Invalid sheet response");

      const json = JSON.parse(match[1]);
      const rows = json?.table?.rows || [];
      const games: Array<{
        title: string;
        author: string;
        status: string;
        cover: string;
        url: string;
        description: string;
      }> = [];

      const toSlug = (str: string) =>
        str
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");

      for (const row of rows) {
        const c = row.c || [];
        const getVal = (idx: number) => (c[idx] && c[idx].v != null ? String(c[idx].v).trim() : "");
        const approvedRaw = getVal(8).toLowerCase();
        const isApproved = approvedRaw === "true" || approvedRaw === "1" || approvedRaw === "yes";
        const title = getVal(1);

        if (!title || title.toLowerCase() === "game title" || !isApproved) continue;

        games.push({
          title,
          author: getVal(2) || "Unknown Creator",
          status: getVal(3) || "Released",
          cover: getVal(5),
          url: `/showcase/?game=${encodeURIComponent(toSlug(title))}`,
          description: getVal(7),
        });
      }

      const topThree = games.reverse().slice(0, 3);
      if (topThree.length === 0) {
        renderInviteCard();
        return;
      }

      featuredGrid.innerHTML = topThree
        .map(
          (game) => `
          <a
            href="${esc(game.url)}"
            class="flex flex-col overflow-hidden rounded-lg border border-border-default bg-surface-primary transition-colors hover:border-accent-primary"
          >
            <div class="aspect-video w-full overflow-hidden border-b border-border-subtle bg-bg-primary">
              <img
                src="${esc(game.cover)}"
                alt="${esc(game.title)}"
                class="h-full w-full object-cover"
                loading="lazy"
                onerror="this.src='/screenshots/SS_GAMEPLAY_1_CHARACTER.png'"
              />
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between gap-2">
                <h3 class="truncate text-sm font-semibold text-text-primary">${esc(game.title)}</h3>
                <span class="shrink-0 rounded border border-border-default bg-bg-secondary px-2 py-0.5 font-mono text-[10px] text-text-secondary">
                  ${esc(game.status)}
                </span>
              </div>
              <p class="mt-0.5 font-mono text-xs text-text-muted">by ${esc(game.author)}</p>
              <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-text-secondary">
                ${esc(game.description)}
              </p>
            </div>
          </a>
        `
        )
        .join("");
    } catch {
      renderInviteCard();
    }
  }

  loadFeaturedGames();
</script>
