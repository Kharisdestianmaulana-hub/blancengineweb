---
import { Download, BookOpen } from "lucide-astro";
---

<section class="bg-bg-primary py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="rounded-lg border border-border-default bg-surface-primary p-8 text-center sm:p-10">
      <span class="rounded border border-border-default bg-bg-secondary px-2.5 py-1 font-mono text-xs font-medium text-text-secondary">
        Start Creating
      </span>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Start building your visual novel today
      </h2>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-text-secondary sm:text-base">
        Download Blanc Engine for free, follow the beginner-friendly User Guide, or share your story progress with other creators on Discord.
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/download"
          class="inline-flex h-11 items-center gap-2 rounded-md bg-accent-primary px-5 text-sm font-semibold text-text-on-accent transition-colors hover:bg-accent-hover active:bg-accent-pressed"
        >
          <Download class="h-4 w-4" />
          <span>Download Free</span>
        </a>
        <a
          href="/docs"
          class="inline-flex h-11 items-center gap-2 rounded-md border border-border-default bg-bg-secondary px-5 text-sm font-medium text-text-primary transition-colors hover:bg-surface-hover"
        >
          <BookOpen class="h-4 w-4 text-text-secondary" />
          <span>Read User Guide</span>
        </a>
        <a
          href="https://discord.gg/GcQMrRXa9Z"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center gap-2 rounded-md border border-border-default bg-bg-secondary px-5 text-sm font-medium text-text-primary transition-colors hover:border-text-secondary hover:bg-surface-hover"
        >
          <span>Join Discord</span>
        </a>
      </div>
    </div>
  </div>
</section>
