---
import { Check, Minus } from "lucide-astro";

const rows = [
  {
    feature: "Story Authoring",
    blanc: "Screenplay syntax + Visual Node Graph",
    traditional: "Manual scripting and boilerplate code",
  },
  {
    feature: "UI Customization",
    blanc: "Built-in Live-Preview UI Designer",
    traditional: "Code-based layout & stylesheet editing",
  },
  {
    feature: "Localization",
    blanc: "Unlimited languages + 1-click CSV Sync",
    traditional: "External plugins or manual string files",
  },
  {
    feature: "Game Packaging",
    blanc: "Portable .exe + 6-Language Setup.exe",
    traditional: "Separate installer scripts & tools",
  },
  {
    feature: "Runtime Footprint",
    blanc: "Native Rust binary (Game.exe + .bpack)",
    traditional: "Heavy scripting VM or embedded browser",
  },
];
---

<section class="border-b border-border-default bg-bg-secondary py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <span class="font-mono text-xs font-medium uppercase tracking-wider text-text-muted">
        Why Blanc Engine
      </span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Creator simplicity backed by native Rust
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
        Built so writers and artists stay focused on storytelling while shipping fast, self-contained desktop games.
      </p>
    </div>

    <div class="mt-8 overflow-hidden rounded-lg border border-border-default bg-surface-primary">
      <div class="grid grid-cols-1 border-b border-border-default bg-bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-wider text-text-muted sm:grid-cols-12">
        <div class="sm:col-span-3">Capability</div>
        <div class="hidden text-text-primary font-bold sm:col-span-5 sm:block">Blanc Engine</div>
        <div class="hidden sm:col-span-4 sm:block">Script-Heavy Engines</div>
      </div>

      <div class="divide-y divide-border-subtle">
        {
          rows.map((row) => (
            <div class="grid grid-cols-1 gap-2 px-5 py-4 sm:grid-cols-12 sm:items-center sm:gap-4">
              <div class="text-sm font-semibold text-text-primary sm:col-span-3">
                {row.feature}
              </div>
              <div class="flex items-start gap-2 text-xs text-text-primary sm:col-span-5 sm:text-sm">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-status-success" />
                <span>{row.blanc}</span>
              </div>
              <div class="flex items-start gap-2 text-xs text-text-muted sm:col-span-4 sm:text-sm">
                <Minus class="mt-0.5 h-4 w-4 shrink-0 text-text-muted" />
                <span>{row.traditional}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
