---
import { HelpCircle, ChevronDown } from "lucide-astro";

const faqs = [
  {
    question: "Do I really not need any coding skills to make a game?",
    answer:
      "Yes! Blanc Engine is built 100% for non-programmers. You write your story like a script, connect routes visually in Story Flow, and customize menus with Live Preview without touching a single line of code.",
  },
  {
    question: "Can I use my own character art, backgrounds, and music?",
    answer:
      "Of course. You can import your own PNG/JPG/WebP backgrounds, character sprites and expressions, background music, sound effects, voice lines, and custom fonts directly in the Asset Manager.",
  },
  {
    question: "How do players run the game I export?",
    answer:
      "You can export a Portable build (a ready-to-run Game.exe folder) or a branded Windows Setup.exe installer with Start Menu/Desktop shortcuts and a clean uninstaller. Players do not need Blanc Engine installed to play your game.",
  },
  {
    question: "Can I translate my visual novel into multiple languages?",
    answer:
      "Yes. You can add as many languages as you want in the Localization tab, translate inside the editor or via Excel/Google Sheets (CSV), and players can switch languages anytime from the game's Settings menu.",
  },
  {
    question: "Is Blanc Engine free to download and use?",
    answer:
      "Yes, Blanc Engine is completely free and open-source (licensed under GPL-3.0-or-later). Download the latest release for Windows and start creating right away.",
  },
];
---

<section id="faq" class="bg-bg-secondary py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <div class="text-center">
      <div class="inline-flex items-center gap-2">
        <HelpCircle class="h-4 w-4 text-accent-primary" />
        <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
          FAQ
        </span>
      </div>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Frequently Asked Questions
      </h2>
      <p class="mt-2 text-sm text-text-secondary sm:text-base">
        Common questions from writers, artists, and creators getting started.
      </p>
    </div>

    <div class="mt-10 space-y-3">
      {
        faqs.map((item, idx) => (
          <details
            class="group rounded-lg border border-border-default bg-surface-primary open:border-accent-primary"
            open={idx === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-text-primary transition-colors hover:bg-surface-hover sm:text-base">
              <span>{item.question}</span>
              <ChevronDown class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180 group-open:text-accent-primary" />
            </summary>
            <div class="border-t border-border-subtle px-5 py-4 text-xs leading-relaxed text-text-secondary sm:text-sm">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
