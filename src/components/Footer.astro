---
import { Github, Download, MessageSquare, BookOpen } from "lucide-astro";

const columns = [
  {
    title: "Blanc Engine",
    links: [
      { label: "Download", href: "/download" },
      { label: "Documentation", href: "/docs" },
      { label: "Features", href: "/#features" },
      { label: "Showcase", href: "/showcase" },
      { label: "Roadmap", href: "/roadmap" },
      { label: "Changelog", href: "/changelog" },
      { label: "Source code", href: "https://github.com/Kharisdestianmaulana-hub/blanc-engine", external: true },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "Workflow", href: "/#workflow" },
      { label: "Contributors", href: "/changelog#contributors" },
      { label: "FAQ", href: "/#faq" },
      { label: "Feedback", href: "/feedback" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "User Guide", href: "/docs" },
      { label: "Release archive", href: "/download" },
      { label: "Report a bug", href: "/feedback" },
      { label: "Request feature", href: "/feedback" },
      { label: "Submit a game", href: "/showcase" },
    ],
  },
  {
    title: "Community & Legal",
    links: [
      { label: "Discord Community", href: "https://discord.gg/GcQMrRXa9Z", external: true },
      { label: "License (GPL-3.0)", href: "https://github.com/Kharisdestianmaulana-hub/blanc-engine/blob/main/LICENSE", external: true },
      { label: "Contributing", href: "https://github.com/Kharisdestianmaulana-hub/blanc-engine/blob/main/CONTRIBUTING.md", external: true },
      { label: "Code of conduct", href: "https://github.com/Kharisdestianmaulana-hub/blanc-engine/blob/main/CODE_OF_CONDUCT.md", external: true },
      { label: "GitHub Releases", href: "https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases", external: true },
    ],
  },
];
---

<footer class="border-t border-border-default bg-bg-secondary">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!-- 4-Column Navigation Grid (Godot-style) -->
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        columns.map((col) => (
          <div>
            <h2 class="text-sm font-semibold text-text-primary">{col.title}</h2>
            <ul class="mt-3 space-y-2">
              {
                col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      class="text-xs text-text-secondary transition-colors hover:text-accent-primary sm:text-sm"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Legal & Social Bar -->
    <div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-border-subtle pt-6 sm:flex-row sm:items-center">
      <div class="space-y-1 text-xs text-text-muted">
        <p>
          &copy; 2026 <a href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/graphs/contributors" target="_blank" rel="noopener noreferrer" class="text-text-secondary underline hover:text-accent-primary">Blanc Engine contributors</a>.
          Licensed under GPL-3.0-or-later.
        </p>
      </div>

      <div class="flex items-center gap-3 text-text-secondary">
        <a
          href="https://github.com/Kharisdestianmaulana-hub/blanc-engine"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Repository"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-default bg-surface-primary transition-colors hover:border-accent-primary hover:text-accent-primary"
        >
          <Github class="h-4 w-4" />
        </a>
        <a
          href="https://discord.gg/GcQMrRXa9Z"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Discord Community"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-default bg-surface-primary transition-colors hover:border-accent-primary hover:text-accent-primary"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028ZM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z" />
          </svg>
        </a>
        <a
          href="/download"
          aria-label="Download Releases"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-default bg-surface-primary transition-colors hover:border-accent-primary hover:text-accent-primary"
        >
          <Download class="h-4 w-4" />
        </a>
        <a
          href="/docs"
          aria-label="Documentation"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-default bg-surface-primary transition-colors hover:border-accent-primary hover:text-accent-primary"
        >
          <BookOpen class="h-4 w-4" />
        </a>
        <a
          href="/feedback"
          aria-label="Feedback & Bug Report"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-default bg-surface-primary transition-colors hover:border-accent-primary hover:text-accent-primary"
        >
          <MessageSquare class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</footer>
