---
interface BlogPost {
  id: number;
  slug: string;
  title: string;
  excerpt: string;
  cover_url: string;
  author: string;
  tags: string;
  published_at: string;
}

// Initial sample data for local preview (npm run dev)
const SAMPLE_DEVLOGS: BlogPost[] = [
  {
    id: 1,
    slug: "blanc-engine-v020-devlog-free-form-ui-canvas-studio",
    title: "Blanc Engine v0.2.0 Devlog: Free-Form UI Canvas Studio, Custom UI Skins, and Visual Logic",
    excerpt: "A deep dive into Blanc Engine v0.2.0, bringing a 3-panel Godot/Unity-style Free-Form UI Designer, custom PNG skinning, nine-slice margins, and zero-code data binding.",
    cover_url: "/screenshots/SS_UI_DESIGNER.png",
    author: "Blanc Core Team",
    tags: "Devlog, v0.2.0, UI Designer",
    published_at: "2026-11-25",
  },
  {
    id: 2,
    slug: "welcome-to-blanc-engine",
    title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
    excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
    cover_url: "/screenshots/SS_OVERVIEW.png",
    author: "Blanc Core Team",
    tags: "Devlog, Architecture",
    published_at: "2026-11-25",
  },
];
---

<section id="section-engine-devlogs" class="border-b border-border-default bg-bg-primary py-12 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Clean Flat Header (Ala Godot) -->
    <div class="flex items-end justify-between border-b border-border-subtle pb-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text-primary">
          Engine devlogs
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-text-secondary">
          Technical deep dives, architectural breakdowns, and behind-the-scenes progress.
        </p>
      </div>

      <a
        href="/blog"
        class="hidden sm:inline-block rounded-md bg-surface-primary hover:bg-surface-hover border border-border-default px-4 py-1.5 text-xs font-semibold text-text-primary transition-colors"
      >
        All devlogs
      </a>
    </div>

    <!-- Pure Flat Adaptive Container (Zero Card Boxes, Pure 2D Flat ala Godot) -->
    <div id="devlogs-adaptive-container" class="mt-8">
      <!-- Initial 2-column fallback preview for local dev -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          SAMPLE_DEVLOGS.map((post) => (
            <a href={`/blog/post?slug=${post.slug}`} class="group block">
              <div class="aspect-video w-full overflow-hidden rounded-xl bg-bg-secondary">
                <img
                  src={post.cover_url}
                  alt={post.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <h3 class="mt-3 text-lg sm:text-xl font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
                {post.title}
              </h3>
              <p class="mt-1.5 text-xs sm:text-sm text-text-secondary leading-relaxed line-clamp-2">
                {post.excerpt}
              </p>
              <span class="mt-2 block font-mono text-xs text-text-muted">
                {post.published_at}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Mobile Button -->
    <div class="mt-8 text-center sm:hidden">
      <a
        href="/blog"
        class="inline-flex w-full items-center justify-center rounded-md bg-surface-primary hover:bg-surface-hover border border-border-default py-2 text-xs font-semibold text-text-primary"
      >
        More devlogs
      </a>
    </div>
  </div>
</section>

<script>
  interface BlogPost {
    id: number;
    slug: string;
    title: string;
    excerpt: string;
    cover_url: string;
    author: string;
    tags: string;
    published_at: string;
  }

  function escapeHtml(str: string): string {
    return (str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatDate(iso: string): string {
    if (!iso) return "";
    return new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  const devlogsSectionWrapper = document.getElementById("section-engine-devlogs");
  const devlogsAdaptiveContainer = document.getElementById("devlogs-adaptive-container");

  function renderFlatDevlogs(posts: BlogPost[]) {
    if (!devlogsAdaptiveContainer || !devlogsSectionWrapper) return;

    // Skenario 1: 0 Artikel (D1 Kosong) -> Graceful Auto-Hide
    if (posts.length === 0) {
      devlogsSectionWrapper.classList.add("hidden");
      return;
    }

    devlogsSectionWrapper.classList.remove("hidden");

    // Skenario 2: Hanya 1 Artikel (Single Flat Feature)
    if (posts.length === 1) {
      const p = posts[0];
      devlogsAdaptiveContainer.innerHTML = `
        <a href="/blog/post?slug=${encodeURIComponent(p.slug)}" class="group grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-center">
          <div class="md:col-span-6 aspect-video overflow-hidden rounded-xl bg-bg-secondary">
            <img
              src="${escapeHtml(p.cover_url || '/screenshots/SS_OVERVIEW.png')}"
              alt="${escapeHtml(p.title)}"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="md:col-span-6 space-y-2">
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
              ${escapeHtml(p.title)}
            </h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed line-clamp-3">
              ${escapeHtml(p.excerpt)}
            </p>
            <span class="block font-mono text-xs text-text-muted pt-1">
              ${formatDate(p.published_at)}
            </span>
          </div>
        </a>
      `;
      return;
    }

    // Skenario 3: Ada 2 Artikel (2 Kolom Flat Simetris 50% - 50%)
    if (posts.length === 2) {
      devlogsAdaptiveContainer.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          ${posts
            .map(
              (p) => `
            <a href="/blog/post?slug=${encodeURIComponent(p.slug)}" class="group block">
              <div class="aspect-video w-full overflow-hidden rounded-xl bg-bg-secondary">
                <img
                  src="${escapeHtml(p.cover_url || '/screenshots/SS_OVERVIEW.png')}"
                  alt="${escapeHtml(p.title)}"
                  class="h-full w-full object-cover"
                />
              </div>
              <h3 class="mt-3 text-lg sm:text-xl font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
                ${escapeHtml(p.title)}
              </h3>
              <p class="mt-1.5 text-xs sm:text-sm text-text-secondary leading-relaxed line-clamp-2">
                ${escapeHtml(p.excerpt)}
              </p>
              <span class="mt-2 block font-mono text-xs text-text-muted">
                ${formatDate(p.published_at)}
              </span>
            </a>
          `
            )
            .join("")}
        </div>
      `;
      return;
    }

    // Skenario 4: Ada 3 Artikel (3 Kolom Flat Simetris 33% - 33% - 33%)
    if (posts.length === 3) {
      devlogsAdaptiveContainer.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          ${posts
            .map(
              (p) => `
            <a href="/blog/post?slug=${encodeURIComponent(p.slug)}" class="group block">
              <div class="aspect-video w-full overflow-hidden rounded-xl bg-bg-secondary">
                <img
                  src="${escapeHtml(p.cover_url || '/screenshots/SS_OVERVIEW.png')}"
                  alt="${escapeHtml(p.title)}"
                  class="h-full w-full object-cover"
                />
              </div>
              <h3 class="mt-3 text-base sm:text-lg font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
                ${escapeHtml(p.title)}
              </h3>
              <p class="mt-1.5 text-xs text-text-secondary leading-relaxed line-clamp-2">
                ${escapeHtml(p.excerpt)}
              </p>
              <span class="mt-2 block font-mono text-xs text-text-muted">
                ${formatDate(p.published_at)}
              </span>
            </a>
          `
            )
            .join("")}
        </div>
      `;
      return;
    }

    // Skenario 5: Ada 4 Artikel atau Lebih (Murni Asymmetric Godot Flat Layout)
    const featured = posts[0];
    const secondary = posts.slice(1, 4);

    devlogsAdaptiveContainer.innerHTML = `
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- 1. Left Side: Big Featured Flat Item (7 Columns) -->
        <div class="lg:col-span-7">
          <a href="/blog/post?slug=${encodeURIComponent(featured.slug)}" class="group block">
            <div class="aspect-video w-full overflow-hidden rounded-xl bg-bg-secondary">
              <img
                src="${escapeHtml(featured.cover_url || '/screenshots/SS_OVERVIEW.png')}"
                alt="${escapeHtml(featured.title)}"
                class="h-full w-full object-cover"
              />
            </div>
            <h3 class="mt-3 text-xl sm:text-2xl font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
              ${escapeHtml(featured.title)}
            </h3>
            <p class="mt-1.5 text-xs sm:text-sm text-text-secondary leading-relaxed line-clamp-2">
              ${escapeHtml(featured.excerpt)}
            </p>
            <span class="mt-2 block font-mono text-xs text-text-muted">
              ${formatDate(featured.published_at)}
            </span>
          </a>
        </div>

        <!-- 2. Right Side: 3 Stacked Flat Rows + More devlogs Button (5 Columns) -->
        <div class="lg:col-span-5 flex flex-col justify-between gap-6">
          <div class="space-y-6">
            ${secondary
              .map(
                (p) => `
              <a href="/blog/post?slug=${encodeURIComponent(p.slug)}" class="group flex items-start gap-4">
                <div class="aspect-video w-32 sm:w-36 shrink-0 overflow-hidden rounded-lg bg-bg-secondary">
                  <img
                    src="${escapeHtml(p.cover_url || '/screenshots/SS_OVERVIEW.png')}"
                    alt="${escapeHtml(p.title)}"
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="font-bold text-sm sm:text-base text-text-primary group-hover:text-accent-primary transition-colors leading-snug line-clamp-2">
                    ${escapeHtml(p.title)}
                  </h4>
                  <p class="mt-1 text-xs text-text-secondary line-clamp-2 leading-relaxed">
                    ${escapeHtml(p.excerpt)}
                  </p>
                  <span class="mt-1 block font-mono text-[11px] text-text-muted">
                    ${formatDate(p.published_at)}
                  </span>
                </div>
              </a>
            `
              )
              .join("")}
          </div>

          <!-- Bottom Right Button ala Godot -->
          <div class="flex justify-end pt-1">
            <a
              href="/blog"
              class="inline-block rounded-md bg-surface-primary hover:bg-surface-hover border border-border-default px-4 py-2 text-xs font-semibold text-text-primary transition-colors"
            >
              More devlogs
            </a>
          </div>
        </div>
      </div>
    `;
  }

  async function loadLiveDevlogs() {
    try {
      const res = await fetch("/api/blog");
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts)) {
          // Filter Devlog / UI Designer / Core / Architecture / Technical
          const filtered = data.posts.filter((p: BlogPost) => {
            const tags = (p.tags || "").toLowerCase();
            return (
              tags.includes("devlog") ||
              tags.includes("ui designer") ||
              tags.includes("core") ||
              tags.includes("architecture") ||
              tags.includes("technical") ||
              tags.includes("v0.2")
            );
          });

          renderFlatDevlogs(filtered);
          return;
        }
      }
    } catch {
      // In local dev, initial preview stays
    }
  }

  loadLiveDevlogs();
</script>
