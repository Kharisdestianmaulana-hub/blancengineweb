---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Bug, Sparkles, Send, ExternalLink } from "lucide-astro";
---

<BaseLayout
  title="Feedback: Report Bug or Request Feature | Blanc Engine"
  description="Report a bug or suggest a new feature for Blanc Engine without needing a GitHub account."
  ogImage="/screenshots/SS_SUBMIT_GAMES.png"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Feedback", path: "/feedback/" }]}
>
  <Navbar />

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="flex flex-col justify-between gap-4 border-b border-border-default pb-6 sm:flex-row sm:items-end">
      <div>
        <div class="flex items-center gap-2">
          <Bug class="h-4 w-4 text-accent-primary" />
          <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
            Feedback & Support
          </span>
        </div>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
          Report a Bug or Request a Feature
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
          No GitHub account required. Your submission is sent directly to the Blanc Engine issue tracker.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="https://discord.gg/GcQMrRXa9Z"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3 text-xs font-medium text-text-primary transition-colors hover:border-accent-primary hover:bg-surface-hover"
        >
          <span>Join Discord</span>
          <ExternalLink class="h-3.5 w-3.5 text-text-muted" />
        </a>
        <a
          href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3 text-xs font-medium text-text-primary transition-colors hover:bg-surface-hover"
        >
          <span>View Open Issues</span>
          <ExternalLink class="h-3.5 w-3.5 text-text-muted" />
        </a>
      </div>
    </div>

    <!-- Type Switcher -->
    <div class="mt-8">
      <div class="inline-flex flex-wrap rounded-md border border-border-default bg-bg-secondary p-1" role="tablist" aria-label="Feedback type">
        <button
          type="button"
          data-report-type="bug"
          aria-selected="true"
          class="inline-flex items-center gap-1.5 rounded px-4 py-2 text-xs font-semibold bg-accent-subtle text-accent-primary cursor-pointer"
        >
          <Bug class="h-3.5 w-3.5" />
          <span>Bug Report</span>
        </button>
        <button
          type="button"
          data-report-type="feature"
          aria-selected="false"
          class="inline-flex items-center gap-1.5 rounded px-4 py-2 text-xs font-semibold text-text-secondary hover:text-text-primary cursor-pointer"
        >
          <Sparkles class="h-3.5 w-3.5" />
          <span>Feature Request</span>
        </button>
      </div>
    </div>

    <!-- Form Card -->
    <form id="feedback-form" class="mt-5 space-y-5 rounded-lg border border-border-default bg-surface-primary p-6">
      <input type="hidden" id="report-type" name="type" value="bug" />

      <!-- Honeypot for bots -->
      <div class="hidden" aria-hidden="true">
        <label for="field-website">Website</label>
        <input id="field-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Common: Title -->
      <div>
        <label for="field-title" class="block text-xs font-semibold text-text-primary">
          Title <span class="text-status-error">*</span>
        </label>
        <input
          id="field-title"
          name="title"
          type="text"
          required
          minlength="4"
          placeholder="Short summary of the bug or unexpected behavior"
          class="mt-1.5 h-10 w-full rounded-md border border-border-default bg-bg-primary px-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
        />
      </div>

      <!-- BUG REPORT FIELDS -->
      <div id="bug-fields" class="space-y-5">
        <div>
          <label for="field-description" class="block text-xs font-semibold text-text-primary">
            Description <span class="text-status-error">*</span>
          </label>
          <textarea
            id="field-description"
            name="description"
            rows="3"
            required
            placeholder="A clear and concise description of what the bug is."
            class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
          ></textarea>
        </div>

        <div>
          <label for="field-steps" class="block text-xs font-semibold text-text-primary">
            Steps to Reproduce <span class="text-status-error">*</span>
          </label>
          <textarea
            id="field-steps"
            name="steps"
            rows="4"
            required
            placeholder="1. Open blanc_editor / blanc_runtime / Setup.exe&#10;2. Go to '...'&#10;3. Click on '...'&#10;4. Observe error"
            class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
          ></textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="field-expected" class="block text-xs font-semibold text-text-primary">
              Expected Behavior <span class="text-status-error">*</span>
            </label>
            <textarea
              id="field-expected"
              name="expected"
              rows="3"
              required
              placeholder="What you expected to happen."
              class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="field-actual" class="block text-xs font-semibold text-text-primary">
              Actual Behavior <span class="text-status-error">*</span>
            </label>
            <textarea
              id="field-actual"
              name="actual"
              rows="3"
              required
              placeholder="What actually happened (include error messages if any)."
              class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
            ></textarea>
          </div>
        </div>

        <!-- Environment -->
        <div class="rounded-md border border-border-subtle bg-bg-secondary p-4">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-text-muted">
            Environment
          </p>
          <div class="mt-3 grid gap-4 sm:grid-cols-3">
            <div>
              <label for="field-os" class="block text-xs font-medium text-text-primary">OS</label>
              <select
                id="field-os"
                name="os"
                class="mt-1.5 h-9 w-full rounded-md border border-border-default bg-surface-primary px-2.5 text-xs text-text-primary focus:border-accent-primary focus:outline-none"
              >
                <option value="Windows 11">Windows 11</option>
                <option value="Windows 10">Windows 10</option>
                <option value="Linux">Linux</option>
                <option value="macOS">macOS</option>
              </select>
            </div>

            <div>
              <label for="field-engine-version" class="block text-xs font-medium text-text-primary">
                Blanc Engine Version
              </label>
              <input
                id="field-engine-version"
                name="engineVersion"
                type="text"
                value="v0.1.0-beta"
                placeholder="v0.1.0-beta"
                class="mt-1.5 h-9 w-full rounded-md border border-border-default bg-surface-primary px-2.5 font-mono text-xs text-text-primary focus:border-accent-primary focus:outline-none"
              />
            </div>

            <div>
              <label for="field-rust-version" class="block text-xs font-medium text-text-primary">
                Rust Version (Optional)
              </label>
              <input
                id="field-rust-version"
                name="rustVersion"
                type="text"
                placeholder="Leave blank if using .exe"
                class="mt-1.5 h-9 w-full rounded-md border border-border-default bg-surface-primary px-2.5 font-mono text-xs text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- FEATURE REQUEST FIELDS -->
      <div id="feature-fields" class="hidden space-y-5">
        <div>
          <label for="field-summary" class="block text-xs font-semibold text-text-primary">
            Summary <span class="text-status-error">*</span>
          </label>
          <textarea
            id="field-summary"
            name="summary"
            rows="3"
            placeholder="A clear and concise description of the feature you would like to see."
            class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
          ></textarea>
        </div>

        <div>
          <label for="field-motivation" class="block text-xs font-semibold text-text-primary">
            Motivation / Use Case <span class="text-status-error">*</span>
          </label>
          <textarea
            id="field-motivation"
            name="motivation"
            rows="3"
            placeholder="Why would this feature be helpful for visual novel creators or players?"
            class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
          ></textarea>
        </div>

        <div>
          <label for="field-proposed" class="block text-xs font-semibold text-text-primary">
            Proposed Design (Optional)
          </label>
          <textarea
            id="field-proposed"
            name="proposedDesign"
            rows="3"
            placeholder="Any ideas on how this should look or work in blanc_editor, blanc_runtime, or blanc_installer."
            class="mt-1.5 w-full rounded-md border border-border-default bg-bg-primary p-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
          ></textarea>
        </div>
      </div>

      <!-- Common: Optional Contact -->
      <div>
        <label for="field-contact" class="block text-xs font-semibold text-text-primary">
          Contact (Optional)
        </label>
        <input
          id="field-contact"
          name="contact"
          type="text"
          placeholder="Email or Discord username if you want updates"
          class="mt-1.5 h-9 w-full rounded-md border border-border-default bg-bg-primary px-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
        />
      </div>

      <!-- Feedback Banner -->
      <div id="form-feedback" class="hidden rounded-md border px-4 py-3 text-xs leading-relaxed"></div>

      <div class="flex items-center justify-end border-t border-border-subtle pt-4">
        <button
          id="feedback-submit-btn"
          type="submit"
          class="inline-flex h-10 items-center gap-2 rounded-md bg-accent-primary px-5 text-sm font-semibold text-text-on-accent transition-colors hover:bg-accent-hover active:bg-accent-pressed disabled:opacity-50 cursor-pointer"
        >
          <Send class="h-4 w-4" />
          <span id="feedback-submit-label">Submit Bug Report</span>
        </button>
      </div>
    </form>
  </main>

  <Footer />
</BaseLayout>

<script>
  const typeBtns = document.querySelectorAll<HTMLButtonElement>("[data-report-type]");
  const typeInput = document.getElementById("report-type") as HTMLInputElement | null;
  const titleInput = document.getElementById("field-title") as HTMLInputElement | null;

  const bugFields = document.getElementById("bug-fields");
  const featureFields = document.getElementById("feature-fields");
  const submitLabel = document.getElementById("feedback-submit-label");

  const bugRequired = ["field-description", "field-steps", "field-expected", "field-actual"];
  const featureRequired = ["field-summary", "field-motivation"];

  function setReportType(mode: "bug" | "feature") {
    if (typeInput) typeInput.value = mode;

    typeBtns.forEach((btn) => {
      const active = btn.getAttribute("data-report-type") === mode;
      btn.setAttribute("aria-selected", String(active));
      btn.classList.toggle("bg-accent-subtle", active);
      btn.classList.toggle("text-accent-primary", active);
      btn.classList.toggle("text-text-secondary", !active);
    });

    bugFields?.classList.toggle("hidden", mode !== "bug");
    featureFields?.classList.toggle("hidden", mode !== "feature");

    bugRequired.forEach((id) => {
      const el = document.getElementById(id) as HTMLTextAreaElement | null;
      if (el) el.required = mode === "bug";
    });
    featureRequired.forEach((id) => {
      const el = document.getElementById(id) as HTMLTextAreaElement | null;
      if (el) el.required = mode === "feature";
    });

    if (titleInput) {
      titleInput.placeholder =
        mode === "bug"
          ? "Short summary of the bug or unexpected behavior"
          : "Short summary of the feature you would like to see";
    }
    if (submitLabel) {
      submitLabel.textContent = mode === "bug" ? "Submit Bug Report" : "Submit Feature Request";
    }
  }

  typeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const mode = btn.getAttribute("data-report-type") === "feature" ? "feature" : "bug";
      setReportType(mode);
    });
  });

  const form = document.getElementById("feedback-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("feedback-submit-btn") as HTMLButtonElement | null;
  const feedbackBox = document.getElementById("form-feedback");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !feedbackBox) return;

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    submitBtn.disabled = true;
    feedbackBox.classList.add("hidden");

    try {
      const res = await fetch("/api/report", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data?.error || `Request failed (${res.status})`);
      }

      form.reset();
      setReportType((payload.type as "bug" | "feature") || "bug");

      feedbackBox.className =
        "rounded-md border border-status-success bg-bg-secondary px-4 py-3 text-xs leading-relaxed text-status-success";
      feedbackBox.innerHTML = data.issueUrl
        ? `Thank you! Your report has been created as <a href="${data.issueUrl}" target="_blank" rel="noopener noreferrer" class="font-semibold underline">GitHub Issue #${data.issueNumber}</a>.`
        : "Thank you! Your feedback has been submitted.";
      feedbackBox.classList.remove("hidden");
    } catch (err) {
      const msg = err instanceof Error ? err.message : "Unable to submit report.";
      feedbackBox.className =
        "rounded-md border border-status-error bg-bg-secondary px-4 py-3 text-xs leading-relaxed text-status-error";
      feedbackBox.textContent = msg;
      feedbackBox.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
