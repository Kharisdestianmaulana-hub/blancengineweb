---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Home, BookOpen, Download } from "lucide-astro";
---

<BaseLayout
  title="404: Page Not Found | Blanc Engine"
  description="The page you are looking for could not be found."
  noindex={true}
>
  <Navbar />

  <main class="flex min-h-[calc(100dvh-4rem-2.75rem)] items-center justify-center px-4 py-12 sm:px-6">
    <div class="w-full max-w-lg rounded-lg border border-border-default bg-surface-primary p-8 text-center">
      <span class="inline-block rounded border border-accent-primary bg-accent-subtle px-2.5 py-1 font-mono text-xs font-semibold text-accent-primary">
        Error 404
      </span>

      <h1 class="mt-4 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Page not found
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary">
        The link you followed may be broken, or the page may have been moved.
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-2.5">
        <a
          href="/"
          class="inline-flex h-10 items-center gap-1.5 rounded-md bg-accent-primary px-4 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover active:bg-accent-pressed"
        >
          <Home class="h-3.5 w-3.5" />
          <span>Back to Home</span>
        </a>
        <a
          href="/docs"
          class="inline-flex h-10 items-center gap-1.5 rounded-md border border-border-default bg-bg-secondary px-4 text-xs font-medium text-text-primary transition-colors hover:bg-surface-hover"
        >
          <BookOpen class="h-3.5 w-3.5 text-text-secondary" />
          <span>User Guide</span>
        </a>
        <a
          href="/download"
          class="inline-flex h-10 items-center gap-1.5 rounded-md border border-border-default bg-bg-secondary px-4 text-xs font-medium text-text-primary transition-colors hover:bg-surface-hover"
        >
          <Download class="h-3.5 w-3.5 text-text-secondary" />
          <span>Download</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
