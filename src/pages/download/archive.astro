---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import {
  Download,
  Newspaper,
  FileText,
  ExternalLink,
  GitCommit,
  Sparkles,
  Search,
  ArrowLeft,
  Calendar,
  Package,
  ChevronDown,
  X,
  FolderArchive,
  Layers,
  ArrowRight,
  ShieldCheck,
} from "lucide-astro";
---

<BaseLayout
  title="Blanc Archive: Official Engine Releases & Changelogs"
  description="Download any officially published release of Blanc Engine. Access historical stable builds, preview releases, release devlogs, and full changelogs."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Download", path: "/download/" },
    { name: "Archive", path: "/download/archive/" },
  ]}
>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Top Nav Backlink & Header -->
    <div class="border-b border-border-default pb-8">
      <a
        href="/download/"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-text-muted hover:text-text-primary transition-colors mb-3"
      >
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>Back to Latest Download</span>
      </a>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <FolderArchive class="h-4 w-4 text-accent-primary" />
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-accent-primary">
              Release Repository
            </span>
          </div>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
            Blanc Archive
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
            Download any officially published release of the engine, view launch devlogs, and inspect version changelogs.
          </p>
        </div>

        <!-- Filter & Search Controls -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Search box -->
          <div class="relative w-48 sm:w-56">
            <Search class="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-text-muted" />
            <input
              type="text"
              id="archive-search-input"
              placeholder="Search version (e.g. 0.1)..."
              class="h-9 w-full rounded-md border border-border-default bg-surface-primary pl-8 pr-3 text-xs text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
            />
          </div>

          <!-- Filter Tabs -->
          <div class="inline-flex rounded-md border border-border-default bg-bg-secondary p-1" role="tablist">
            <button
              type="button"
              data-archive-filter="all"
              class="rounded px-2.5 py-1 text-xs font-semibold bg-surface-elevated text-text-primary shadow-sm cursor-pointer"
            >
              All
            </button>
            <button
              type="button"
              data-archive-filter="stable"
              class="rounded px-2.5 py-1 text-xs font-medium text-text-secondary hover:text-text-primary cursor-pointer"
            >
              Stable
            </button>
            <button
              type="button"
              data-archive-filter="preview"
              class="rounded px-2.5 py-1 text-xs font-medium text-text-secondary hover:text-text-primary cursor-pointer"
            >
              Beta / Preview
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Official Releases Container with Sticky Series Headers -->
    <div class="mt-8 space-y-12" id="archive-container">

      <!-- Series Block: Blanc 0.1 -->
      <section class="archive-series-block grid grid-cols-1 lg:grid-cols-12 gap-8 items-start border-b border-border-default pb-12" data-series="0.1">
        
        <!-- Left Column: Sticky Major Version Header -->
        <div class="lg:col-span-4 sticky top-24 self-start space-y-3 z-10 bg-bg-primary/95 py-2 backdrop-blur-sm">
          <div class="space-y-1">
            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-text-muted">
              Official Releases
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text-primary">
              Blanc 0.1
            </h2>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-status-success/30 bg-status-success/10 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-status-success">
              <span class="h-1.5 w-1.5 rounded-full bg-status-success animate-pulse"></span>
              <span>Current state: stable (v0.1.1)</span>
            </span>
          </div>

          <p class="text-xs text-text-secondary leading-relaxed max-w-sm">
            Initial release series introducing screenplay-style scripting, block-based scene timeline, visual story flow node graph, multi-language CSV localization, and Windows installer export.
          </p>
        </div>

        <!-- Right Column: Timeline & Release Cards List -->
        <div class="lg:col-span-8 relative border-l-2 border-border-subtle pl-5 sm:pl-7 space-y-5">
          
          <!-- Release Item 1: v0.1.1 (Stable) -->
          <div
            class="archive-release-item relative rounded-xl border border-border-default bg-surface-primary p-4 sm:p-5 shadow-sm transition-all hover:border-accent-primary/60"
            data-tag="v0.1.1"
            data-type="stable"
          >
            <!-- Timeline Node Dot -->
            <div class="absolute -left-[27px] sm:-left-[35px] top-6 h-3.5 w-3.5 rounded-full border-2 border-bg-primary bg-accent-primary shadow-sm"></div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <!-- Left: Version & Info -->
              <div class="space-y-1.5 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-mono text-base sm:text-lg font-bold text-text-primary">
                    v0.1.1
                  </h3>
                  <span class="rounded border border-status-success/30 bg-status-success/10 px-2 py-0.5 font-mono text-[10px] font-bold text-status-success">
                    Stable
                  </span>
                  <span class="inline-flex items-center gap-1 font-mono text-xs text-text-muted">
                    <Calendar class="h-3 w-3" />
                    <span>19 November 2026</span>
                  </span>
                </div>
                <p class="text-xs text-text-secondary line-clamp-1">
                  Stability, security hardening, runtime fixes, and navigation update.
                </p>
              </div>

              <!-- Right: 3 Action Buttons (Download, News, Changelog) -->
              <div class="flex flex-wrap items-center gap-2 shrink-0">
                <!-- 1. Download Split/Dropdown Button -->
                <div class="relative inline-block text-left" data-dropdown-wrap>
                  <button
                    type="button"
                    class="inline-flex items-center gap-1.5 rounded-md bg-accent-primary px-3 py-1.5 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover cursor-pointer"
                    data-download-dropdown-btn
                  >
                    <Download class="h-3.5 w-3.5" />
                    <span>Download</span>
                    <ChevronDown class="h-3 w-3 opacity-80" />
                  </button>
                  <div
                    class="hidden absolute right-0 top-full mt-1.5 w-56 rounded-lg border border-border-default bg-surface-primary p-1.5 shadow-xl backdrop-blur-md z-30 space-y-1"
                    data-download-menu
                  >
                    <a
                      href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.1/BlancEngine-0.1.1-Setup.exe"
                      class="flex items-center justify-between rounded px-2.5 py-1.5 text-xs font-medium text-text-primary hover:bg-surface-hover hover:text-accent-primary"
                    >
                      <div class="flex items-center gap-2">
                        <Package class="h-3.5 w-3.5 text-accent-primary" />
                        <span>Installer (.exe)</span>
                      </div>
                      <span class="font-mono text-[10px] text-text-muted">~27.7 MB</span>
                    </a>
                    <a
                      href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.1/BlancEngine-0.1.1-Portable.exe"
                      class="flex items-center justify-between rounded px-2.5 py-1.5 text-xs font-medium text-text-primary hover:bg-surface-hover hover:text-accent-primary"
                    >
                      <div class="flex items-center gap-2">
                        <Download class="h-3.5 w-3.5 text-text-muted" />
