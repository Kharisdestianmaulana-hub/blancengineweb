          </div>

        </div>
      </section>

    </div>

    <!-- Empty Filter Search Result Notice -->
    <div id="archive-empty-notice" class="hidden rounded-xl border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
      No releases matched your search query. Try clearing the filter.
    </div>

  </main>

  <!-- Interactive Changelog Modal Dialog -->
  <div
    id="changelog-modal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm"
  >
    <div
      class="relative w-full max-w-2xl max-h-[85vh] flex flex-col rounded-xl border border-border-default bg-surface-primary shadow-2xl overflow-hidden"
    >
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-border-subtle px-5 py-4 bg-surface-elevated">
        <div class="flex items-center gap-2">
          <GitCommit class="h-4 w-4 text-accent-primary" />
          <h3 class="font-mono text-sm font-bold text-text-primary" id="modal-release-title">
            Release Changelog
          </h3>
        </div>
        <button
          type="button"
          id="btn-close-modal"
          class="rounded p-1 text-text-muted hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
        >
          <X class="h-4 w-4" />
        </button>
      </div>

      <!-- Modal Body (Scrollable with Lenis prevention) -->
      <div
        id="modal-release-body"
        data-lenis-prevent
        class="overflow-y-auto px-5 py-4 text-xs leading-relaxed text-text-secondary space-y-3"
      >
        <p>Loading release changelog...</p>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-between border-t border-border-subtle px-5 py-3 bg-surface-elevated">
        <a
          id="modal-github-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs text-accent-primary hover:underline"
        >
          <span>View full release on GitHub</span>
          <ExternalLink class="h-3 w-3" />
        </a>
        <button
          type="button"
          id="btn-close-modal-bottom"
          class="rounded bg-accent-primary px-3 py-1 text-xs font-semibold text-text-on-accent hover:bg-accent-hover transition-colors cursor-pointer"
        >
          Done
        </button>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  interface GitHubAsset {
    name: string;
    size: number;
    browser_download_url: string;
    download_count: number;
  }

  interface GitHubRelease {
    tag_name: string;
    name: string;
    prerelease: boolean;
    draft: boolean;
    published_at: string;
    html_url: string;
    body: string;
    assets: GitHubAsset[];
  }

  const API_URL = "https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases";

  let releasesData: GitHubRelease[] = [];

  const searchInput = document.getElementById("archive-search-input") as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>("[data-archive-filter]");
  const emptyNotice = document.getElementById("archive-empty-notice");

  const changelogModal = document.getElementById("changelog-modal");
  const modalTitle = document.getElementById("modal-release-title");
  const modalBody = document.getElementById("modal-release-body");
  const modalGithubLink = document.getElementById("modal-github-link") as HTMLAnchorElement | null;
  const btnCloseModal = document.getElementById("btn-close-modal");
  const btnCloseModalBottom = document.getElementById("btn-close-modal-bottom");

  let activeTypeFilter: "all" | "stable" | "preview" = "all";
  let activeSearchQuery = "";

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function renderMarkdown(md: string): string {
    if (!md) return "<p>No release notes provided.</p>";
    const lines = md.replace(/\r\n/g, "\n").split("\n");
    const out: string[] = [];
    let inList = false;

    const inline = (text: string) => {
      let s = escapeHtml(text);
      s = s.replace(/`([^`]+)`/g, '<code class="rounded border border-border-subtle bg-bg-secondary px-1 py-0.5 font-mono text-[11px] text-text-primary">$1</code>');
      s = s.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-text-primary">$1</strong>');
      s = s.replace(/\*([^*]+)\*/g, '<em class="italic">$1</em>');
      return s;
    };

    for (const raw of lines) {
      const line = raw.trim();
      if (!line) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        continue;
      }
      if (/^---+$/.test(line)) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        out.push('<hr class="my-2.5 border-border-subtle" />');
        continue;
      }
      if (line.startsWith("### ")) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        out.push(`<h4 class="mt-2.5 mb-1 font-mono text-xs font-bold uppercase tracking-wider text-accent-primary">${inline(line.slice(4))}</h4>`);
        continue;
      }
      if (line.startsWith("## ") || line.startsWith("# ")) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        out.push(`<h3 class="mt-2 mb-1 text-sm font-bold text-text-primary">${inline(line.replace(/^#+\s+/, ""))}</h3>`);
        continue;
      }
      if (line.startsWith("- ") || line.startsWith("* ")) {
        if (!inList) {
          out.push('<ul class="my-1.5 list-disc space-y-1 pl-4 text-xs text-text-secondary">');
          inList = true;
        }
        out.push(`<li>${inline(line.slice(2))}</li>`);
        continue;
      }
      if (inList) {
        out.push("</ul>");
        inList = false;
      }
      out.push(`<p class="my-1 text-xs text-text-secondary leading-relaxed">${inline(line)}</p>`);
    }

    if (inList) out.push("</ul>");
    return out.join("");
  }

  function filterItems() {
    const items = document.querySelectorAll<HTMLElement>(".archive-release-item");
    const blocks = document.querySelectorAll<HTMLElement>(".archive-series-block");
    let totalVisible = 0;

    items.forEach((item) => {
      const itemType = item.getAttribute("data-type") || "stable";
      const itemTag = (item.getAttribute("data-tag") || "").toLowerCase();

      const matchesType =
        activeTypeFilter === "all" ||
        (activeTypeFilter === "stable" && itemType === "stable") ||
        (activeTypeFilter === "preview" && itemType === "preview");

      const matchesSearch =
        !activeSearchQuery || itemTag.includes(activeSearchQuery);

      if (matchesType && matchesSearch) {
        item.classList.remove("hidden");
        totalVisible++;
      } else {
        item.classList.add("hidden");
      }
    });

    blocks.forEach((block) => {
      const visibleChildren = block.querySelectorAll(".archive-release-item:not(.hidden)");
      if (visibleChildren.length === 0) {
        block.classList.add("hidden");
      } else {
        block.classList.remove("hidden");
      }
    });

    if (emptyNotice) {
      if (totalVisible === 0) {
        emptyNotice.classList.remove("hidden");
      } else {
        emptyNotice.classList.add("hidden");
      }
    }
  }

  searchInput?.addEventListener("input", () => {
    activeSearchQuery = searchInput.value.trim().toLowerCase();
    filterItems();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => {
        b.classList.remove("bg-surface-elevated", "text-text-primary", "shadow-sm", "font-semibold");
        b.classList.add("text-text-secondary", "font-medium");
      });
      btn.classList.add("bg-surface-elevated", "text-text-primary", "shadow-sm", "font-semibold");
      btn.classList.remove("text-text-secondary", "font-medium");

      activeTypeFilter = (btn.getAttribute("data-archive-filter") as "all" | "stable" | "preview") || "all";
      filterItems();
    });
  });

  // Download Dropdown Handler
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("[data-download-dropdown-btn]");
    const allMenus = document.querySelectorAll("[data-download-menu]");

    if (btn) {
      e.stopPropagation();
      const wrap = btn.closest("[data-dropdown-wrap]");
      const menu = wrap?.querySelector("[data-download-menu]");
      const isHidden = menu?.classList.contains("hidden");

      allMenus.forEach((m) => m.classList.add("hidden"));

      if (isHidden && menu) {
        menu.classList.remove("hidden");
      }
      return;
    }

    if (!target.closest("[data-download-menu]")) {
      allMenus.forEach((m) => m.classList.add("hidden"));
    }
  });

  // Changelog Modal Open Handler
  function openChangelogModal(tag: string) {
    if (!changelogModal || !modalTitle || !modalBody || !modalGithubLink) return;

    modalTitle.textContent = `Release Notes: ${tag}`;
    modalGithubLink.href = `https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/tag/${tag}`;

    const found = releasesData.find((r) => r.tag_name === tag);
    if (found && found.body) {
      modalBody.innerHTML = renderMarkdown(found.body);
    } else {
      modalBody.innerHTML = `
        <div class="py-4 text-center">
          <p class="text-text-secondary">Official release notes for ${tag}.</p>
          <a href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/tag/${tag}" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 text-xs text-accent-primary hover:underline">
            View full details on GitHub Releases &rarr;
          </a>
        </div>
      `;
    }

    changelogModal.classList.remove("hidden");
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("[data-changelog-tag]");
    if (btn) {
      const tag = btn.getAttribute("data-changelog-tag");
      if (tag) openChangelogModal(tag);
    }
  });

  const closeModal = () => {
    changelogModal?.classList.add("hidden");
  };

  btnCloseModal?.addEventListener("click", closeModal);
  btnCloseModalBottom?.addEventListener("click", closeModal);
  changelogModal?.addEventListener("click", (e) => {
    if (e.target === changelogModal) closeModal();
  });

  // Wheel stopPropagation for Lenis on modal body
  modalBody?.addEventListener("wheel", (e) => {
    e.stopPropagation();
  });

  // Fetch Releases from GitHub to populate modal bodies and future versions
  async function loadReleasesData() {
    try {
      const res = await fetch(API_URL, {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!res.ok) return;
      const data = await res.json();
      if (Array.isArray(data)) {
        releasesData = data;
      }
    } catch {
      // Offline fallback
    }
  }

  loadReleasesData();
</script>
