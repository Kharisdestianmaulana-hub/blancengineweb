            <!-- Timeline Node Dot -->
            <div class="absolute -left-[27px] sm:-left-[35px] top-6 h-3.5 w-3.5 rounded-full border-2 border-bg-primary bg-text-muted shadow-sm"></div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <!-- Left: Version & Info -->
