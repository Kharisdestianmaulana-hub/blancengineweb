                      class="flex items-center justify-between rounded px-2.5 py-1.5 text-xs font-medium text-text-primary hover:bg-surface-hover hover:text-accent-primary"
                    >
                      <div class="flex items-center gap-2">
                        <Package class="h-3.5 w-3.5 text-accent-primary" />
                        <span>Installer (.exe)</span>
                      </div>
                      <span class="font-mono text-[10px] text-text-muted">~27.7 MB</span>
                    </a>
                    <a
                      href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.0/BlancEngine-0.1.0-Portable.exe"
                      class="flex items-center justify-between rounded px-2.5 py-1.5 text-xs font-medium text-text-primary hover:bg-surface-hover hover:text-accent-primary"
                    >
                      <div class="flex items-center gap-2">
                        <Download class="h-3.5 w-3.5 text-text-muted" />
                        <span>Portable (.exe)</span>
                      </div>
                      <span class="font-mono text-[10px] text-text-muted">~128 MB</span>
                    </a>
                  </div>
                </div>

                <!-- 2. News Button -->
                <a
                  href="/blog"
                  class="inline-flex items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3 py-1.5 text-xs font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors"
                >
                  <Newspaper class="h-3.5 w-3.5 text-text-muted" />
                  <span>News</span>
                </a>

                <!-- 3. Changelog Button -->
                <button
                  type="button"
                  data-changelog-tag="v0.1.0"
                  class="inline-flex items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3 py-1.5 text-xs font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
                >
                  <GitCommit class="h-3.5 w-3.5 text-text-muted" />
                  <span>Changelog</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Release Item 3: v0.1.0-beta (Beta / Preview) -->
          <div
            class="archive-release-item relative rounded-xl border border-border-default bg-surface-primary p-4 sm:p-5 shadow-sm transition-all hover:border-accent-primary/60"
            data-tag="v0.1.0-beta"
            data-type="preview"
          >
            <!-- Timeline Node Dot -->
            <div class="absolute -left-[27px] sm:-left-[35px] top-6 h-3.5 w-3.5 rounded-full border-2 border-bg-primary bg-status-warning shadow-sm"></div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <!-- Left: Version & Info -->
              <div class="space-y-1.5 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-mono text-base sm:text-lg font-bold text-text-primary">
                    v0.1.0-beta
                  </h3>
                  <span class="rounded border border-status-warning/40 bg-status-warning/10 px-2 py-0.5 font-mono text-[10px] font-bold text-status-warning">
                    Beta
                  </span>
                  <span class="inline-flex items-center gap-1 font-mono text-xs text-text-muted">
                    <Calendar class="h-3 w-3" />
                    <span>15 November 2026</span>
                  </span>
                </div>
                <p class="text-xs text-text-secondary line-clamp-1">
                  Public beta testing release for visual novel creation engine built with Rust and Iced.
                </p>
              </div>

              <!-- Right: 3 Action Buttons -->
              <div class="flex flex-wrap items-center gap-2 shrink-0">
                <!-- 1. Download Dropdown -->
                <div class="relative inline-block text-left" data-dropdown-wrap>
                  <button
                    type="button"
                    class="inline-flex items-center gap-1.5 rounded-md bg-accent-primary px-3 py-1.5 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover cursor-pointer"
                    data-download-dropdown-btn
