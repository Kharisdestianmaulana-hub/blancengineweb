---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  Newspaper,
  Calendar,
  ArrowRight,
  Tag,
  Sparkles,
  Filter,
  ChevronDown,
  User,
} from "lucide-astro";

const INITIAL_POSTS = [
  {
    id: 4,
    slug: "blanc-engine-v020-devlog-free-form-ui-canvas-studio-custom-ui-skins-and-visual-logic",
    title: "Blanc Engine v0.2.0 Devlog: Free-Form UI Canvas Studio, Custom UI Skins, and Visual Logic",
    excerpt: "A deep dive into Blanc Engine v0.2.0: bringing a 3-panel Godot/Unity-style Free-Form UI Designer, custom PNG skins for every widget, Visual Variables & Conditions, and cross-platform expansion.",
    cover_url: "/screenshots/SS_OVERVIEW.png",
    author: "Blanc Core Team",
    tags: "Devlog, v0.2.0, UI Designer, Major Update",
    published_at: "2026-11-25 12:28:41",
  },
  {
    id: 3,
    slug: "blanc-engine-v011-security-hardening-atomic-saves-and-runtime-stability",
    title: "Blanc Engine v0.1.1: Security Hardening, Atomic Saves, and Runtime Stability",
    excerpt: "A focused maintenance release introducing atomic file writes, path-traversal protection, Story Flow cycle guards, and smoother keyboard/gamepad navigation.",
    cover_url: "/screenshots/SS_OVERVIEW.png",
    author: "Blanc Core Team",
    tags: "Release, v0.1.1, Patch Notes",
    published_at: "2026-11-25 12:28:08",
  },
  {
    id: 2,
    slug: "blanc-engine-v010-released-write-design-and-ship-visual-novels-with-zero-code",
    title: "Blanc Engine v0.1.0 Released: Write, Design, and Ship Visual Novels With Zero Code",
    excerpt: "Our first public release! Blanc Engine v0.1.0 brings the complete no-code pipeline from screenplay writing and Story Flow graphs to encrypted .bpack exports and standalone Windows installers.",
    cover_url: "/screenshots/SS_OVERVIEW.png",
    author: "Blanc Core Team",
    tags: "Release, v0.1.0, Announcements",
    published_at: "2026-11-25 12:27:37",
  },
  {
    id: 1,
    slug: "welcome-to-blanc-engine",
    title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
    excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
    cover_url: "/screenshots/SS_OVERVIEW.png",
    author: "Blanc Core Team",
    tags: "Announcements, Devlog",
    published_at: "2026-11-25 11:43:15",
  },
];

const featuredPost = INITIAL_POSTS[0];
const gridPosts = INITIAL_POSTS.slice(1);

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blanc Engine Devlogs & News",
  description: "Official development logs, release announcements, feature breakdowns, and engine updates from the Blanc Engine team.",
  url: "https://getblanc.web.id/blog/",
  blogPost: INITIAL_POSTS.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.excerpt,
    url: `https://getblanc.web.id/blog/post/?slug=${post.slug}`,
    datePublished: post.published_at.slice(0, 10),
    author: {
      "@type": "Organization",
      name: post.author,
    },
    image: `https://getblanc.web.id${post.cover_url}`,
  })),
};
---

<BaseLayout
  title="Blog & Devlogs: Blanc Engine Visual Novel Development"
  description="Read official devlogs, release announcements, feature breakdowns, and engine updates from the Blanc Engine team."
  ogImage="/screenshots/SS_OVERVIEW.png"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]}
  schema={blogSchema}
>
  <Navbar />

  <!-- 1. Full-Width Cinematic Hero Header (Spotlight on latest devlog ala Detail Blog) -->
  <section
    id="blog-featured-hero"
    class="relative w-full overflow-hidden border-b border-border-default min-h-[380px] sm:min-h-[440px] lg:min-h-[500px] flex items-end"
  >
    <!-- Background Cover Image -->
    <div
      id="hero-cover-bg"
      class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat transition-all duration-700"
      style={`background-image: url('${featuredPost.cover_url}');`}
    ></div>

    <!-- Dark Gradient Overlays (Solid bottom to transparent top, plus lateral shading) -->
    <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-bg-primary/85 to-transparent/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-bg-primary/90 via-transparent to-bg-primary/50"></div>

    <!-- Foreground Content -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 pb-10 pt-16 sm:pb-12 sm:pt-20">
      <!-- Badges: Featured Pill + Tag + Date + Author -->
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-primary/50 bg-accent-primary/20 px-3 py-1 font-mono text-xs font-bold text-accent-primary backdrop-blur-md">
          <Sparkles class="h-3.5 w-3.5" />
          <span>Latest Devlog</span>
        </span>

        <span
          id="hero-tag"
          class="rounded border border-border-default bg-surface-primary/80 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-text-primary backdrop-blur-sm"
        >
          {featuredPost.tags.split(",")[0].trim()}
        </span>

        <span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted bg-black/40 px-2 py-0.5 rounded backdrop-blur-sm">
          <Calendar class="h-3.5 w-3.5 text-text-muted" />
          <span id="hero-date">{featuredPost.published_at.slice(0, 10)}</span>
        </span>

        <span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted bg-black/40 px-2 py-0.5 rounded backdrop-blur-sm">
          <User class="h-3.5 w-3.5 text-text-muted" />
          <span id="hero-author">{featuredPost.author}</span>
        </span>
      </div>

      <!-- Large Bold Title -->
      <h1
        id="hero-title"
        class="mt-4 text-2xl font-bold tracking-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] sm:text-3xl lg:text-4xl leading-tight max-w-4xl"
      >
        <a id="hero-link-title" href={`/blog/post/?slug=${encodeURIComponent(featuredPost.slug)}`} class="hover:text-accent-primary transition-colors">
          {featuredPost.title}
        </a>
      </h1>

      <!-- Excerpt -->
      <p
        id="hero-excerpt"
        class="mt-2.5 max-w-3xl text-xs sm:text-sm text-text-secondary leading-relaxed line-clamp-2"
      >
        {featuredPost.excerpt}
      </p>

      <!-- Action Button -->
      <div class="mt-5">
        <a
          id="hero-link-btn"
          href={`/blog/post/?slug=${encodeURIComponent(featuredPost.slug)}`}
          class="inline-flex items-center gap-2 rounded-md bg-accent-primary px-4 py-2 text-xs sm:text-sm font-semibold text-text-on-accent transition-colors hover:bg-accent-hover shadow-lg shadow-accent-primary/20 cursor-pointer"
        >
          <span>Read Full Devlog</span>
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Main Catalog Section -->
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Header Title & Filter Bar -->
    <div class="border-b border-border-default pb-5">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <Newspaper class="h-4 w-4 text-text-muted" />
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-text-muted">
              Official Devlogs & News
            </span>
          </div>
          <h2 class="mt-1.5 text-xl font-bold tracking-tight text-text-primary sm:text-2xl">
            All Devlogs & Updates
          </h2>
        </div>
      </div>

      <!-- Linear / GitHub Style Category Filter Bar -->
      <div id="blog-category-bar" class="mt-4 hidden items-center gap-2 flex-wrap relative">
        <span class="mr-1 text-[11px] font-medium text-text-muted">Category:</span>

        <!-- Quick Pills: All + Top 4 Tags -->
        <div id="blog-quick-pills" class="flex flex-wrap items-center gap-1.5">
          <button
            type="button"
            data-blog-filter="all"
            class="rounded border border-border-default bg-accent-subtle px-2 py-0.5 text-[11px] font-semibold text-accent-primary transition-colors cursor-pointer"
          >
            All
          </button>
        </div>

        <!-- Linear Style Popover Dropdown -->
        <div class="relative inline-block text-left" id="blog-cat-popover-wrap">
          <button
            id="btn-blog-cat-dropdown"
            type="button"
            aria-expanded="false"
            class="inline-flex items-center gap-1.5 rounded border border-border-default bg-surface-primary px-2.5 py-0.5 text-[11px] font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <Filter class="h-3 w-3 text-text-muted" />
            <span id="btn-blog-cat-label">More Categories</span>
            <span id="blog-cat-badge-count" class="hidden rounded-full bg-accent-primary px-1.5 py-0.2 text-[9px] font-bold text-text-on-accent">0</span>
            <ChevronDown class="h-3 w-3 text-text-muted transition-transform" />
          </button>

          <!-- Floating Popover Panel -->
          <div
            id="blog-cat-popover"
            class="hidden absolute left-0 top-full mt-2 w-72 rounded-xl border border-border-default bg-surface-primary/95 p-3 shadow-2xl backdrop-blur-xl z-40 space-y-2.5"
          >
            <div class="flex items-center justify-between border-b border-border-subtle pb-2">
              <span class="text-xs font-semibold text-text-primary">Filter Categories</span>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="btn-blog-select-all"
                  class="text-[10px] font-medium text-accent-primary hover:underline cursor-pointer"
                >
                  Select All
                </button>
                <span class="text-text-muted text-[10px]">•</span>
                <button
                  type="button"
                  id="btn-blog-clear"
                  class="text-[10px] font-medium text-text-muted hover:text-text-primary cursor-pointer"
                >
                  Reset
                </button>
              </div>
            </div>

            <!-- Search Input in Popover -->
            <div class="relative">
              <input
                type="text"
                id="blog-cat-search-input"
                placeholder="Search categories..."
                class="w-full rounded border border-border-default bg-bg-secondary px-2.5 py-1 text-xs text-text-primary placeholder:text-text-muted focus:border-accent-primary focus:outline-none"
              />
            </div>

            <!-- Checkbox List -->
            <div id="blog-cat-checkbox-list" class="max-h-48 overflow-y-auto space-y-1 pr-1 overscroll-contain"></div>

            <!-- Bottom Summary & Apply -->
            <div class="border-t border-border-subtle pt-2 flex items-center justify-between">
              <span id="blog-cat-selected-summary" class="text-[11px] text-text-muted font-mono">All selected</span>
              <button
                type="button"
                id="btn-blog-cat-apply"
                class="rounded bg-accent-primary px-3 py-1 text-[11px] font-semibold text-text-on-accent hover:bg-accent-hover transition-colors cursor-pointer"
              >
                Done
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Posts Grid: Flat Godot-style Layout without Cards -->
    <div class="mt-8">
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {gridPosts.map((p) => (
          <article class="group flex flex-col justify-between transition-all duration-200">
            <div>
              <!-- 16:9 Thumbnail Cover (Independent Rounded Frame ala Godot) -->
              <a href={`/blog/post/?slug=${encodeURIComponent(p.slug)}`} class="block aspect-video w-full overflow-hidden rounded-xl bg-surface-elevated border border-border-default/60 transition-colors group-hover:border-accent-primary/40">
                <img
                  src={p.cover_url || "/screenshots/SS_OVERVIEW.png"}
                  alt={p.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  onerror="this.src='/screenshots/SS_OVERVIEW.png'"
                />
              </a>

              <!-- Author Avatar + Name + Date Meta Line -->
              <div class="mt-3.5 flex items-center justify-between gap-2 text-xs text-text-muted">
                <div class="flex items-center gap-2 min-w-0">
                  <div class="flex h-5 w-5 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent-primary uppercase shrink-0">
                    {p.author ? p.author.charAt(0) : "B"}
                  </div>
                  <span class="font-medium text-text-secondary truncate">{p.author || "Blanc Core Team"}</span>
                  <span class="text-text-muted">•</span>
                  <time class="font-mono text-[11px] text-text-muted shrink-0">{p.published_at.slice(0, 10)}</time>
                </div>

                {p.tags && (
                  <span class="rounded bg-surface-elevated border border-border-default px-2 py-0.5 font-mono text-[10px] text-text-muted shrink-0">
                    {p.tags.split(",")[0].trim()}
                  </span>
                )}
              </div>

              <!-- Title -->
              <h2 class="mt-2.5 text-base sm:text-lg font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
                <a href={`/blog/post/?slug=${encodeURIComponent(p.slug)}`}>
                  {p.title}
                </a>
              </h2>

              <!-- Excerpt (2 lines clean flat) -->
              <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-text-secondary line-clamp-2">
                {p.excerpt}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface BlogPost {
    id: number;
    slug: string;
    title: string;
    excerpt: string;
    cover_url: string;
    author: string;
    tags: string;
    published_at: string;
  }

  const DEFAULT_POSTS: BlogPost[] = [
    {
      id: 4,
      slug: "blanc-engine-v020-devlog-free-form-ui-canvas-studio-custom-ui-skins-and-visual-logic",
      title: "Blanc Engine v0.2.0 Devlog: Free-Form UI Canvas Studio, Custom UI Skins, and Visual Logic",
      excerpt: "A deep dive into Blanc Engine v0.2.0: bringing a 3-panel Godot/Unity-style Free-Form UI Designer, custom PNG skins for every widget, Visual Variables & Conditions, and cross-platform expansion.",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      author: "Blanc Core Team",
      tags: "Devlog, v0.2.0, UI Designer, Major Update",
      published_at: "2026-11-25 12:28:41",
    },
    {
      id: 3,
      slug: "blanc-engine-v011-security-hardening-atomic-saves-and-runtime-stability",
      title: "Blanc Engine v0.1.1: Security Hardening, Atomic Saves, and Runtime Stability",
      excerpt: "A focused maintenance release introducing atomic file writes, path-traversal protection, Story Flow cycle guards, and smoother keyboard/gamepad navigation.",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      author: "Blanc Core Team",
      tags: "Release, v0.1.1, Patch Notes",
      published_at: "2026-11-25 12:28:08",
    },
    {
      id: 2,
      slug: "blanc-engine-v010-released-write-design-and-ship-visual-novels-with-zero-code",
      title: "Blanc Engine v0.1.0 Released: Write, Design, and Ship Visual Novels With Zero Code",
      excerpt: "Our first public release! Blanc Engine v0.1.0 brings the complete no-code pipeline from screenplay writing and Story Flow graphs to encrypted .bpack exports and standalone Windows installers.",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      author: "Blanc Core Team",
      tags: "Release, v0.1.0, Announcements",
      published_at: "2026-11-25 12:27:37",
    },
    {
      id: 1,
      slug: "welcome-to-blanc-engine",
      title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
      excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      author: "Blanc Core Team",
      tags: "Announcements, Devlog",
      published_at: "2026-11-25 11:43:15",
    },
  ];

  const gridEl = document.getElementById("blog-grid");
  const blogFeaturedHero = document.getElementById("blog-featured-hero");
  const heroCoverBg = document.getElementById("hero-cover-bg");
  const heroTag = document.getElementById("hero-tag");
  const heroDate = document.getElementById("hero-date");
  const heroAuthor = document.getElementById("hero-author");
  const heroTitle = document.getElementById("hero-title");
  const heroLinkTitle = document.getElementById("hero-link-title") as HTMLAnchorElement | null;
  const heroExcerpt = document.getElementById("hero-excerpt");
  const heroLinkBtn = document.getElementById("hero-link-btn") as HTMLAnchorElement | null;

  const blogCategoryBar = document.getElementById("blog-category-bar");
  const blogQuickPills = document.getElementById("blog-quick-pills");
  const blogCatPopover = document.getElementById("blog-cat-popover");
  const btnBlogCatDropdown = document.getElementById("btn-blog-cat-dropdown");
  const btnBlogCatLabel = document.getElementById("btn-blog-cat-label");
  const blogCatBadgeCount = document.getElementById("blog-cat-badge-count");
  const blogCatSearchInput = document.getElementById("blog-cat-search-input") as HTMLInputElement | null;
  const blogCatCheckboxList = document.getElementById("blog-cat-checkbox-list");
  const blogCatSelectedSummary = document.getElementById("blog-cat-selected-summary");
  const btnBlogSelectAll = document.getElementById("btn-blog-select-all");
  const btnBlogClear = document.getElementById("btn-blog-clear");
  const btnBlogCatApply = document.getElementById("btn-blog-cat-apply");

  let allBlogPosts: BlogPost[] = [];
  let selectedCategories = new Set<string>();

  function esc(str: string): string {
    return (str || "")
      .replace(/\u2014/g, " - ")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function updateFeaturedHero(post: BlogPost | null) {
    if (!blogFeaturedHero) return;

    if (!post) {
      blogFeaturedHero.classList.add("hidden");
      return;
    }

    blogFeaturedHero.classList.remove("hidden");

    if (heroCoverBg) {
      const cover = post.cover_url || "/screenshots/SS_OVERVIEW.png";
      heroCoverBg.style.backgroundImage = `url('${cover}')`;
    }

    const postUrl = `/blog/post/?slug=${encodeURIComponent(post.slug)}`;

    if (heroTag) heroTag.textContent = (post.tags || "Devlog").split(",")[0].trim();
    if (heroDate) heroDate.textContent = (post.published_at || "").slice(0, 10);
    if (heroAuthor) heroAuthor.textContent = post.author || "Blanc Core Team";

    if (heroLinkTitle) {
      heroLinkTitle.textContent = post.title;
      heroLinkTitle.href = postUrl;
    }

    if (heroExcerpt) heroExcerpt.textContent = post.excerpt;

    if (heroLinkBtn) {
      heroLinkBtn.href = postUrl;
    }
  }

  function updateBlogCategories() {
    if (!blogCategoryBar) return;
    const catCounts = new Map<string, number>();

    allBlogPosts.forEach((p) => {
      if (p.tags) {
        p.tags.split(",").forEach((t) => {
          const trimmed = t.trim();
          if (trimmed) {
            catCounts.set(trimmed, (catCounts.get(trimmed) || 0) + 1);
          }
        });
      }
    });

    if (catCounts.size === 0) {
      blogCategoryBar.classList.add("hidden");
      blogCategoryBar.classList.remove("flex");
      return;
    }

    blogCategoryBar.classList.remove("hidden");
    blogCategoryBar.classList.add("flex");

    // Sort categories by frequency descending, then alphabetical
    const sortedCategories = Array.from(catCounts.keys()).sort((a, b) => {
      const diff = (catCounts.get(b) || 0) - (catCounts.get(a) || 0);
      if (diff !== 0) return diff;
      return a.localeCompare(b);
    });

    // Top 4 categories for quick pills
    const topQuickCategories = sortedCategories.slice(0, 4);

    // Render Quick Pills: "All" + Top 4 categories
    if (blogQuickPills) {
      const isAllActive = selectedCategories.size === 0;
      let pillsHtml = `
        <button
          type="button"
          data-blog-filter="all"
          class="rounded border px-2 py-0.5 text-[11px] transition-colors cursor-pointer ${
            isAllActive
              ? "bg-accent-subtle text-accent-primary font-semibold border-accent-primary/40"
              : "border-border-default text-text-secondary hover:bg-surface-hover hover:text-text-primary"
          }"
        >
          All
        </button>
      `;

      topQuickCategories.forEach((cat) => {
        const isSingleSelected =
          selectedCategories.size === 1 && selectedCategories.has(cat.toLowerCase());
        pillsHtml += `
          <button
            type="button"
            data-blog-filter="${esc(cat)}"
            class="rounded border px-2 py-0.5 text-[11px] font-medium transition-colors cursor-pointer ${
              isSingleSelected
                ? "bg-accent-subtle text-accent-primary font-semibold border-accent-primary/40"
                : "border-border-default text-text-secondary hover:bg-surface-hover hover:text-text-primary"
            }"
          >
            ${esc(cat)}
          </button>
        `;
      });

      blogQuickPills.innerHTML = pillsHtml;

      blogQuickPills.querySelectorAll("[data-blog-filter]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const filterVal = btn.getAttribute("data-blog-filter");
          if (!filterVal || filterVal === "all") {
            selectedCategories.clear();
          } else {
            selectedCategories.clear();
            selectedCategories.add(filterVal.toLowerCase());
          }
          updateBlogCategories();
          renderCurrentGrid();
        });
      });
    }

    // Render Popover Checkboxes
    renderCategoryCheckboxes(sortedCategories, catCounts);

    // Update Dropdown Button UI (Active indicator / Badge count)
    if (btnBlogCatDropdown && blogCatBadgeCount && btnBlogCatLabel) {
      const count = selectedCategories.size;

      if (count > 0) {
        btnBlogCatDropdown.classList.add("border-accent-primary/50", "bg-accent-subtle", "text-accent-primary");
        btnBlogCatDropdown.classList.remove("text-text-secondary", "bg-surface-primary");
        blogCatBadgeCount.classList.remove("hidden");
        blogCatBadgeCount.textContent = String(count);
        btnBlogCatLabel.textContent = count === 1 ? "1 Category" : `${count} Categories`;
      } else {
        btnBlogCatDropdown.classList.remove("border-accent-primary/50", "bg-accent-subtle", "text-accent-primary");
        btnBlogCatDropdown.classList.add("text-text-secondary", "bg-surface-primary");
        blogCatBadgeCount.classList.add("hidden");
        btnBlogCatLabel.textContent = "More Categories";
      }
    }

    // Update summary text in popover bottom bar
    if (blogCatSelectedSummary) {
      if (selectedCategories.size === 0) {
        blogCatSelectedSummary.textContent = "All categories active";
      } else {
        blogCatSelectedSummary.textContent = `${selectedCategories.size} selected`;
      }
    }
  }

  function renderCategoryCheckboxes(categories: string[], catCounts: Map<string, number>) {
    if (!blogCatCheckboxList) return;
    const filterQuery = (blogCatSearchInput?.value || "").trim().toLowerCase();

    const filtered = categories.filter((c) => !filterQuery || c.toLowerCase().includes(filterQuery));

    if (filtered.length === 0) {
      blogCatCheckboxList.innerHTML = `<div class="p-3 text-center text-xs text-text-muted">No categories match "${esc(filterQuery)}"</div>`;
      return;
    }

    blogCatCheckboxList.innerHTML = filtered
      .map((cat) => {
        const isChecked = selectedCategories.has(cat.toLowerCase());
        const count = catCounts.get(cat) || 0;
        return `
          <label class="flex items-center justify-between gap-2 rounded px-2 py-1.5 text-xs hover:bg-surface-hover cursor-pointer transition-colors select-none ${
            isChecked ? "bg-accent-subtle/50" : ""
          }">
            <div class="flex items-center gap-2 min-w-0">
              <input
                type="checkbox"
                data-blog-checkbox="${esc(cat.toLowerCase())}"
                class="h-3.5 w-3.5 rounded border-border-default bg-surface-primary text-accent-primary accent-accent-primary cursor-pointer"
                ${isChecked ? "checked" : ""}
              />
              <span class="truncate text-[11px] font-medium ${isChecked ? "text-accent-primary font-semibold" : "text-text-primary"}">
                ${esc(cat)}
              </span>
            </div>
            <span class="font-mono text-[10px] text-text-muted shrink-0">
              ${count}
            </span>
          </label>
        `;
      })
      .join("");

    blogCatCheckboxList.querySelectorAll<HTMLInputElement>("[data-blog-checkbox]").forEach((cb) => {
      cb.addEventListener("change", () => {
        const val = cb.getAttribute("data-blog-checkbox");
        if (!val) return;
        if (cb.checked) {
          selectedCategories.add(val);
        } else {
          selectedCategories.delete(val);
        }
        updateBlogCategories();
        renderCurrentGrid();
      });
    });
  }

  function renderCurrentGrid() {
    if (selectedCategories.size === 0) {
      // Pilihan 2: Latest post is shown as Featured Hero on top
      if (allBlogPosts.length > 0) {
        updateFeaturedHero(allBlogPosts[0]);
        // Exclude the hero post from the grid below to avoid duplicate!
        renderPosts(allBlogPosts.slice(1));
      } else {
        updateFeaturedHero(null);
        renderPosts([]);
      }
    } else {
      // When filtering, hide hero to focus cleanly on filtered search results
      if (blogFeaturedHero) blogFeaturedHero.classList.add("hidden");

      const filtered = allBlogPosts.filter((p) => {
        if (!p.tags) return false;
        const tags = p.tags.split(",").map((t) => t.trim().toLowerCase());
        return tags.some((t) => selectedCategories.has(t));
      });

      renderPosts(filtered);
    }
  }

  function renderPosts(posts: BlogPost[]) {
    if (!gridEl) return;

    if (posts.length === 0) {
      gridEl.innerHTML = `
        <div class="col-span-full rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
          No articles match the selected category filter.
        </div>
      `;
      return;
    }

    gridEl.innerHTML = posts
      .map(
        (p) => `
        <article class="group flex flex-col justify-between transition-all duration-200">
          <div>
            <!-- 16:9 Thumbnail Cover (Independent Rounded Frame ala Godot) -->
            <a href="/blog/post/?slug=${encodeURIComponent(p.slug)}" class="block aspect-video w-full overflow-hidden rounded-xl bg-surface-elevated border border-border-default/60 transition-colors group-hover:border-accent-primary/40">
              <img
                src="${esc(p.cover_url || "/screenshots/SS_OVERVIEW.png")}"
                alt="${esc(p.title)}"
                class="h-full w-full object-cover"
                loading="lazy"
                onerror="this.src='/screenshots/SS_OVERVIEW.png'"
              />
            </a>

            <!-- Author Avatar + Name + Date Meta Line -->
            <div class="mt-3.5 flex items-center justify-between gap-2 text-xs text-text-muted">
              <div class="flex items-center gap-2 min-w-0">
                <div class="flex h-5 w-5 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent-primary uppercase shrink-0">
                  ${esc(p.author ? p.author.charAt(0) : "B")}
                </div>
                <span class="font-medium text-text-secondary truncate">${esc(p.author || "Blanc Core Team")}</span>
                <span class="text-text-muted">•</span>
                <time class="font-mono text-[11px] text-text-muted shrink-0">${(p.published_at || "").slice(0, 10)}</time>
              </div>

              ${
                p.tags
                  ? `
                <span class="rounded bg-surface-elevated border border-border-default px-2 py-0.5 font-mono text-[10px] text-text-muted shrink-0">
                  ${esc(p.tags.split(",")[0].trim())}
                </span>
              `
                  : ""
              }
            </div>

            <!-- Title -->
            <h2 class="mt-2.5 text-base sm:text-lg font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
              <a href="/blog/post/?slug=${encodeURIComponent(p.slug)}">
                ${esc(p.title)}
              </a>
            </h2>

            <!-- Excerpt (2 lines clean flat) -->
            <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-text-secondary line-clamp-2">
              ${esc(p.excerpt)}
            </p>
          </div>
        </article>
      `
      )
      .join("");
  }

  function updateBlogPopoverPosition() {
    if (!blogCatPopover || !btnBlogCatDropdown) return;
    const rect = btnBlogCatDropdown.getBoundingClientRect();
    const popoverHeight = blogCatPopover.offsetHeight || 320;
    const spaceBelow = window.innerHeight - rect.bottom;
    const spaceAbove = rect.top;

    if (spaceBelow < popoverHeight + 16 && spaceAbove > spaceBelow) {
      blogCatPopover.classList.remove("top-full", "mt-2");
      blogCatPopover.classList.add("bottom-full", "mb-2");
    } else {
      blogCatPopover.classList.remove("bottom-full", "mb-2");
      blogCatPopover.classList.add("top-full", "mt-2");
    }

    if (rect.left + 300 > window.innerWidth) {
      blogCatPopover.classList.remove("left-0");
      blogCatPopover.classList.add("right-0");
    } else {
      blogCatPopover.classList.remove("right-0");
      blogCatPopover.classList.add("left-0");
    }
  }

  // Category Popover Controls
  btnBlogCatDropdown?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpening = blogCatPopover?.classList.contains("hidden");
    if (isOpening) {
      blogCatPopover?.classList.remove("hidden");
      updateBlogPopoverPosition();
    } else {
      blogCatPopover?.classList.add("hidden");
    }
    btnBlogCatDropdown.setAttribute("aria-expanded", String(isOpening));
  });

  blogCatPopover?.addEventListener("click", (e) => {
    e.stopPropagation();
  });

  document.addEventListener("click", () => {
    blogCatPopover?.classList.add("hidden");
    btnBlogCatDropdown?.setAttribute("aria-expanded", "false");
  });

  blogCatSearchInput?.addEventListener("input", () => {
    updateBlogCategories();
  });

  btnBlogSelectAll?.addEventListener("click", () => {
    allBlogPosts.forEach((item) => {
      if (item.tags) {
        item.tags.split(",").forEach((t) => {
          const trimmed = t.trim().toLowerCase();
          if (trimmed) selectedCategories.add(trimmed);
        });
      }
    });
    updateBlogCategories();
    renderCurrentGrid();
  });

  btnBlogClear?.addEventListener("click", () => {
    selectedCategories.clear();
    updateBlogCategories();
    renderCurrentGrid();
  });

  btnBlogCatApply?.addEventListener("click", () => {
    blogCatPopover?.classList.add("hidden");
    btnBlogCatDropdown?.setAttribute("aria-expanded", "false");
  });

  async function loadBlog() {
    try {
      const res = await fetch("/api/blog");
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts) && data.posts.length > 0) {
          allBlogPosts = data.posts;
          updateBlogCategories();
          renderCurrentGrid();
          return;
        }
      }
    } catch {
      // Fallback below
    }

    allBlogPosts = DEFAULT_POSTS;
    updateBlogCategories();
    renderCurrentGrid();
  }

  loadBlog();
</script>
