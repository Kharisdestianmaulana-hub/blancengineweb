---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Newspaper, Calendar, ArrowRight, Tag, Sparkles } from "lucide-astro";
---

<BaseLayout
  title="Blog & Devlogs: Blanc Engine Visual Novel Development"
  description="Read official devlogs, release announcements, feature breakdowns, and engine updates from the Blanc Engine team."
  ogImage="/screenshots/SS_OVERVIEW.png"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]}
>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-b border-border-default pb-6">
      <div class="flex items-center gap-2">
        <Newspaper class="h-4 w-4 text-text-muted" />
        <span class="font-mono text-xs font-medium uppercase tracking-wider text-text-muted">
          Official Devlogs & News
        </span>
      </div>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Blanc Engine Blog
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
        Development progress, architectural breakdowns, release notes, and tutorials from the Blanc Engine core team.
      </p>

      <!-- Godot-style Category Pills Bar -->
      <div id="blog-categories" class="mt-5 hidden flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-text-primary mr-1">Categories</span>
        <div id="blog-category-pills" class="flex flex-wrap items-center gap-1.5">
          <button
            type="button"
            data-blog-category="all"
            class="rounded-full border border-accent-primary/40 bg-accent-subtle px-3 py-1 text-xs font-semibold text-accent-primary transition-colors cursor-pointer"
          >
            All
          </button>
        </div>
      </div>
    </div>

    <!-- Posts Grid: Flat Godot-style Layout without Cards -->
    <div class="mt-8">
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        <div class="col-span-full rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
          Loading latest devlogs and announcements...
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface BlogPost {
    id: number;
    slug: string;
    title: string;
    excerpt: string;
    cover_url: string;
    author: string;
    tags: string;
    published_at: string;
  }

  const DEFAULT_POSTS: BlogPost[] = [
    {
      id: 1,
      slug: "welcome-to-blanc-engine",
      title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
      excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      author: "Blanc Core Team",
      tags: "Announcements, Devlog",
      published_at: "2026-11-25",
    },
  ];

  const gridEl = document.getElementById("blog-grid");
  const blogCategoriesWrap = document.getElementById("blog-categories");
  const blogCategoryPills = document.getElementById("blog-category-pills");

  let allBlogPosts: BlogPost[] = [];
  let activeCategory = "all";

  function esc(str: string): string {
    return (str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function updateBlogCategories() {
    if (!blogCategoriesWrap || !blogCategoryPills) return;
    const categories = new Set<string>();
    allBlogPosts.forEach((p) => {
      if (p.tags) {
        p.tags.split(",").forEach((t) => {
          const trimmed = t.trim();
          if (trimmed) categories.add(trimmed);
        });
      }
    });

    if (categories.size <= 1) {
      blogCategoriesWrap.classList.add("hidden");
      blogCategoriesWrap.classList.remove("flex");
      return;
    }

    blogCategoriesWrap.classList.remove("hidden");
    blogCategoriesWrap.classList.add("flex");

    const catList = ["all", ...Array.from(categories)];
    blogCategoryPills.innerHTML = catList
      .map((cat) => {
        const isActive = cat.toLowerCase() === activeCategory.toLowerCase();
        return `
          <button
            type="button"
            data-blog-category="${esc(cat)}"
            class="rounded-full border px-3 py-1 text-xs font-semibold transition-colors cursor-pointer ${
              isActive
                ? "border-accent-primary/40 bg-accent-subtle text-accent-primary"
                : "border-border-default bg-surface-primary text-text-secondary hover:bg-surface-hover hover:text-text-primary"
            }"
          >
            ${esc(cat === "all" ? "All" : cat)}
          </button>
        `;
      })
      .join("");

    blogCategoryPills.querySelectorAll<HTMLButtonElement>("[data-blog-category]").forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.getAttribute("data-blog-category") || "all";
        updateBlogCategories();
        renderCurrentGrid();
      });
    });
  }

  function renderCurrentGrid() {
    const filtered =
      activeCategory === "all"
        ? allBlogPosts
        : allBlogPosts.filter((p) => (p.tags || "").toLowerCase().includes(activeCategory.toLowerCase()));
    renderPosts(filtered);
  }

  function renderPosts(posts: BlogPost[]) {
    if (!gridEl) return;

    if (posts.length === 0) {
      gridEl.innerHTML = `
        <div class="col-span-full rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
          No articles match this category filter.
        </div>
      `;
      return;
    }

    gridEl.innerHTML = posts
      .map(
        (p) => `
        <article class="group flex flex-col justify-between transition-all duration-200">
          <div>
            <!-- 16:9 Thumbnail Cover (Independent Rounded Frame ala Godot) -->
            <a href="/blog/post/?slug=${encodeURIComponent(p.slug)}" class="block aspect-video w-full overflow-hidden rounded-xl bg-surface-elevated border border-border-default/60 shadow-sm transition-all duration-300 group-hover:shadow-md group-hover:border-accent-primary/40">
              <img
                src="${esc(p.cover_url || "/screenshots/SS_OVERVIEW.png")}"
                alt="${esc(p.title)}"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                onerror="this.src='/screenshots/SS_OVERVIEW.png'"
              />
            </a>

            <!-- Author Avatar + Name + Date Meta Line -->
            <div class="mt-3.5 flex items-center justify-between gap-2 text-xs text-text-muted">
              <div class="flex items-center gap-2 min-w-0">
                <div class="flex h-5 w-5 items-center justify-center rounded-full bg-accent-subtle text-[10px] font-bold text-accent-primary uppercase shrink-0">
                  ${esc(p.author ? p.author.charAt(0) : "B")}
                </div>
                <span class="font-medium text-text-secondary truncate">${esc(p.author || "Blanc Core Team")}</span>
                <span class="text-text-muted">•</span>
                <time class="font-mono text-[11px] text-text-muted shrink-0">${(p.published_at || "").slice(0, 10)}</time>
              </div>

              ${
                p.tags
                  ? `
                <span class="rounded bg-surface-elevated border border-border-default px-2 py-0.5 font-mono text-[10px] text-text-muted shrink-0">
                  ${esc(p.tags.split(",")[0].trim())}
                </span>
              `
                  : ""
              }
            </div>

            <!-- Title -->
            <h2 class="mt-2.5 text-base sm:text-lg font-bold tracking-tight text-text-primary group-hover:text-accent-primary transition-colors leading-snug">
              <a href="/blog/post/?slug=${encodeURIComponent(p.slug)}">
                ${esc(p.title)}
              </a>
            </h2>

            <!-- Excerpt (2 lines clean flat) -->
            <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-text-secondary line-clamp-2">
              ${esc(p.excerpt)}
            </p>
          </div>
        </article>
      `
      )
      .join("");
  }

  async function loadBlog() {
    try {
      const res = await fetch("/api/blog");
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts) && data.posts.length > 0) {
          allBlogPosts = data.posts;
          updateBlogCategories();
          renderCurrentGrid();
          return;
        }
      }
    } catch {
      // Fallback below
    }

    allBlogPosts = DEFAULT_POSTS;
    updateBlogCategories();
    renderCurrentGrid();
  }

  loadBlog();
</script>
