---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Newspaper, Calendar, ArrowRight, Tag, Sparkles } from "lucide-astro";
---

<BaseLayout
  title="Blog & Devlogs: Blanc Engine Visual Novel Development"
  description="Read official devlogs, release announcements, feature breakdowns, and engine updates from the Blanc Engine team."
  ogImage="/screenshots/SS_OVERVIEW.png"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]}
>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-b border-border-default pb-6">
      <div class="flex items-center gap-2">
        <Newspaper class="h-4 w-4 text-text-muted" />
        <span class="font-mono text-xs font-medium uppercase tracking-wider text-text-muted">
          Official Devlogs & News
        </span>
      </div>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Blanc Engine Blog
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
        Development progress, architectural breakdowns, release notes, and tutorials from the Blanc Engine core team.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="mt-8">
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="col-span-full rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
          Loading latest devlogs and announcements...
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface BlogPost {
    id: number;
    slug: string;
    title: string;
    excerpt: string;
    cover_url: string;
    author: string;
    tags: string;
    published_at: string;
  }

  const DEFAULT_POSTS: BlogPost[] = [
    {
      id: 1,
      slug: "welcome-to-blanc-engine",
      title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
      excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      author: "Blanc Core Team",
      tags: "Announcements, Devlog",
      published_at: "2026-11-25",
    },
  ];

  const gridEl = document.getElementById("blog-grid");

  function esc(str: string): string {
    return (str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function renderPosts(posts: BlogPost[]) {
    if (!gridEl) return;

    if (posts.length === 0) {
      gridEl.innerHTML = `
        <div class="col-span-full rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
          No articles published yet. Check back soon for our first devlog!
        </div>
      `;
      return;
    }

    gridEl.innerHTML = posts
      .map(
        (p) => `
        <article class="flex flex-col justify-between overflow-hidden rounded-xl border border-border-default bg-surface-primary transition-all duration-200 hover:border-accent-primary hover:shadow-lg">
          <div>
            <a href="/blog/post/?slug=${encodeURIComponent(p.slug)}" class="block aspect-video w-full overflow-hidden border-b border-border-subtle bg-bg-primary">
              <img
                src="${esc(p.cover_url || "/screenshots/SS_OVERVIEW.png")}"
                alt="${esc(p.title)}"
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
                onerror="this.src='/screenshots/SS_OVERVIEW.png'"
              />
            </a>

            <div class="p-5">
              <div class="flex items-center justify-between gap-2 text-xs font-mono text-text-muted">
                <span class="rounded border border-border-default bg-surface-elevated px-2 py-0.5 text-[11px] font-medium text-text-secondary">
                  ${esc(p.tags || "Devlog")}
                </span>
                <span>${(p.published_at || "").slice(0, 10)}</span>
              </div>

              <h2 class="mt-3 text-lg font-bold text-text-primary leading-snug">
                <a href="/blog/post/?slug=${encodeURIComponent(p.slug)}" class="hover:text-accent-primary transition-colors">
                  ${esc(p.title)}
                </a>
              </h2>

              <p class="mt-2 text-xs leading-relaxed text-text-secondary sm:text-sm line-clamp-3">
                ${esc(p.excerpt)}
              </p>
            </div>
          </div>

          <div class="p-5 pt-0">
            <a
              href="/blog/post/?slug=${encodeURIComponent(p.slug)}"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent-primary hover:underline"
            >
              <span>Read Devlog</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      `
      )
      .join("");
  }

  async function loadBlog() {
    try {
      const res = await fetch("/api/blog");
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts) && data.posts.length > 0) {
          renderPosts(data.posts);
          return;
        }
      }
    } catch {
      // Fallback below
    }

    renderPosts(DEFAULT_POSTS);
  }

  loadBlog();
</script>
