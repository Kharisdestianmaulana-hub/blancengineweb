---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Contributors from "../components/Contributors.astro";
import Footer from "../components/Footer.astro";
import { History, GitPullRequest, CheckCircle2, ExternalLink } from "lucide-astro";

const fallbackReleases = [
  {
    version: "0.1.0",
    date: "2026-11-14",
    status: "Initial Release",
    groups: [
      {
        crate: "blanc_core",
        items: [
          "Project manifest (.blanc), scene (.bscene), screenplay parser (.bst), and StoryFlowGraph serialization.",
          "Encrypted .bpack asset archive writer and reader.",
          "Multi-language localization manifest (locales/manifest.json), string tables, and RFC-4180 CSV export/import.",
          "Windows executable .ico resource embedding and standalone installer payload packaging.",
          "Customizable RuntimeUiConfig and design tokens.",
        ],
      },
      {
        crate: "blanc_editor",
        items: [
          "Project Welcome screen, Overview, Asset Manager, Story Setup converter, Scene Editor, Story Flow canvas, UI Designer with live preview, Localization, Settings, and Export pipeline.",
          "Background asynchronous export with sticky progress bar, custom wizard sidebar artwork, and per-language Terms & Privacy Policy editor.",
        ],
      },
      {
        crate: "blanc_runtime",
        items: [
          "Stage rendering, typewriter dialogue reveal, character positioning, screen effects (FadeIn, FadeOut, FlashWhite, Shake), and rodio BGM/SFX playback.",
          "Save/Load slots with scene thumbnails, Quick Save (F5), Quick Load (F9), and Dialogue History (B).",
          "Auto-Play (A) with configurable delay and Skip (S) with Read Only (persistent read_history.json) and All Text modes.",
          "Dynamic Language selector in Settings, installer language auto-sync on first launch, Windows CJK font loading, and gamepad (gilrs) navigation.",
        ],
      },
      {
        crate: "blanc_installer",
        items: [
          "Standalone Windows Setup Wizard with 6-language UI (en, id, ja, es, zh, ko), progress bar, Start Menu & Desktop shortcuts, and clean per-game Uninstall <Game>.exe.",
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Changelog: Blanc Engine Releases & Contributing"
  description="Live release notes from GitHub Releases, version history, and contribution guide for Blanc Engine."
  ogImage="/screenshots/SS_OVERVIEW.png"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Changelog", path: "/changelog/" }]}
>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="flex flex-col justify-between gap-4 border-b border-border-default pb-6 sm:flex-row sm:items-end">
      <div>
        <div class="flex items-center gap-2">
          <History class="h-4 w-4 text-accent-primary" />
          <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
            Release History
          </span>
        </div>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
          Changelog & Contributing
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
          Synced with GitHub Releases, following Keep a Changelog and Semantic Versioning.
        </p>
      </div>

      <a
        href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3 text-xs font-medium text-text-primary transition-colors hover:bg-surface-hover"
      >
        <span>GitHub Releases</span>
        <ExternalLink class="h-3.5 w-3.5 text-text-muted" />
      </a>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-12">
      <!-- Left: Live GitHub Releases Changelog + Static Fallback -->
      <div class="min-w-0 space-y-6 lg:col-span-8">
        <div id="changelog-releases" class="space-y-6">
          <div class="rounded-lg border border-border-default bg-surface-primary p-5 text-sm text-text-secondary">
            Loading release notes from GitHub...
          </div>
        </div>

        <div id="changelog-fallback" class="hidden space-y-6">
          {
            fallbackReleases.map((rel) => (
              <article class="rounded-lg border border-border-default bg-surface-primary">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border-default bg-bg-secondary px-5 py-3.5">
                  <div class="flex items-center gap-2.5">
                    <span class="font-mono text-base font-bold text-text-primary">v{rel.version}</span>
                    <span class="rounded border border-status-success bg-bg-primary px-2 py-0.5 font-mono text-[11px] font-medium text-status-success">
                      {rel.status}
                    </span>
                  </div>
                  <span class="font-mono text-xs text-text-muted">{rel.date}</span>
                </div>

                <div class="space-y-5 p-5">
                  {
                    rel.groups.map((group) => (
                      <div>
                        <h2 class="inline-block rounded border border-border-subtle bg-bg-secondary px-2 py-0.5 font-mono text-xs font-semibold text-accent-primary">
                          {group.crate}
                        </h2>
                        <ul class="mt-2.5 space-y-2">
                          {
                            group.items.map((item) => (
                              <li class="flex items-start gap-2 text-sm leading-relaxed text-text-secondary">
                                <CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0 text-status-success" />
                                <span>{item}</span>
                              </li>
                            ))
                          }
                        </ul>
                      </div>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Right: Contributing Guide -->
      <aside class="min-w-0 space-y-5 lg:col-span-4">
        <div class="rounded-lg border border-border-default bg-surface-primary p-5">
          <div class="flex items-center gap-2">
            <GitPullRequest class="h-4 w-4 text-accent-primary" />
            <h2 class="text-base font-semibold text-text-primary">Contributing</h2>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-text-secondary sm:text-sm">
            Every contribution, from bug reports and documentation improvements to new engine features, is welcome.
          </p>

          <div class="mt-4 space-y-3 text-xs text-text-secondary">
            <div class="rounded border border-border-subtle bg-bg-secondary p-3">
              <p class="font-semibold text-text-primary">1. Build & Test Workspace</p>
              <pre class="mt-2 overflow-x-auto font-mono text-[11px] text-text-primary"><code>cargo build --workspace
cargo test --workspace</code></pre>
            </div>
            <div class="rounded border border-border-subtle bg-bg-secondary p-3">
              <p class="font-semibold text-text-primary">2. Format & Lint</p>
              <pre class="mt-2 overflow-x-auto font-mono text-[11px] text-text-primary"><code>cargo fmt
cargo clippy --workspace</code></pre>
            </div>
          </div>

          <a
            href="/feedback"
            class="mt-4 inline-flex w-full items-center justify-center rounded-md border border-border-default bg-bg-secondary px-3 py-2 text-xs font-medium text-text-primary transition-colors hover:bg-surface-hover"
          >
            Report Bug or Request Feature
          </a>
        </div>
      </aside>
    </div>
  </main>

  <Contributors />

  <Footer />
</BaseLayout>

<script>
  interface GitHubRelease {
    tag_name: string;
    name: string;
    prerelease: boolean;
    draft: boolean;
    published_at: string;
    html_url: string;
    body: string;
  }

  const RELEASES_API = "https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases";
  const container = document.getElementById("changelog-releases");
  const fallback = document.getElementById("changelog-fallback");

  function esc(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatDate(iso: string): string {
    if (!iso) return "";
    return new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  function renderMarkdown(md: string): string {
    if (!md) return '<p class="text-sm text-text-muted">No release notes provided.</p>';
    const lines = md.replace(/\r\n/g, "\n").split("\n");
    const out: string[] = [];
    let inList = false;

    const inlineFormat = (text: string) => {
      let s = esc(text);
      s = s.replace(/`([^`]+)`/g, '<code class="rounded border border-border-subtle bg-bg-primary px-1.5 py-0.5 font-mono text-xs text-text-primary">$1</code>');
      s = s.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-text-primary">$1</strong>');
      s = s.replace(/\*([^*]+)\*/g, '<em class="italic">$1</em>');
      return s;
    };

    for (const rawLine of lines) {
      const line = rawLine.trim();
      if (!line) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        continue;
      }
      if (/^---+$/.test(line)) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        out.push('<hr class="my-4 border-border-subtle" />');
        continue;
      }
      if (line.startsWith("### ")) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        out.push(`<h3 class="mt-4 mb-2 inline-block rounded border border-border-subtle bg-bg-secondary px-2 py-0.5 font-mono text-xs font-semibold text-accent-primary">${inlineFormat(line.slice(4))}</h3>`);
        continue;
      }
      if (line.startsWith("## ") || line.startsWith("# ")) {
        if (inList) {
          out.push("</ul>");
          inList = false;
        }
        const content = line.replace(/^#+\s+/, "");
        out.push(`<h2 class="mt-2 mb-2 text-base font-semibold text-text-primary">${inlineFormat(content)}</h2>`);
        continue;
      }
      if (line.startsWith("- ") || line.startsWith("* ")) {
        if (!inList) {
          out.push('<ul class="my-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-text-secondary">');
          inList = true;
        }
        out.push(`<li>${inlineFormat(line.slice(2))}</li>`);
        continue;
      }
      if (inList) {
        out.push("</ul>");
        inList = false;
      }
      out.push(`<p class="my-2 text-sm leading-relaxed text-text-secondary">${inlineFormat(line)}</p>`);
    }

    if (inList) out.push("</ul>");
    return out.join("");
  }

  async function loadChangelog() {
    if (!container) return;

    try {
      let data: GitHubRelease[] = [];

      try {
        const statsRes = await fetch("/api/github-stats");
        if (statsRes.ok) {
          const stats = await statsRes.json();
          if (Array.isArray(stats.releases) && stats.releases.length > 0) {
            data = stats.releases;
          }
        }
      } catch {
        // Fallback to direct GitHub API in local dev
      }

      if (data.length === 0) {
        const res = await fetch(RELEASES_API, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        data = await res.json();
      }

      const releases = data.filter((r) => !r.draft);

      if (releases.length === 0) {
        container.classList.add("hidden");
        fallback?.classList.remove("hidden");
        return;
      }

      container.innerHTML = releases
        .map((rel, idx) => {
          const badgeClass = rel.prerelease
            ? "border-status-warning text-status-warning"
            : "border-status-success text-status-success";
          const badgeText = rel.prerelease ? "Beta / Preview" : "Stable";

          return `
            <article class="rounded-lg border border-border-default bg-surface-primary">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border-default bg-bg-secondary px-5 py-3.5">
                <div class="flex flex-wrap items-center gap-2.5">
                  ${
                    idx === 0
                      ? '<span class="rounded border border-accent-primary bg-accent-subtle px-2 py-0.5 font-mono text-[11px] font-semibold text-accent-primary">Latest</span>'
                      : ""
                  }
                  <span class="font-mono text-base font-bold text-text-primary">${esc(rel.tag_name)}</span>
                  <span class="rounded border ${badgeClass} bg-bg-primary px-2 py-0.5 font-mono text-[11px] font-medium">
                    ${badgeText}
                  </span>
                </div>
                <div class="flex items-center gap-3 font-mono text-xs text-text-muted">
                  <span>${formatDate(rel.published_at)}</span>
                  <a href="${esc(rel.html_url)}" target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">
                    GitHub
                  </a>
                </div>
              </div>

              <div class="p-5">
                ${renderMarkdown(rel.body)}
              </div>
            </article>
          `;
        })
        .join("");
    } catch {
      container.classList.add("hidden");
      fallback?.classList.remove("hidden");
    }
  }

  loadChangelog();
</script>
