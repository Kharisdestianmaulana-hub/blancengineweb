---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { ArrowLeft, Calendar, User, Tag } from "lucide-astro";
---

<BaseLayout
  title="Article | Blanc Engine Blog"
  description="Read official devlog and release announcements from the Blanc Engine core team."
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }, { name: "Post", path: "#" }]}
>
  <Navbar />

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Back to blog -->
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-medium text-text-secondary hover:text-text-primary transition-colors mb-6"
    >
      <ArrowLeft class="h-3.5 w-3.5" />
      <span>Back to all posts</span>
    </a>

    <!-- Loading State -->
    <div id="post-loading" class="rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
      Loading article...
    </div>

    <!-- Article Content -->
    <article id="post-article" class="hidden space-y-8">
      <!-- Article Header -->
      <div class="space-y-3 border-b border-border-default pb-6">
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-text-muted">
          <span id="post-tags" class="rounded border border-border-default bg-surface-elevated px-2.5 py-0.5 text-xs font-medium text-accent-primary">
            Devlog
          </span>
          <span class="flex items-center gap-1.5">
            <Calendar class="h-3.5 w-3.5" />
            <span id="post-date">-</span>
          </span>
          <span class="flex items-center gap-1.5">
            <User class="h-3.5 w-3.5" />
            <span id="post-author">Blanc Team</span>
          </span>
        </div>

        <h1 id="post-title" class="text-2xl font-bold tracking-tight text-text-primary sm:text-3xl lg:text-4xl leading-tight">
          Article Title
        </h1>

        <p id="post-excerpt" class="text-base text-text-secondary leading-relaxed font-medium">
          Excerpt
        </p>
      </div>

      <!-- Hero Image -->
      <div id="post-cover-wrapper" class="overflow-hidden rounded-xl border border-border-default bg-bg-primary aspect-video w-full">
        <img id="post-cover" src="/screenshots/SS_OVERVIEW.png" alt="Article cover" class="h-full w-full object-cover" />
      </div>

      <!-- Post Body -->
      <div id="post-body" class="prose prose-invert max-w-none text-text-secondary leading-relaxed text-sm sm:text-base space-y-4">
      </div>

      <!-- Article Footer -->
      <div class="mt-12 rounded-xl border border-border-default bg-surface-primary p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h3 class="text-sm font-semibold text-text-primary">Ready to create your visual novel?</h3>
          <p class="text-xs text-text-secondary mt-1">Download Blanc Engine and start building with our screenplay editor.</p>
        </div>
        <a
          href="/download"
          class="inline-flex h-9 items-center justify-center rounded-md bg-accent-primary px-4 text-xs font-semibold text-text-on-accent hover:bg-accent-hover transition-colors shrink-0"
        >
          Download Free
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  function formatMarkdown(text: string): string {
    if (!text) return "";

    // Escape HTML basic
    let html = text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");

    // Headings
    html = html.replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-text-primary mt-6 mb-2">$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-text-primary mt-8 mb-3 pb-2 border-b border-border-subtle">$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold text-text-primary mt-10 mb-4">$1</h1>');

    // Bold & Italic
    html = html.replace(/\*\*(.*?)\*\*/gim, '<strong class="text-text-primary font-semibold">$1</strong>');
    html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');

    // Lists
    html = html.replace(/^\- (.*$)/gim, '<li class="ml-4 list-disc text-text-secondary">$1</li>');

    // Line breaks into paragraphs
    const paragraphs = html.split(/\n\n+/);
    html = paragraphs
      .map((p) => {
        if (p.startsWith("<h") || p.startsWith("<li")) return p;
        return `<p class="leading-relaxed text-text-secondary">${p}</p>`;
      })
      .join("\n");

    return html;
  }

  async function loadPost() {
    const slug = new URLSearchParams(window.location.search).get("slug") || "welcome-to-blanc-engine";
    const loadingEl = document.getElementById("post-loading");
    const articleEl = document.getElementById("post-article");

    let post: any = null;

    try {
      const res = await fetch(`/api/blog?slug=${encodeURIComponent(slug)}`);
      if (res.ok) {
        const data = await res.json();
        if (data.post) post = data.post;
      }
    } catch {
      // Fallback
    }

    if (!post && slug === "welcome-to-blanc-engine") {
      post = {
        title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
        excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
        author: "Blanc Core Team",
        tags: "Announcements, Devlog",
        published_at: "2026-11-25",
        cover_url: "/screenshots/SS_OVERVIEW.png",
        content: "Welcome to the official Blanc Engine devlog! Blanc Engine was created to make visual novel game development fast, visual, and accessible without writing complex script code.\n\n### What Makes Blanc Engine Unique?\n\n- **Screenplay-to-Scene Workflow**: Write character dialogues in a screenplay format, and scenes generate automatically.\n- **Interactive Story Flow**: Visual node canvas connecting scenes, branch choices, and multi-route endings.\n- **Native Packaging**: Package portable builds and standalone installers with one click.\n\nStay tuned for our upcoming v0.2.0 updates featuring the Free-Form UI Canvas Studio and Variable Manager!",
      };
    }

    if (loadingEl) loadingEl.classList.add("hidden");

    if (!post) {
      if (articleEl) {
        articleEl.innerHTML = `
          <div class="rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
            Article not found. <a href="/blog" class="text-accent-primary hover:underline">Return to Blog</a>
          </div>
        `;
        articleEl.classList.remove("hidden");
      }
      return;
    }

    document.title = `${post.title} | Blanc Engine Blog`;

    const titleEl = document.getElementById("post-title");
    const excerptEl = document.getElementById("post-excerpt");
    const authorEl = document.getElementById("post-author");
    const dateEl = document.getElementById("post-date");
    const tagsEl = document.getElementById("post-tags");
    const coverEl = document.getElementById("post-cover") as HTMLImageElement | null;
    const coverWrap = document.getElementById("post-cover-wrapper");
    const bodyEl = document.getElementById("post-body");

    if (titleEl) titleEl.textContent = post.title;
    if (excerptEl) excerptEl.textContent = post.excerpt;
    if (authorEl) authorEl.textContent = post.author || "Blanc Team";
    if (dateEl) dateEl.textContent = (post.published_at || "").slice(0, 10);
    if (tagsEl) tagsEl.textContent = post.tags || "Devlog";

    if (coverEl && post.cover_url) {
      coverEl.src = post.cover_url;
      coverEl.alt = post.title;
    } else if (coverWrap) {
      coverWrap.classList.add("hidden");
    }

    if (bodyEl) {
      bodyEl.innerHTML = formatMarkdown(post.content);
    }

    if (articleEl) articleEl.classList.remove("hidden");
  }

  loadPost();
</script>
