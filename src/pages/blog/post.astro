---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { ArrowLeft, Calendar, User, Copy, Check, Share2, Sparkles } from "lucide-astro";
---

<BaseLayout
  title="Article | Blanc Engine Blog"
  description="Read official devlog and release announcements from the Blanc Engine core team."
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }, { name: "Post", path: "#" }]}
  canonicalUrl={null}
>
  <Navbar />

  <main class="w-full">
    <!-- Loading State -->
    <div id="post-loading" class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <div class="rounded-lg border border-border-default bg-surface-primary p-12 text-center text-sm text-text-secondary">
        Loading article...
      </div>
    </div>

    <!-- Article Not Found State -->
    <div id="post-not-found" class="hidden mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <div class="rounded-lg border border-border-default bg-surface-primary p-12 text-center">
        <h2 class="text-lg font-bold text-text-primary">Article Not Found</h2>
        <p class="mt-2 text-sm text-text-secondary">
          The requested devlog post could not be found or has been moved.
        </p>
        <a
          href="/blog"
          class="mt-6 inline-flex h-9 items-center gap-1.5 rounded bg-accent-primary px-4 text-xs font-semibold text-text-on-accent hover:bg-accent-hover transition-colors"
        >
          <ArrowLeft class="h-3.5 w-3.5" />
          <span>Return to Blog Catalog</span>
        </a>
      </div>
    </div>

    <!-- Article Content (Displayed when loaded) -->
    <article id="post-article" class="hidden w-full">
      
      <!-- Full-Width Cinematic Hero Header with Parallax Cover Background -->
      <header class="relative w-full overflow-hidden border-b border-border-default min-h-[440px] sm:min-h-[500px] lg:min-h-[560px] flex items-end">
        <!-- Background Cover Image -->
        <div
          id="post-cover-bg"
          class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat transition-all duration-700"
        ></div>

        <!-- Dark Gradient Overlays (Solid bottom to transparent top) -->
        <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-bg-primary/85 to-transparent/30"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-bg-primary/80 via-transparent to-bg-primary/40"></div>

        <!-- Hero Content Foreground -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 pb-10 pt-20 sm:pb-12 sm:pt-24">
          <!-- Back to Blog Button (Glassmorphism Pill) -->
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-black/60 px-3 py-1.5 text-xs font-medium text-white/90 backdrop-blur-md transition-colors hover:border-white/30 hover:bg-black/80 hover:text-white mb-6"
          >
            <ArrowLeft class="h-3.5 w-3.5" />
            <span>Back to all posts</span>
          </a>

          <!-- Badges & Metadata -->
          <div class="flex flex-wrap items-center gap-2.5">
            <span
              id="post-tags"
              class="rounded border border-border-default bg-surface-primary/80 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-text-primary backdrop-blur-sm"
            >
              Devlog
            </span>

            <span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted bg-black/40 px-2 py-0.5 rounded backdrop-blur-sm">
              <Calendar class="h-3.5 w-3.5 text-text-muted" />
              <span id="post-date">-</span>
            </span>

            <span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted bg-black/40 px-2 py-0.5 rounded backdrop-blur-sm">
              <User class="h-3.5 w-3.5 text-text-muted" />
              <span id="post-author">Blanc Core Team</span>
            </span>
          </div>

          <!-- Article Title -->
          <h1
            id="post-title"
            class="mt-3 text-3xl font-bold tracking-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] sm:text-4xl xl:text-5xl leading-tight max-w-4xl"
          >
            Article Title
          </h1>

          <!-- Article Excerpt (Subtitle) -->
          <p
            id="post-excerpt"
            class="mt-3 max-w-3xl text-sm sm:text-base text-text-secondary leading-relaxed font-normal"
          >
            Excerpt
          </p>

          <!-- Interactive Actions Bar -->
          <div class="mt-6 pt-5 border-t border-white/10 flex flex-wrap items-center gap-3">
            <button
              id="btn-copy-url"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-md border border-white/15 bg-black/50 px-3 py-1.5 text-xs font-semibold text-white/90 backdrop-blur-sm hover:bg-black/80 hover:border-white/30 hover:text-white transition-colors cursor-pointer"
            >
              <Copy id="copy-icon" class="h-3.5 w-3.5 text-text-muted" />
              <Check id="copied-icon" class="hidden h-3.5 w-3.5 text-status-success" />
              <span id="copy-label">Copy Link</span>
            </button>

            <a
              id="btn-share-x"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md border border-white/15 bg-black/50 px-3 py-1.5 text-xs font-semibold text-white/90 backdrop-blur-sm hover:bg-black/80 hover:border-white/30 hover:text-white transition-colors cursor-pointer"
            >
              <Share2 class="h-3.5 w-3.5 text-text-muted" />
              <span>Share to X</span>
            </a>
          </div>
        </div>
      </header>

      <!-- Main Reading Area (Centered, Clean Typography) -->
      <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
        <!-- Rendered Markdown Article Body -->
        <div
          id="post-body"
          class="prose prose-invert max-w-none text-text-secondary leading-relaxed text-sm sm:text-base space-y-6"
        ></div>

        <!-- Article Footer: CTA Banner -->
        <div class="mt-14 rounded-xl border border-border-default bg-surface-primary p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div>
            <div class="flex items-center gap-2">
              <Sparkles class="h-4 w-4 text-accent-primary" />
              <h3 class="text-base font-bold text-text-primary">Ready to create your visual novel?</h3>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary mt-1 max-w-xl">
              Download Blanc Engine free and build branching narrative story games with screenplay drafting and visual scene timelines.
            </p>
          </div>
          <a
            href="/download"
            class="inline-flex h-9 items-center justify-center rounded-md bg-accent-primary px-5 text-xs font-semibold text-text-on-accent hover:bg-accent-hover transition-colors shrink-0"
          >
            Download Free
          </a>
        </div>
      </div>

    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  function formatMarkdown(text: string): string {
    if (!text) return "";

    // Escape basic HTML
    let html = text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");

    // Code blocks (fenced ```)
    html = html.replace(/```([a-z0-9_-]*)\n([\s\S]*?)```/gim, (_, lang, code) => {
      return `<pre class="overflow-x-auto rounded-lg border border-border-default bg-bg-primary p-4 font-mono text-xs leading-relaxed text-text-primary my-4"><code>${code.trim()}</code></pre>`;
    });

    // Inline code (`...`)
    html = html.replace(/`([^`]+)`/gim, '<code class="font-mono text-xs text-text-primary bg-bg-secondary px-1.5 py-0.5 rounded border border-border-subtle">$1</code>');

    // Headings
    html = html.replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-text-primary mt-6 mb-2 pt-2">$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-text-primary mt-8 mb-3 pb-2 border-b border-border-subtle">$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold text-text-primary mt-10 mb-4">$1</h1>');

    // Blockquotes
    html = html.replace(/^> (.*$)/gim, '<blockquote class="border-l-2 border-border-default pl-4 my-4 italic text-text-muted">$1</blockquote>');

    // Bold & Italic
    html = html.replace(/\*\*(.*?)\*\*/gim, '<strong class="text-text-primary font-semibold">$1</strong>');
    html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');

    // Unordered lists
    html = html.replace(/^[-*] (.*$)/gim, '<li class="ml-4 list-disc text-text-secondary my-1 leading-relaxed">$1</li>');

    // Paragraphs
    const paragraphs = html.split(/\n\n+/);
    html = paragraphs
      .map((p) => {
        const trimmed = p.trim();
        if (
          trimmed.startsWith("<h") ||
          trimmed.startsWith("<pre") ||
          trimmed.startsWith("<blockquote") ||
          trimmed.startsWith("<li")
        ) {
          return trimmed;
        }
        return `<p class="leading-relaxed text-text-secondary">${trimmed}</p>`;
      })
      .join("\n");

    return html;
  }

  const FALLBACK_POSTS: Record<string, any> = {
    "blanc-engine-v020-devlog-free-form-ui-canvas-studio-custom-ui-skins-and-visual-logic": {
      title: "Blanc Engine v0.2.0 Devlog: Free-Form UI Canvas Studio, Custom UI Skins, and Visual Logic",
      excerpt: "A deep dive into Blanc Engine v0.2.0: bringing a 3-panel Godot/Unity-style Free-Form UI Designer, custom PNG skins for every widget, Visual Variables & Conditions, and cross-platform expansion.",
      author: "Blanc Core Team",
      tags: "Devlog, v0.2.0, UI Designer, Major Update",
      published_at: "2026-11-25",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      content: `With \`v0.1.x\`, creators could build and ship visual novels quickly using built-in templates. For **Blanc Engine v0.2.0**, our theme is simple: **"True Creative Freedom, Zero Code."**

We are upgrading Blanc Engine from a template-based tool into a full **free-form visual novel studio**: giving you pixel-accurate UI control and branching story logic without writing a single line of code.

### 1. Free-Form UI Designer (3-Panel Canvas Studio)
Instead of being locked into fixed layouts, the new **UI Designer** works like Unity Canvas / Godot Control Nodes:
- **Left - Scene Hierarchy:** Manage parent-child widget trees across all 8 system screens (\`Main Menu\`, \`Dialogue HUD\`, \`Pause Menu\`, \`Settings\`, \`Save/Load\`, \`History\`, \`Credits\`, \`Game Over\`) with visibility, lock, and Z-order controls.
- **Center - Interactive 1920x1080 Viewport:** Drag-and-drop widgets freely, resize with 8-point gizmo handles (\`Shift\` for aspect ratio, \`Alt\` for center scaling), use smart center snap guides, auto-arrange \`VBox\`/\`HBox\` containers, and test buttons directly with **Live Test** mode.
- **Right - Context-Aware Inspector & Custom Skins:** Customize **every** widget with your own PNG artwork and \`.ttf\`/\`.otf\` fonts: including **Dialogue Box**, **Speaker Nameplate**, **Advance Prompt Icon**, **Choice Button Group**, **Save/Load Slot Cards**, **Sliders** (track, fill, handle), **Toggle Switches**, **Panels**, **9-Slice Margins**, and **4 Button States** (*Normal*, *Hover*, *Pressed*, *Disabled*).

### 2. Visual Logic & Variable Manager
Tell complex branching stories with memory:
- **Variable Manager:** Define global \`Boolean\` flags, \`Number\` stats/affection counters, and \`String\` values.
- **Modify Variable & Condition Nodes:** Update variables inside scenes and route players through visual \`If / Else\` branches (\`AND\` / \`OR\`) in Story Flow, plus lock or hide dialogue choices based on requirements.

### 3. Dynamic Dialogue, 2D Camera & Extras (Roadmap)
- **Inline Text Effects:** Typewriter pauses (\`{w=0.5}\`), speed overrides, \`{shake}\`, \`{wave}\`, and inline \`{color}\` formatting via a visual editor toolbar.
- **Dynamic Camera & VFX:** Smooth camera zoom, pan, screen shake, and ambient color tints.
- **CG Gallery & Music Room:** Persistent unlockable CGs and BGM tracks (\`persistent_data.bdata\`) alongside **macOS (\`.app\` / \`.dmg\`)** export support.

We are actively building and polishing \`v0.2.0\`: thank you for supporting **Blanc Engine**!`,
    },
    "blanc-engine-v011-security-hardening-atomic-saves-and-runtime-stability": {
      title: "Blanc Engine v0.1.1: Security Hardening, Atomic Saves, and Runtime Stability",
      excerpt: "A focused maintenance release introducing atomic file writes, path-traversal protection, Story Flow cycle guards, and smoother keyboard/gamepad navigation.",
      author: "Blanc Core Team",
      tags: "Release, v0.1.1, Patch Notes",
      published_at: "2026-11-25",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      content: `**Blanc Engine v0.1.1** (November 20, 2026) is now available! This maintenance update focuses on data safety, runtime stability, and polish across the Editor, Runtime, and Installer.

### What's New & Improved

#### Core Data Safety (\`blanc_core\`)
- **Atomic File Writes:** \`.blanc\`, \`.bscene\`, \`.bgraph\`, \`.bconfig\`, localization files, and runtime saves now write via temporary files + atomic rename to prevent corruption during unexpected shutdowns.
- **Archive & Path Hardening:** Added \`safe_join_relative\` path-traversal protection, bounds validation when reading \`.bpack\` archives, and directory safety guards (\`validate_project_folder_for_deletion\`) when deleting projects.

#### Runtime Fixes & Navigation (\`blanc_runtime\`)
- **Settings Tab Navigation:** Full keyboard and gamepad support for switching Settings tabs (\`Audio\`, \`Gameplay\`, \`System\`) using \`Left\`/\`Right\`, \`Tab\`, \`Q\`, and \`E\`.
- **Cycle Protection:** Added \`MAX_SCENE_TRANSITION_DEPTH\` to prevent infinite loops or freezes on cyclic Story Flow links.
- **Save Restoration Fixes:** Improved \`Load Save Game\` (\`restore_to_point\`) so intermediate \`PlayBgm\` blocks don't stack in a single frame, and unified \`HideCharacter\` matching.

#### Editor & Installer Polish
- **Safe Project Deletion:** Hub deletion now lets you choose between **Remove from Hub Only** or **Delete Project & Folder**.
- **Cleaner Exports:** \`Builds/\` and \`Backups/\` folders are automatically excluded from \`game.bpack\` payloads.
- **Tracked Uninstallation:** The installer now records installed files in \`.blanc_uninstall.json\` so uninstalling only removes game-owned files.`,
    },
    "blanc-engine-v010-released-write-design-and-ship-visual-novels-with-zero-code": {
      title: "Blanc Engine v0.1.0 Released: Write, Design, and Ship Visual Novels With Zero Code",
      excerpt: "Our first public release! Blanc Engine v0.1.0 brings the complete no-code pipeline from screenplay writing and Story Flow graphs to encrypted .bpack exports and standalone Windows installers.",
      author: "Blanc Core Team",
      tags: "Release, v0.1.0, Announcements",
      published_at: "2026-11-25",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      content: `We are excited to announce the first official release of **Blanc Engine v0.1.0** (November 16, 2026)!

Version \`0.1.0\` establishes the complete end-to-end no-code workflow for creating, previewing, localizing, and shipping commercial-ready visual novels.

### Key Highlights in v0.1.0

#### 1. Complete Visual Studio (\`blanc_editor\`)
- **Project Hub & Overview:** Manage projects, browse built-in **Learn & Docs** guides, and track readiness with a real-time project checklist.
- **Asset Manager:** Import backgrounds, character sprites, BGM, SFX, and UI artwork with category filtering and one-click **Relink Missing Asset**.
- **Story Setup & Scene Editor:** Write screenplays in \`.bst\` format and convert them into modular Action Blocks (\`ShowCharacter\`, \`Dialogue\`, \`Choice\`, \`PlayBgm\`, \`FadeIn\`/\`FadeOut\`, \`FlashWhite\`, \`Shake\`).
- **Story Flow Graph:** Connect scenes and branching choices visually on a node-based canvas, backed by a **Project Validator** that catches missing assets or broken links before you play or export.
- **Safety & QoL:** Includes \`Ctrl+S\` save guard, periodic Auto-Save (\`1/3/5/10 min\`), \`Ctrl+Z\` / \`Ctrl+Y\` Undo/Redo, and instant **Play Preview**.

#### 2. Native Runtime Player (\`blanc_runtime\`)
- **Smooth Stage & Audio:** Typewriter dialogue reveal, non-speaker sprite dimming, screen effects, and \`rodio\` BGM/SFX playback.
- **Player Features Out-of-the-Box:** Save/Load slots with scene thumbnails, Quick Save (\`F5\`), Quick Load (\`F9\`), Dialogue History (\`B\`), Auto-Play (\`A\`), Skip (\`S\` with Read-Only & All-Text modes), plus dedicated **Credits Roll** and **Game Over** screens.
- **Controls:** Full mouse, keyboard, and gamepad (\`gilrs\`) navigation, plus Windows CJK font support.

#### 3. Multi-Language Localization & Standalone Installer
- **Localization System:** Manage string tables per language with RFC-4180 CSV export/import and dynamic in-game language switching.
- **Encrypted Export & Setup Wizard (\`blanc_installer\`):** Pack assets into encrypted \`.bpack\` archives and generate a standalone Windows Setup Wizard supporting 6 languages (\`en\`, \`id\`, \`ja\`, \`es\`, \`zh\`, \`ko\`), Start Menu/Desktop shortcuts, custom icons, and an uninstaller.`,
    },
    "welcome-to-blanc-engine": {
      title: "Welcome to Blanc Engine: The Next-Gen No-Code Visual Novel Engine",
      excerpt: "Introducing Blanc Engine, a modern visual screenplay and timeline editor designed for indie visual novel creators and storytellers.",
      author: "Blanc Core Team",
      tags: "Announcements, Devlog",
      published_at: "2026-11-25",
      cover_url: "/screenshots/SS_OVERVIEW.png",
      content: `Welcome to the official Blanc Engine devlog! Blanc Engine was created to make visual novel game development fast, visual, and accessible without writing complex script code.

### What Makes Blanc Engine Unique?

- **Screenplay-to-Scene Workflow**: Write character dialogues in a screenplay format, and scenes generate automatically.
- **Interactive Story Flow**: Visual node canvas connecting scenes, branch choices, and multi-route endings.
- **Native Packaging**: Package portable builds and standalone installers with one click.

Stay tuned for our upcoming v0.2.0 updates featuring the Free-Form UI Canvas Studio and Variable Manager!`,
    },
  };

  async function loadPost() {
    const slug = new URLSearchParams(window.location.search).get("slug") || "welcome-to-blanc-engine";
    const loadingEl = document.getElementById("post-loading");
    const notFoundEl = document.getElementById("post-not-found");
    const articleEl = document.getElementById("post-article");

    // Canonical link dynamic update for SEO and social indexing
    let canonical = document.querySelector<HTMLLinkElement>("link[rel='canonical']");
    if (!canonical) {
      canonical = document.createElement("link");
      canonical.rel = "canonical";
      document.head.appendChild(canonical);
    }
    canonical.href = window.location.href;

    let post: any = null;

    try {
      const res = await fetch(`/api/blog?slug=${encodeURIComponent(slug)}`);
      if (res.ok) {
        const data = await res.json();
        if (data.post) post = data.post;
      }
    } catch {
      // Fallback below
    }

    if (!post && FALLBACK_POSTS[slug]) {
      post = FALLBACK_POSTS[slug];
    }

    if (loadingEl) loadingEl.classList.add("hidden");

    if (!post) {
      if (notFoundEl) notFoundEl.classList.remove("hidden");
      return;
    }

    document.title = `${post.title} | Blanc Engine Blog`;

    const titleEl = document.getElementById("post-title");
    const excerptEl = document.getElementById("post-excerpt");
    const authorEl = document.getElementById("post-author");
    const dateEl = document.getElementById("post-date");
    const tagsEl = document.getElementById("post-tags");
    const coverBgEl = document.getElementById("post-cover-bg");
    const bodyEl = document.getElementById("post-body");

    if (titleEl) titleEl.textContent = post.title;
    if (excerptEl) excerptEl.textContent = post.excerpt;
    if (authorEl) authorEl.textContent = post.author || "Blanc Core Team";
    if (dateEl) dateEl.textContent = (post.published_at || "").slice(0, 10);
    if (tagsEl) tagsEl.textContent = post.tags || "Devlog";

    const coverUrl = post.cover_url || "/screenshots/SS_OVERVIEW.png";
    if (coverBgEl) {
      coverBgEl.style.backgroundImage = `url('${coverUrl}')`;
    }

    if (bodyEl) {
      bodyEl.innerHTML = formatMarkdown(post.content);
    }

    // Share & Copy Link Setup
    const btnCopy = document.getElementById("btn-copy-url");
    const copyIcon = document.getElementById("copy-icon");
    const copiedIcon = document.getElementById("copied-icon");
    const copyLabel = document.getElementById("copy-label");
    const btnShareX = document.getElementById("btn-share-x") as HTMLAnchorElement | null;

    if (btnCopy) {
      btnCopy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyIcon?.classList.add("hidden");
          copiedIcon?.classList.remove("hidden");
          if (copyLabel) copyLabel.textContent = "Copied!";
          setTimeout(() => {
            copyIcon?.classList.remove("hidden");
            copiedIcon?.classList.add("hidden");
            if (copyLabel) copyLabel.textContent = "Copy Link";
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    if (btnShareX) {
      const shareText = encodeURIComponent(`${post.title} | Blanc Engine`);
      const shareUrl = encodeURIComponent(window.location.href);
      btnShareX.href = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
    }

    if (articleEl) articleEl.classList.remove("hidden");
  }

  loadPost();
</script>
