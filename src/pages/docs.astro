---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { BookOpen, ArrowRight } from "lucide-astro";

const sections = [
  { id: "getting-started", title: "1. Project & Assets" },
  { id: "story-setup", title: "2. Story Setup Syntax" },
  { id: "scenes-flow", title: "3. Scene Editor & Story Flow" },
  { id: "ui-designer", title: "4. UI Designer" },
  { id: "localization", title: "5. Multi-Language & CSV" },
  { id: "export", title: "6. Exporting & Installer" },
  { id: "shortcuts", title: "7. Runtime Shortcuts" },
];
---

<BaseLayout
  title="Documentation: Blanc Engine User Guide"
  description="Complete user guide for creating, localizing, and distributing visual novels with Blanc Engine."
>
  <Navbar />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Page Header -->
    <div class="border-b border-border-default pb-6">
      <div class="flex items-center gap-2">
        <BookOpen class="h-4 w-4 text-accent-primary" />
        <span class="font-mono text-xs font-medium uppercase tracking-wider text-accent-primary">
          User Guide
        </span>
      </div>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-text-primary sm:text-3xl">
        Blanc Engine Documentation
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
        Learn the complete no-code workflow from screenplay drafting to packaging a standalone Windows installer.
      </p>
    </div>

    <!-- 2-Pane Documentation Layout -->
    <div class="mt-8 grid gap-8 lg:grid-cols-12">
      <!-- Left Sidebar TOC -->
      <aside class="lg:col-span-3">
        <div class="sticky top-24 rounded-lg border border-border-default bg-bg-secondary p-4">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-text-muted">
            Contents
          </p>
          <nav class="mt-3 flex flex-col gap-1" aria-label="Documentation sections">
            {
              sections.map((sec) => (
                <a
                  href={`#${sec.id}`}
                  class="rounded-md px-2.5 py-1.5 text-sm text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
                >
                  {sec.title}
                </a>
              ))
            }
          </nav>

          <div class="mt-5 border-t border-border-subtle pt-4">
            <a
              href="/download"
              class="inline-flex w-full items-center justify-center gap-1.5 rounded-md bg-accent-primary px-3 py-2 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover"
            >
              <span>Download Blanc Engine</span>
              <ArrowRight class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </aside>

      <!-- Right Content Area -->
      <div class="space-y-8 lg:col-span-9">
        <section id="getting-started" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">1. Creating a Project & Importing Assets</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            Launch <code class="rounded border border-border-subtle bg-bg-primary px-1.5 py-0.5 font-mono text-xs text-text-primary">blanc_editor</code> (or run <code class="rounded border border-border-subtle bg-bg-primary px-1.5 py-0.5 font-mono text-xs text-text-primary">cargo run -p blanc_editor</code> from source), create a new project or open an existing <code class="font-mono text-xs text-accent-primary">.blanc</code> manifest, and organize your media in the <strong>Asset Manager</strong>:
          </p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="rounded-md border border-border-subtle bg-bg-secondary p-3.5">
              <p class="text-xs font-semibold text-text-primary">Backgrounds</p>
              <p class="mt-1 font-mono text-xs text-text-muted">.png, .jpg, .webp</p>
            </div>
            <div class="rounded-md border border-border-subtle bg-bg-secondary p-3.5">
              <p class="text-xs font-semibold text-text-primary">Characters</p>
              <p class="mt-1 font-mono text-xs text-text-muted">Sprites & expression variants</p>
            </div>
            <div class="rounded-md border border-border-subtle bg-bg-secondary p-3.5">
              <p class="text-xs font-semibold text-text-primary">Audio</p>
              <p class="mt-1 font-mono text-xs text-text-muted">BGM, SFX, and Voice tracks</p>
            </div>
            <div class="rounded-md border border-border-subtle bg-bg-secondary p-3.5">
              <p class="text-xs font-semibold text-text-primary">UI & Fonts</p>
              <p class="mt-1 font-mono text-xs text-text-muted">Custom panels, buttons, .ttf/.otf</p>
            </div>
          </div>
        </section>

        <section id="story-setup" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">2. Writing in Story Setup</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            In <strong>Story Setup</strong>, draft your script using Blanc Engine's screenplay syntax, then click <strong>Convert to Scenes</strong> to generate <code class="font-mono text-xs text-accent-primary">.bscene</code> files automatically.
          </p>
          <pre class="mt-4 overflow-x-auto rounded-md border border-border-subtle bg-bg-primary p-4 font-mono text-xs leading-relaxed text-text-primary"><code>[Scene: Classroom_Afternoon]
[BGM: peaceful_day]

Alice (Happy): "Hello! Welcome to Blanc Engine."
Narrator: The afternoon sun streamed through the classroom windows.

[Choice: What do you want to do?]
- Go to the rooftop -> Rooftop_Scene
- Stay in the classroom -> Classroom_Evening</code></pre>
        </section>

        <section id="scenes-flow" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">3. Editing Scenes & Story Flow</h2>
          <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-text-secondary">
            <li class="rounded-md border border-border-subtle bg-bg-secondary p-3.5">
              <strong class="text-text-primary">Scene Editor:</strong> Fine-tune vertical action blocks including backgrounds, character positioning and expressions, dialogue, narration, choices, wait timers, and screen effects (<code class="font-mono text-xs text-accent-primary">FadeIn</code>, <code class="font-mono text-xs text-accent-primary">FadeOut</code>, <code class="font-mono text-xs text-accent-primary">FlashWhite</code>, <code class="font-mono text-xs text-accent-primary">Shake</code>).
            </li>
            <li class="rounded-md border border-border-subtle bg-bg-secondary p-3.5">
              <strong class="text-text-primary">Story Flow:</strong> Visually wire <code class="font-mono text-xs text-text-primary">Main Menu</code>, <code class="font-mono text-xs text-text-primary">Scene</code> nodes, <code class="font-mono text-xs text-text-primary">Choice</code> pins, <code class="font-mono text-xs text-text-primary">Pause</code>, <code class="font-mono text-xs text-text-primary">Settings</code>, and <code class="font-mono text-xs text-text-primary">Ending</code> nodes on an interactive canvas.
            </li>
          </ul>
        </section>

        <section id="ui-designer" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">4. Customizing UI (UI Designer)</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            Use <strong>UI Designer</strong> with live preview to customize the <strong>Title Screen</strong> (logo, background, button layout and textures), <strong>Gameplay HUD</strong> (dialogue box, nameplate, Q.Save, Q.Load, Auto, Skip, History, Hide UI, Menu), and <strong>Pause / Settings / Save-Load / Backlog</strong> screens.
          </p>
        </section>

        <section id="localization" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">5. Multi-Language Support (Localization)</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-text-secondary">
            <li>Open the <strong>Localization</strong> tab and confirm your <strong>Source / Default Language</strong> (such as <code class="font-mono text-xs text-text-primary">en</code> or <code class="font-mono text-xs text-text-primary">id</code>).</li>
            <li>Under <strong>Add Language</strong>, enter a language code (e.g., <code class="font-mono text-xs text-text-primary">ja</code>, <code class="font-mono text-xs text-text-primary">ko</code>, <code class="font-mono text-xs text-text-primary">fr</code>) and display name, then click <strong>+ Add Language</strong>.</li>
            <li>Click <strong>Sync Strings</strong> whenever you add new dialogues or choices in your scenes.</li>
            <li>Translate directly in the editor or use <strong>Export CSV / Import CSV</strong> (<code class="font-mono text-xs text-text-primary">key,context,source,translation</code>) to edit in Excel or Google Sheets.</li>
            <li>Players can switch languages anytime from <strong>Settings &rarr; Language</strong> in the exported game.</li>
          </ol>
        </section>

        <section id="export" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">6. Exporting & Distributing Your Game</h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="rounded-md border border-border-subtle bg-bg-secondary p-4">
              <h3 class="text-sm font-semibold text-text-primary">Portable Build</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-text-secondary">
                Outputs <code class="font-mono text-text-primary">YourGame.exe</code> alongside an encrypted <code class="font-mono text-accent-primary">game.bpack</code> archive (or loose <code class="font-mono text-text-primary">GameData/</code>).
              </p>
            </div>
            <div class="rounded-md border border-border-subtle bg-bg-secondary p-4">
              <h3 class="text-sm font-semibold text-text-primary">Windows Installer (Setup.exe)</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-text-secondary">
                Configure Version, Publisher, Welcome Message, per-language Terms & Privacy Policy, Sidebar Photo, and Desktop/Start Menu shortcuts. Includes a clean <code class="font-mono text-text-primary">Uninstall &lt;Game&gt;.exe</code>.
              </p>
            </div>
          </div>
        </section>

        <section id="shortcuts" class="scroll-mt-24 rounded-lg border border-border-default bg-surface-primary p-6">
          <h2 class="text-xl font-semibold text-text-primary">7. Runtime Keyboard Shortcuts</h2>
          <div class="mt-4 grid gap-2 sm:grid-cols-2">
            <div class="flex items-center justify-between rounded border border-border-subtle bg-bg-secondary px-3 py-2 text-xs">
              <span class="text-text-secondary">Advance dialogue / confirm</span>
              <kbd class="rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] text-text-primary">Space / Enter</kbd>
            </div>
            <div class="flex items-center justify-between rounded border border-border-subtle bg-bg-secondary px-3 py-2 text-xs">
              <span class="text-text-secondary">Toggle Auto-Play</span>
              <kbd class="rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] text-text-primary">A</kbd>
            </div>
            <div class="flex items-center justify-between rounded border border-border-subtle bg-bg-secondary px-3 py-2 text-xs">
              <span class="text-text-secondary">Toggle Skip</span>
              <kbd class="rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] text-text-primary">S</kbd>
            </div>
            <div class="flex items-center justify-between rounded border border-border-subtle bg-bg-secondary px-3 py-2 text-xs">
              <span class="text-text-secondary">Dialogue History (Backlog)</span>
              <kbd class="rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] text-text-primary">B</kbd>
            </div>
            <div class="flex items-center justify-between rounded border border-border-subtle bg-bg-secondary px-3 py-2 text-xs">
              <span class="text-text-secondary">Hide / show UI</span>
              <kbd class="rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] text-text-primary">H</kbd>
            </div>
            <div class="flex items-center justify-between rounded border border-border-subtle bg-bg-secondary px-3 py-2 text-xs">
              <span class="text-text-secondary">Quick Save / Quick Load</span>
              <kbd class="rounded border border-border-default bg-surface-primary px-1.5 py-0.5 font-mono text-[11px] text-text-primary">F5 / F9</kbd>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
