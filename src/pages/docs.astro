<script>
  // Active Navigation Highlight
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-doc-nav]");
  const sections = document.querySelectorAll<HTMLElement>("section[id], div[id='overview']");

  function setActiveNav(id: string) {
    navLinks.forEach((link) => {
      const active = link.getAttribute("data-doc-nav") === id;
      link.classList.toggle("bg-surface-elevated", active);
      link.classList.toggle("font-semibold", active);
      link.classList.toggle("text-text-primary", active);
      link.classList.toggle("text-text-secondary", !active);
    });

    // Update edit on GitHub button link
    const editBtn = document.getElementById("edit-github-btn") as HTMLAnchorElement | null;
    if (editBtn) {
      if (id === "getting-started") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/01-project-and-assets.md";
      else if (id === "story-setup") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/02-story-setup-syntax.md";
      else if (id === "scenes-flow") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/03-scene-editor-and-story-flow.md";
      else if (id === "ui-designer") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/04-ui-designer.md";
      else if (id === "localization") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/05-multi-language-and-csv.md";
      else if (id === "export") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/06-exporting-and-installer.md";
      else if (id === "shortcuts") editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/edit/main/docs/07-runtime-shortcuts.md";
      else editBtn.href = "https://github.com/Kharisdestianmaulana-hub/blancengineweb/tree/main/docs";
    }
  }

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveNav(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: "-20% 0px -65% 0px", threshold: 0 }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.getAttribute("data-doc-nav");
      if (id) setActiveNav(id);
    });
  });

  // Copy sample script button
  const copyBtn = document.getElementById("copy-sample-script");
  const samplePre = document.getElementById("sample-script-code");
  const copyIcon = document.getElementById("copy-icon");
  const copiedIcon = document.getElementById("copied-icon");
  const copyLabel = document.getElementById("copy-label");

  copyBtn?.addEventListener("click", async () => {
    const text = samplePre?.textContent?.trim() || "";
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyIcon?.classList.add("hidden");
      copiedIcon?.classList.remove("hidden");
      if (copyLabel) copyLabel.textContent = "Copied!";
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        copiedIcon?.classList.add("hidden");
        if (copyLabel) copyLabel.textContent = "Copy Sample Script";
      }, 2000);
    } catch {
      // Fallback
    }
  });

  // Live Docs Search
  const searchInput = document.getElementById("docs-search-input") as HTMLInputElement | null;
  searchInput?.addEventListener("input", () => {
    const q = (searchInput.value || "").toLowerCase().trim();
    navLinks.forEach((link) => {
      const text = (link.textContent || "").toLowerCase();
      const li = link.closest("li");
      if (li) {
        li.style.display = !q || text.includes(q) ? "block" : "none";
      }
    });
  });
</script>
