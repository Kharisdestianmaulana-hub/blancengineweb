---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { ArrowLeft, ExternalLink, Share2, Gamepad2 } from "lucide-astro";
---

<BaseLayout
  title="Game Details | Blanc Engine Showcase"
  description="Explore a visual novel created with Blanc Engine."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Showcase", path: "/showcase/" },
    { name: "Game Details", path: "/showcase/game/" },
  ]}
>
  <Navbar />

  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <!-- Top Breadcrumb -->
    <div>
      <a
        href="/showcase/"
        class="inline-flex items-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-3 py-1.5 text-xs font-medium text-text-secondary transition-colors hover:border-accent-primary hover:text-text-primary"
      >
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>Back to Showcase</span>
      </a>
    </div>

    <!-- Loading State -->
    <div id="game-loading" class="mt-8 rounded-lg border border-border-default bg-surface-primary p-8 text-sm text-text-secondary">
      Loading game details...
    </div>

    <!-- Not Found State -->
    <div id="game-not-found" class="mt-8 hidden rounded-lg border border-border-default bg-surface-primary p-8 text-center">
      <p class="text-lg font-semibold text-text-primary">Game not found</p>
      <p class="mt-2 text-sm text-text-secondary">
        This project may have been removed or the link is incomplete.
      </p>
      <a
        href="/showcase/"
        class="mt-5 inline-flex h-10 items-center rounded-md bg-accent-primary px-4 text-xs font-semibold text-text-on-accent hover:bg-accent-hover"
      >
        Browse All Games
      </a>
    </div>

    <!-- Article Content -->
    <article id="game-article" class="mt-8 hidden">
      <!-- Header -->
      <header class="border-b border-border-default pb-6">
        <div class="flex flex-wrap items-center gap-2.5">
          <span id="art-status" class="rounded border border-border-default bg-surface-primary px-2.5 py-0.5 font-mono text-xs font-medium"></span>
          <span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted">
            <Gamepad2 class="h-3.5 w-3.5 text-accent-primary" />
            Made with Blanc Engine
          </span>
        </div>

        <h1 id="art-title" class="mt-3 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl"></h1>
        <p id="art-author" class="mt-1.5 font-mono text-sm text-text-secondary"></p>

        <div id="art-tags" class="mt-4 flex flex-wrap gap-1.5"></div>
      </header>

      <!-- Full-Width Cover Image -->
      <div class="mt-6 overflow-hidden rounded-lg border border-border-default bg-surface-primary p-2 sm:p-3">
        <div class="aspect-video w-full overflow-hidden rounded border border-border-subtle bg-bg-primary">
          <img id="art-cover" src="" alt="" class="h-full w-full object-cover" />
        </div>
      </div>

      <!-- 2-Column Article Body + Info Sidebar -->
      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-8">
          <h2 class="text-lg font-semibold text-text-primary">About This Visual Novel</h2>
          <div id="art-desc" class="mt-3 space-y-4 whitespace-pre-line text-sm leading-relaxed text-text-secondary sm:text-base"></div>
        </div>

        <aside class="min-w-0 lg:col-span-4">
          <div class="rounded-lg border border-border-default bg-surface-primary p-5">
            <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-muted">
              Project Info
            </h2>

            <dl class="mt-4 space-y-3 border-t border-border-subtle pt-4 text-xs sm:text-sm">
              <div class="flex items-center justify-between gap-2">
                <dt class="text-text-muted">Creator</dt>
                <dd id="side-author" class="font-medium text-text-primary text-right"></dd>
              </div>
              <div class="flex items-center justify-between gap-2">
                <dt class="text-text-muted">Status</dt>
                <dd id="side-status" class="font-mono text-xs text-text-primary text-right"></dd>
              </div>
              <div class="flex items-center justify-between gap-2">
                <dt class="text-text-muted">Engine</dt>
                <dd class="font-mono text-xs text-accent-primary text-right">Blanc Engine</dd>
              </div>
            </dl>

            <div class="mt-6 space-y-2.5 border-t border-border-subtle pt-4">
              <a
                id="art-play-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-10 w-full items-center justify-center gap-1.5 rounded-md bg-accent-primary px-4 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover"
              >
                <span>Play / Download</span>
                <ExternalLink class="h-3.5 w-3.5" />
              </a>

              <button
                id="art-share-btn"
                type="button"
                class="inline-flex h-9 w-full items-center justify-center gap-1.5 rounded-md border border-border-default bg-bg-secondary px-4 text-xs font-medium text-text-primary transition-colors hover:border-accent-primary hover:bg-surface-hover cursor-pointer"
              >
                <Share2 class="h-3.5 w-3.5 text-text-secondary" />
                <span id="art-share-label">Copy Share Link</span>
              </button>
            </div>
          </div>
        </aside>
      </div>

      <!-- More Games Strip -->
      <section id="more-games-section" class="mt-14 hidden border-t border-border-default pt-10">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-text-primary">More Games Made With Blanc Engine</h2>
          <a href="/showcase/" class="text-xs font-medium text-accent-primary hover:underline">
            View All
          </a>
        </div>
        <div id="more-games-grid" class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  const SHEET_GVIZ_URL =
    "https://docs.google.com/spreadsheets/d/1VCNAuxsX3QyiQtOONYbZYZIUbRRhjrd9oaMddh_8O7g/gviz/tq?tqx=out:json&gid=658897965&headers=1";

  interface ShowcaseGame {
    slug: string;
    title: string;
    author: string;
    status: string;
    genre: string;
    cover: string;
    url: string;
    description: string;
  }

  function toSlug(str: string): string {
    return str
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function esc(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function statusBadgeStyle(status: string): string {
    const s = status.toLowerCase();
    if (s === "released") return "border-status-success text-status-success";
    if (s === "demo") return "border-accent-primary text-accent-primary";
    return "border-status-warning text-status-warning";
  }

  async function initGamePage() {
    const loadingEl = document.getElementById("game-loading");
    const notFoundEl = document.getElementById("game-not-found");
    const articleEl = document.getElementById("game-article");

    const requestedSlug = new URLSearchParams(window.location.search).get("id") || "";

    let games: ShowcaseGame[] = [];
    try {
      const res = await fetch(SHEET_GVIZ_URL);
      if (res.ok) {
        const text = await res.text();
        const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]+)\);?/);
        if (match) {
          const json = JSON.parse(match[1]);
          const rows = json?.table?.rows || [];
          for (const row of rows) {
            const c = row.c || [];
            const getVal = (idx: number) => (c[idx] && c[idx].v != null ? String(c[idx].v).trim() : "");
            const approvedRaw = getVal(8).toLowerCase();
            const isApproved = approvedRaw === "true" || approvedRaw === "1" || approvedRaw === "yes";
            const title = getVal(1);
            if (!title || title.toLowerCase() === "game title" || !isApproved) continue;

            games.push({
              slug: toSlug(title),
              title,
              author: getVal(2) || "Unknown Creator",
              status: getVal(3) || "Released",
              genre: getVal(4),
              cover: getVal(5),
              url: getVal(6) || "#",
              description: getVal(7),
            });
          }
          games.reverse();
        }
      }
    } catch {
      // Fallback handled below
    }

    const game = games.find((g) => g.slug === requestedSlug) || (requestedSlug ? null : games[0]);

    loadingEl?.classList.add("hidden");

    if (!game) {
      notFoundEl?.classList.remove("hidden");
      return;
    }

    document.title = `${game.title} | Blanc Engine Showcase`;

    const statusEl = document.getElementById("art-status");
    const titleEl = document.getElementById("art-title");
    const authorEl = document.getElementById("art-author");
    const tagsEl = document.getElementById("art-tags");
    const coverEl = document.getElementById("art-cover") as HTMLImageElement | null;
    const descEl = document.getElementById("art-desc");
    const sideAuthor = document.getElementById("side-author");
    const sideStatus = document.getElementById("side-status");
    const playLink = document.getElementById("art-play-link") as HTMLAnchorElement | null;

    if (statusEl) {
      statusEl.textContent = game.status;
      statusEl.className = `rounded border ${statusBadgeStyle(game.status)} bg-surface-primary px-2.5 py-0.5 font-mono text-xs font-medium`;
    }
    if (titleEl) titleEl.textContent = game.title;
    if (authorEl) authorEl.textContent = `by ${game.author}`;
    if (sideAuthor) sideAuthor.textContent = game.author;
    if (sideStatus) sideStatus.textContent = game.status;
    if (descEl) descEl.textContent = game.description;
    if (playLink) playLink.href = game.url || "#";

    if (coverEl) {
      coverEl.src = game.cover || "/screenshots/SS_GAMEPLAY_1_CHARACTER.png";
      coverEl.alt = game.title;
      coverEl.onerror = () => {
        coverEl.src = "/screenshots/SS_GAMEPLAY_1_CHARACTER.png";
      };
    }

    if (tagsEl) {
      const tags = game.genre
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      tagsEl.innerHTML = tags
        .map(
          (tag) =>
            `<span class="rounded border border-border-default bg-bg-secondary px-2.5 py-0.5 font-mono text-xs text-text-secondary">${esc(tag)}</span>`
        )
        .join("");
    }

    const others = games.filter((g) => g.slug !== game.slug).slice(0, 3);
    const moreSec = document.getElementById("more-games-section");
    const moreGrid = document.getElementById("more-games-grid");
    if (others.length > 0 && moreSec && moreGrid) {
      moreGrid.innerHTML = others
        .map(
          (other) => `
          <a
            href="/showcase/game/?id=${encodeURIComponent(other.slug)}"
            class="flex flex-col overflow-hidden rounded-lg border border-border-default bg-surface-primary transition-colors hover:border-accent-primary"
          >
            <div class="aspect-video w-full overflow-hidden border-b border-border-subtle bg-bg-primary">
              <img
                src="${esc(other.cover)}"
                alt="${esc(other.title)}"
                class="h-full w-full object-cover"
                loading="lazy"
                onerror="this.src='/screenshots/SS_GAMEPLAY_1_CHARACTER.png'"
              />
            </div>
            <div class="p-4">
              <div class="flex items-center justify-between gap-2">
                <h3 class="truncate text-sm font-semibold text-text-primary">${esc(other.title)}</h3>
                <span class="shrink-0 rounded border ${statusBadgeStyle(other.status)} bg-bg-secondary px-2 py-0.5 font-mono text-[10px]">
                  ${esc(other.status)}
                </span>
              </div>
              <p class="mt-0.5 font-mono text-xs text-text-muted">by ${esc(other.author)}</p>
            </div>
          </a>
        `
        )
        .join("");
      moreSec.classList.remove("hidden");
    }

    articleEl?.classList.remove("hidden");
  }

  const shareBtn = document.getElementById("art-share-btn");
  const shareLabel = document.getElementById("art-share-label");
  shareBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (shareLabel) shareLabel.textContent = "Link Copied!";
      setTimeout(() => {
        if (shareLabel) shareLabel.textContent = "Copy Share Link";
      }, 2000);
    } catch {
      // Ignore clipboard errors
    }
  });

  initGamePage();
</script>
