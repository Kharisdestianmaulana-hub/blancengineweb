  </main>

  <Footer />
</BaseLayout>

<script>
  interface GitHubAsset {
    name: string;
    size: number;
    browser_download_url: string;
    download_count: number;
    digest?: string;
  }

  interface GitHubRelease {
    tag_name: string;
    name: string;
    prerelease: boolean;
    draft: boolean;
    published_at: string;
    html_url: string;
    body: string;
    assets: GitHubAsset[];
  }

  interface ShowcaseGame {
    title: string;
    author: string;
    cover: string;
    url: string;
  }

  const SHEET_URL =
    "https://docs.google.com/spreadsheets/d/1VCNAuxsX3QyiQtOONYbZYZIUbRRhjrd9oaMddh_8O7g/gviz/tq?tqx=out:json&gid=658897965&headers=1";

  // Elements
  const heroBtnInstaller = document.getElementById("hero-btn-installer") as HTMLAnchorElement | null;
  const heroVersionTagInstaller = document.getElementById("hero-version-tag-installer");
  const heroSubtextInstaller = document.getElementById("hero-subtext-installer");

  const heroBtnPortable = document.getElementById("hero-btn-portable") as HTMLAnchorElement | null;
  const heroVersionTagPortable = document.getElementById("hero-version-tag-portable");
  const heroSubtextPortable = document.getElementById("hero-subtext-portable");

  const binaryNameInstaller = document.getElementById("binary-name-installer");
  const binaryLinkInstaller = document.getElementById("binary-link-installer") as HTMLAnchorElement | null;

  const binaryNamePortable = document.getElementById("binary-name-portable");
  const binaryLinkPortable = document.getElementById("binary-link-portable") as HTMLAnchorElement | null;

  const btnCopySha = document.getElementById("btn-copy-sha256");
  const shaInput = document.getElementById("sha256-input") as HTMLInputElement | null;

  const heroBgLayer1 = document.getElementById("hero-bg-layer-1");
  const heroBgLayer2 = document.getElementById("hero-bg-layer-2");
  const heroCreditBadge = document.getElementById("hero-credit-badge") as HTMLAnchorElement | null;
  const heroCreditText = document.getElementById("hero-credit-text");

  function formatBytes(bytes: number): string {
    if (!bytes) return "0 MB";
    const mb = bytes / (1024 * 1024);
    return mb >= 1 ? `${mb.toFixed(1)} MB` : `${(bytes / 1024).toFixed(0)} KB`;
  }

  function formatDate(iso: string): string {
    if (!iso) return "";
    return new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  async function loadLatestRelease() {
    try {
      const res = await fetch("https://api.github.com/repos/Kharisdestianmaulana-hub/blanc-engine/releases", {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!res.ok) return;
      const releases: GitHubRelease[] = await res.json();
      if (!Array.isArray(releases) || releases.length === 0) return;

      const latestStable = releases.find((r) => !r.prerelease && !r.draft) || releases[0];
      if (!latestStable) return;

      const tag = latestStable.tag_name || "v0.1.1";
      const dateStr = formatDate(latestStable.published_at);

      // Find assets
      const installerAsset = latestStable.assets?.find((a) =>
        a.name.toLowerCase().includes("setup")
      );
      const portableAsset = latestStable.assets?.find((a) =>
        a.name.toLowerCase().includes("portable")
      );

      if (installerAsset && heroBtnInstaller) {
        heroBtnInstaller.href = installerAsset.browser_download_url;
        if (heroVersionTagInstaller) heroVersionTagInstaller.textContent = tag;
        if (heroSubtextInstaller) {
          heroSubtextInstaller.textContent = `Windows Setup (.exe) · ${formatBytes(installerAsset.size)} · ${dateStr}`;
        }
        if (binaryNameInstaller) binaryNameInstaller.textContent = installerAsset.name;
        if (binaryLinkInstaller) binaryLinkInstaller.href = installerAsset.browser_download_url;
      }

      if (portableAsset && heroBtnPortable) {
        heroBtnPortable.href = portableAsset.browser_download_url;
        if (heroVersionTagPortable) heroVersionTagPortable.textContent = tag;
        if (heroSubtextPortable) {
          heroSubtextPortable.textContent = `Single-file executable · ${formatBytes(portableAsset.size)} · ${dateStr}`;
        }
        if (binaryNamePortable) binaryNamePortable.textContent = portableAsset.name;
        if (binaryLinkPortable) binaryLinkPortable.href = portableAsset.browser_download_url;
      }
    } catch {
      // Keep static defaults
    }
  }

  // Copy SHA-256 logic
  btnCopySha?.addEventListener("click", async () => {
    if (!shaInput) return;
    try {
      await navigator.clipboard.writeText(shaInput.value);
      const span = btnCopySha.querySelector("span");
      if (span) {
        const orig = span.textContent;
        span.textContent = "Copied!";
        setTimeout(() => {
          span.textContent = orig;
        }, 2000);
      }
    } catch {
      // Fallback
    }
  });

  // Dynamic Showcase Artwork Slideshow
  async function initShowcaseHeroBackground() {
    if (!heroBgLayer1 || !heroBgLayer2 || !heroCreditBadge || !heroCreditText) return;

    try {
      const res = await fetch(SHEET_URL);
      if (!res.ok) return;
      const text = await res.text();
      const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]+)\);?/);
      if (!match) return;

      const json = JSON.parse(match[1]);
      const rows = json?.table?.rows || [];
      const games: ShowcaseGame[] = [];

      const toSlug = (str: string) =>
        str
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");

      for (const row of rows) {
        const c = row.c || [];
        const status = c[6]?.v?.toString()?.toLowerCase() || "";
        if (status !== "approved") continue;

        const title = c[1]?.v?.toString() || "";
        const author = c[2]?.v?.toString() || "";
        const cover = c[5]?.v?.toString() || "";

        if (title && cover) {
          games.push({
            title,
            author,
            cover,
            url: `/showcase/game?id=${encodeURIComponent(toSlug(title))}`,
          });
        }
      }

      if (games.length === 0) return;

      let currentIndex = 0;
      let activeLayer = 1;

      const applyGame = (game: ShowcaseGame) => {
        const targetLayer = activeLayer === 1 ? heroBgLayer2 : heroBgLayer1;
        const currentLayer = activeLayer === 1 ? heroBgLayer1 : heroBgLayer2;

        targetLayer.style.backgroundImage = `url('${game.cover}')`;
        targetLayer.style.opacity = "1";
        currentLayer.style.opacity = "0";

        activeLayer = activeLayer === 1 ? 2 : 1;

        heroCreditText.textContent = `${game.title} by ${game.author}`;
        heroCreditBadge.href = game.url;
        heroCreditBadge.classList.remove("hidden");
        heroCreditBadge.classList.add("inline-flex");
      };

      // Set initial showcase game
      applyGame(games[0]);

      if (games.length > 1) {
        setInterval(() => {
          currentIndex = (currentIndex + 1) % games.length;
          applyGame(games[currentIndex]);
        }, 7000);
      }
    } catch {
      // Keep default gameplay screenshot
    }
  }

  loadLatestRelease();
  initShowcaseHeroBackground();
</script>
