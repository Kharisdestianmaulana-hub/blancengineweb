---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  Download,
  Terminal,
  Package,
  ExternalLink,
  RefreshCw,
  Sparkles,
  Archive,
  Check,
  Copy,
  ShieldAlert,
  Monitor,
  Laptop,
  BookOpen,
  Gamepad2,
  ArrowUpRight,
  ChevronRight,
  Info,
  Layers,
  FolderArchive,
  ArrowRight,
} from "lucide-astro";
---

<BaseLayout
  title="Download Blanc Engine: Official Windows Release & Tools"
  description="Download the latest official release of Blanc Engine for Windows 64-bit. Available as an easy Windows Installer (.exe) or standalone Portable build, with zero code required."
  ogImage="/screenshots/SS_SETUP_WIZARD.png"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Download", path: "/download/" }]}
>
  <Navbar />

  <!-- 1. Hero Section (Cinematic Artwork Background ala Godot) -->
  <section
    id="download-hero"
    class="relative w-full overflow-hidden border-b border-border-default min-h-[480px] sm:min-h-[540px] lg:min-h-[580px] flex items-center justify-center"
  >
    <!-- Background Slideshow / Fallback Gameplay Artwork -->
    <div
      id="hero-bg-wrapper"
      class="pointer-events-none absolute inset-0 z-0 bg-cover bg-center transition-all duration-1000"
      style="background-image: url('/screenshots/SS_GAMEPLAY_2_CHARACTER.png');"
    >
      <div
        id="hero-bg-layer-1"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-1000 opacity-100"
        style="background-image: url('/screenshots/SS_GAMEPLAY_2_CHARACTER.png');"
      ></div>
      <div
        id="hero-bg-layer-2"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0 transition-opacity duration-1000"
      ></div>
    </div>

    <!-- Dark Cinematic Gradient Overlays -->
    <div class="absolute inset-0 z-[1] bg-gradient-to-t from-bg-primary via-bg-primary/85 to-bg-primary/50"></div>
    <div class="absolute inset-0 z-[1] bg-radial from-transparent via-bg-primary/30 to-bg-primary/80"></div>

    <!-- Hero Content (Centered) -->
    <div class="relative z-10 mx-auto w-full max-w-4xl px-4 py-16 sm:px-6 text-center">
      <!-- Platform Badge Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-accent-primary/40 bg-surface-primary/80 px-3.5 py-1 backdrop-blur-md shadow-sm">
        <Monitor class="h-3.5 w-3.5 text-accent-primary" />
        <span class="font-mono text-xs font-semibold text-text-primary">Windows 64-bit (x86_64)</span>
        <span class="h-1.5 w-1.5 rounded-full bg-status-success animate-pulse"></span>
      </div>

      <!-- Main Heading -->
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] sm:text-4xl lg:text-5xl leading-tight">
        Download Blanc Engine for Windows
      </h1>

      <!-- Subtitle -->
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-text-secondary drop-shadow-[0_1px_3px_rgba(0,0,0,0.6)] sm:text-base">
        Free, open-source, no-code visual novel studio. Create your story, design custom interfaces visually, and package a ready-to-play Windows game.
      </p>

      <!-- Dual Split Download Buttons (Opsi 1: Installer vs Portable) -->
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
        <!-- Button 1: Windows Installer (.exe) - Recommended Primary -->
        <div class="group flex flex-col items-center">
          <div class="inline-flex rounded-lg shadow-xl shadow-accent-primary/10 transition-transform active:scale-[0.99]">
            <a
              id="hero-btn-installer"
              href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.1/BlancEngine-0.1.1-Setup.exe"
              class="inline-flex h-12 items-center gap-2.5 rounded-l-lg bg-accent-primary px-5 text-sm font-bold text-text-on-accent transition-colors hover:bg-accent-hover cursor-pointer"
            >
              <Download class="h-4 w-4" />
              <span>Download Installer</span>
            </a>
            <span
              id="hero-version-tag-installer"
              class="inline-flex h-12 items-center justify-center rounded-r-lg bg-accent-hover px-3.5 font-mono text-xs font-bold text-text-on-accent border-l border-white/15"
            >
              v0.1.1
            </span>
          </div>
          <span
            id="hero-subtext-installer"
            class="mt-2 font-mono text-[11px] text-text-muted drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"
          >
            Windows Setup (.exe) · ~27.7 MB · Recommended
          </span>
        </div>

        <!-- Button 2: Standalone Portable (.exe/.zip) - Secondary Frosted Glass -->
        <div class="group flex flex-col items-center">
          <div class="inline-flex rounded-lg shadow-xl transition-transform active:scale-[0.99]">
            <a
              id="hero-btn-portable"
              href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.1/BlancEngine-0.1.1-Portable.exe"
              class="inline-flex h-12 items-center gap-2.5 rounded-l-lg border border-border-default bg-surface-primary/90 px-5 text-sm font-bold text-text-primary backdrop-blur-md transition-colors hover:bg-surface-hover hover:border-accent-primary/50 cursor-pointer"
            >
              <Package class="h-4 w-4 text-text-muted group-hover:text-accent-primary transition-colors" />
              <span>Download Portable</span>
            </a>
            <span
              id="hero-version-tag-portable"
              class="inline-flex h-12 items-center justify-center rounded-r-lg border-y border-r border-border-default bg-surface-primary/90 px-3.5 font-mono text-xs font-semibold text-text-secondary backdrop-blur-md"
            >
              v0.1.1
            </span>
          </div>
          <span
            id="hero-subtext-portable"
            class="mt-2 font-mono text-[11px] text-text-muted drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"
          >
            Single-file executable · ~128 MB · No install needed
          </span>
        </div>
      </div>

      <!-- Quick Nav Helpers Below Hero Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-text-muted">
        <a
          href="/download/archive/"
          class="inline-flex items-center gap-1.5 font-medium text-accent-primary hover:underline"
        >
          <FolderArchive class="h-3.5 w-3.5" />
          <span>Browse Blanc Archive (Previous Versions & Changelogs)</span>
          <ArrowRight class="h-3 w-3" />
        </a>
        <span class="text-border-default" aria-hidden="true">•</span>
        <a href="#supported-platforms" class="hover:text-text-primary transition-colors">
          Other Platforms (Linux & macOS Roadmap)
        </a>
      </div>
    </div>

    <!-- Community Showcase Credit Badge (Bottom Right) -->
    <a
      id="hero-credit-badge"
      href="/showcase"
      class="pointer-events-auto absolute bottom-4 right-4 sm:bottom-5 sm:right-6 z-20 hidden items-center gap-2 rounded-full border border-border-default bg-surface-primary/90 px-3.5 py-1.5 font-mono text-xs text-text-secondary shadow-lg backdrop-blur-md transition-all hover:border-text-secondary hover:bg-surface-hover hover:text-text-primary"
      title="Artwork from featured community visual novel in showcase"
    >
      <Gamepad2 class="h-3.5 w-3.5 text-text-muted shrink-0" />
      <span class="text-text-muted">Artwork:</span>
      <span id="hero-credit-text" class="truncate max-w-[180px] sm:max-w-xs font-semibold text-text-primary">Featured Game</span>
      <ArrowUpRight class="h-3.5 w-3.5 text-text-muted shrink-0" />
    </a>
  </section>

  <!-- 2. Main Content Container -->
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12 space-y-12">

    <!-- Section A: System Requirements Matrix (Card ala Godot) -->
    <section class="rounded-xl border border-border-default bg-surface-primary p-6 sm:p-7 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-border-subtle pb-4">
        <div>
          <h2 class="text-base font-bold text-text-primary sm:text-lg flex items-center gap-2">
            <Laptop class="h-4 w-4 text-accent-primary" />
            <span>System Requirements</span>
          </h2>
          <p class="mt-0.5 text-xs text-text-secondary">
            Blanc Engine is lightweight and engineered in native Rust for fast startup and minimal memory usage.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded bg-bg-secondary px-2.5 py-1 font-mono text-[11px] text-text-muted border border-border-default shrink-0">
          Arch: 64-bit Only
        </span>
      </div>

      <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
        <!-- Minimum Requirements -->
        <div class="space-y-2.5 rounded-lg border border-border-subtle bg-bg-secondary/60 p-4">
          <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-text-muted">
            Minimum Specifications
          </div>
          <ul class="space-y-1.5 text-text-secondary">
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Operating System:</strong> Windows 10 (64-bit) or Windows 11</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Processor:</strong> Dual-Core Intel/AMD x86_64 CPU (1.8 GHz+)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Memory:</strong> 4 GB RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Graphics:</strong> OpenGL 3.3 or DirectX 11 compatible GPU</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Storage:</strong> 500 MB free space for editor & starter templates</span>
            </li>
          </ul>
        </div>

        <!-- Recommended Requirements -->
        <div class="space-y-2.5 rounded-lg border border-accent-primary/20 bg-accent-subtle/30 p-4">
          <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-accent-primary">
            Recommended Specifications
          </div>
          <ul class="space-y-1.5 text-text-secondary">
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Operating System:</strong> Windows 11 (64-bit, latest updates)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Processor:</strong> Quad-Core 2.5 GHz+ CPU for instant timeline scrubbing</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Memory:</strong> 8 GB RAM or more for high-res 4K sprites and audio editing</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Graphics:</strong> Dedicated GPU with Vulkan / DX11 for 60 FPS runtime preview</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent-primary font-bold">•</span>
              <span><strong>Storage:</strong> Fast SSD for rapid audio and image asset previews</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section B: Two-Column Details (All Downloads vs Instructions) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: All Downloads & Direct Binaries (7 Cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex items-center justify-between border-b border-border-default pb-3">
          <div>
            <h2 class="text-base font-bold text-text-primary">All Downloads &amp; Binaries</h2>
            <p class="text-xs text-text-secondary">Choose the format that fits your workflow.</p>
          </div>
          <a
            href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-text-primary transition-colors"
          >
            <span>GitHub Releases</span>
            <ExternalLink class="h-3 w-3" />
          </a>
        </div>

        <!-- Download Cards List -->
        <div class="space-y-3" id="downloads-list">
          <!-- Card 1: Installer -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-lg border border-border-default bg-surface-primary p-4 hover:border-accent-primary/60 transition-colors">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="rounded bg-accent-subtle px-1.5 py-0.5 font-mono text-[10px] font-bold text-accent-primary">
                  Installer
                </span>
                <span class="font-mono text-xs font-semibold text-text-primary" id="binary-name-installer">
                  BlancEngine-0.1.1-Setup.exe
                </span>
              </div>
              <p class="text-xs text-text-secondary">
                Standard Windows setup with Start Menu shortcuts and automatic file associations (.blanc).
              </p>
            </div>
            <a
              id="binary-link-installer"
              href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.1/BlancEngine-0.1.1-Setup.exe"
              class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-md bg-accent-primary px-4 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover cursor-pointer"
            >
              <Download class="h-3.5 w-3.5" />
              <span>Download (.exe)</span>
            </a>
          </div>

          <!-- Card 2: Portable -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-lg border border-border-default bg-surface-primary p-4 hover:border-accent-primary/60 transition-colors">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="rounded bg-surface-hover px-1.5 py-0.5 font-mono text-[10px] font-semibold text-text-secondary">
                  Portable
                </span>
                <span class="font-mono text-xs font-semibold text-text-primary" id="binary-name-portable">
                  BlancEngine-0.1.1-Portable.exe
                </span>
              </div>
              <p class="text-xs text-text-secondary">
                Single-file portable executable. Unzip and run directly from anywhere, including flash drives.
              </p>
            </div>
            <a
              id="binary-link-portable"
              href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/releases/download/v0.1.1/BlancEngine-0.1.1-Portable.exe"
              class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-4 text-xs font-semibold text-text-primary transition-colors hover:bg-surface-hover hover:border-accent-primary/50 cursor-pointer"
            >
              <Download class="h-3.5 w-3.5 text-text-muted" />
              <span>Download (.exe)</span>
            </a>
          </div>

          <!-- Card 3: Source Code -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-lg border border-border-default bg-surface-primary p-4 hover:border-accent-primary/60 transition-colors">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="rounded bg-surface-hover px-1.5 py-0.5 font-mono text-[10px] font-semibold text-text-secondary">
                  Source
                </span>
                <span class="font-mono text-xs font-semibold text-text-primary">
                  Source code (v0.1.1.zip)
                </span>
              </div>
              <p class="text-xs text-text-secondary">
                Complete Rust workspace source code licensed under GNU GPLv3.
              </p>
            </div>
            <a
              href="https://github.com/Kharisdestianmaulana-hub/blanc-engine/archive/refs/tags/v0.1.1.zip"
              class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-md border border-border-default bg-surface-primary px-4 text-xs font-semibold text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary cursor-pointer"
            >
              <Download class="h-3.5 w-3.5 text-text-muted" />
              <span>Source (.zip)</span>
            </a>
          </div>
        </div>

        <!-- SHA-256 Hash Copy Box -->
        <div class="rounded-lg border border-border-subtle bg-bg-secondary p-4 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-semibold text-text-muted uppercase">SHA-256 Verification</span>
            <span class="text-[10px] text-text-muted">v0.1.1 Setup Digest</span>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="text"
              readonly
              value="0444d82108fbe8c6f6ac4af37aca99e7b0f5337f4deaa4c2475593732522b4db"
              class="flex-1 rounded border border-border-default bg-bg-primary px-2.5 py-1 font-mono text-[11px] text-text-muted select-all focus:outline-none"
              id="sha256-input"
            />
            <button
              type="button"
              id="btn-copy-sha256"
              class="inline-flex h-7 items-center gap-1 rounded border border-border-default bg-surface-primary px-2.5 text-[11px] font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
            >
              <Copy class="h-3 w-3" />
              <span>Copy</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Instructions & First-Run Notes (5 Cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="border-b border-border-default pb-3">
          <h2 class="text-base font-bold text-text-primary">First-Run Instructions</h2>
          <p class="text-xs text-text-secondary">Important notes for getting started smoothly.</p>
        </div>

        <!-- Extract & Run Card -->
        <div class="rounded-lg border border-border-default bg-surface-primary p-4 space-y-2 text-xs text-text-secondary leading-relaxed">
          <div class="flex items-center gap-2 font-semibold text-text-primary">
            <Package class="h-4 w-4 text-accent-primary" />
            <span>Extract &amp; Run Workflow</span>
          </div>
          <p>
            Blanc Engine Portable is completely self-contained. You do not need admin privileges or external runtime installers. Simply extract the files into any folder and double click <code>BlancEngine-Portable.exe</code>.
          </p>
        </div>

        <!-- Windows SmartScreen Help Card -->
        <div class="rounded-lg border border-status-warning/30 bg-status-warning/5 p-4 space-y-2 text-xs leading-relaxed">
          <div class="flex items-center gap-2 font-semibold text-status-warning">
            <ShieldAlert class="h-4 w-4" />
            <span>Windows SmartScreen Notice</span>
          </div>
          <p class="text-text-secondary">
            Because Blanc Engine is a community open-source release without an expensive commercial EV certificate, Windows may show a <em>"Windows protected your PC"</em> prompt on first run:
          </p>
          <ol class="list-decimal pl-4 space-y-1 text-text-secondary">
            <li>Click <strong>More info</strong> on the prompt dialog.</li>
            <li>Click <strong>Run anyway</strong> to launch Blanc Studio.</li>
          </ol>
          <p class="font-mono text-[10px] text-text-muted pt-1">
            All binaries are compiled directly from public GitHub Actions and verifiable with SHA-256.
          </p>
        </div>

        <!-- Creator Ownership Card -->
        <div class="rounded-lg border border-border-default bg-surface-primary p-4 space-y-2 text-xs text-text-secondary leading-relaxed">
          <div class="flex items-center gap-2 font-semibold text-text-primary">
            <Sparkles class="h-4 w-4 text-status-success" />
            <span>100% Creator-Owned Games</span>
          </div>
          <p>
            Blanc Engine is licensed under <strong>GNU GPLv3</strong>. Any visual novel, art, script, and story you create and package with Blanc Engine belongs 100% to you to distribute, sell on Steam/Itch.io, or share freely with zero royalties.
          </p>
        </div>
      </div>
    </div>

    <!-- Section C: Supported Platforms Bar -->
    <section id="supported-platforms" class="rounded-xl border border-border-default bg-surface-primary p-6 shadow-sm">
      <div class="text-center max-w-xl mx-auto mb-6">
        <h2 class="text-base font-bold text-text-primary sm:text-lg">Supported Platforms</h2>
        <p class="mt-1 text-xs text-text-secondary">
          Blanc Engine editor and runtime roadmap across desktop and mobile platforms.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <!-- Windows (Active) -->
        <div class="rounded-lg border border-status-success/50 bg-status-success/5 p-4 text-center space-y-1.5">
          <div class="inline-flex p-2 rounded-full bg-status-success/10 text-status-success">
            <Monitor class="h-5 w-5" />
          </div>
          <div class="font-bold text-xs text-text-primary">Windows</div>
          <span class="inline-block rounded-full bg-status-success/20 px-2 py-0.5 font-mono text-[10px] font-semibold text-status-success">
            Available Now
          </span>
          <p class="text-[10px] text-text-muted">Installer &amp; Portable 64-bit</p>
        </div>

        <!-- macOS (Roadmap) -->
        <div class="rounded-lg border border-border-subtle bg-bg-secondary p-4 text-center space-y-1.5 opacity-80">
          <div class="inline-flex p-2 rounded-full bg-surface-hover text-text-muted">
            <Laptop class="h-5 w-5" />
          </div>
          <div class="font-bold text-xs text-text-primary">macOS</div>
          <span class="inline-block rounded-full bg-surface-hover px-2 py-0.5 font-mono text-[10px] font-medium text-text-muted">
            Planned v0.2.0
          </span>
          <p class="text-[10px] text-text-muted">Universal .dmg &amp; .app</p>
        </div>

        <!-- Linux (Roadmap) -->
        <div class="rounded-lg border border-border-subtle bg-bg-secondary p-4 text-center space-y-1.5 opacity-80">
          <div class="inline-flex p-2 rounded-full bg-surface-hover text-text-muted">
            <Terminal class="h-5 w-5" />
          </div>
          <div class="font-bold text-xs text-text-primary">Linux</div>
          <span class="inline-block rounded-full bg-surface-hover px-2 py-0.5 font-mono text-[10px] font-medium text-text-muted">
            Planned v0.2.0
          </span>
          <p class="text-[10px] text-text-muted">AppImage &amp; Tarball</p>
        </div>

        <!-- Web Runtime (Roadmap) -->
        <div class="rounded-lg border border-border-subtle bg-bg-secondary p-4 text-center space-y-1.5 opacity-80">
          <div class="inline-flex p-2 rounded-full bg-surface-hover text-text-muted">
            <Gamepad2 class="h-5 w-5" />
          </div>
          <div class="font-bold text-xs text-text-primary">Web Player</div>
          <span class="inline-block rounded-full bg-surface-hover px-2 py-0.5 font-mono text-[10px] font-medium text-text-muted">
            Planned
          </span>
          <p class="text-[10px] text-text-muted">HTML5 WebGL Export</p>
        </div>
      </div>
    </section>

    <!-- Section D: Extra Resources (Starter Templates & Documentation) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Starter VN Template Card -->
      <div class="flex flex-col justify-between rounded-xl border border-border-default bg-surface-primary p-6 space-y-4 hover:border-accent-primary/50 transition-colors">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <Layers class="h-4 w-4 text-accent-primary" />
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-accent-primary">Community Starter Kit</span>
          </div>
          <h3 class="text-base font-bold text-text-primary">Starter Visual Novel Project</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Need inspiration? Download our starter visual novel project featuring character sprites, expressions, background scenes, BGM, and pre-configured dialogue choices.
          </p>
        </div>
        <div>
          <a
            href="/docs#getting-started"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent-primary hover:underline"
          >
            <span>Learn with Starter Template</span>
            <ChevronRight class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>

      <!-- 5-Minute Quickstart Guide Card -->
      <div class="flex flex-col justify-between rounded-xl border border-border-default bg-surface-primary p-6 space-y-4 hover:border-accent-primary/50 transition-colors">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <BookOpen class="h-4 w-4 text-accent-primary" />
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-accent-primary">Documentation</span>
          </div>
          <h3 class="text-base font-bold text-text-primary">5-Minute Quickstart Guide</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            New to Blanc Engine? Learn how to write your first screenplay scene, connect story branches on the node canvas, and customize dialogue boxes in 5 minutes.
          </p>
        </div>
        <div>
          <a
            href="/docs#getting-started"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent-primary hover:underline"
          >
            <span>Read Quickstart Guide</span>
            <ChevronRight class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>

    <!-- Section E: Compile from Source & Archive Banner -->
    <section class="rounded-xl border border-border-default bg-surface-primary p-6 sm:p-8 space-y-6">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="flex items-center gap-2">
            <Terminal class="h-4 w-4 text-accent-primary" />
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-accent-primary">Rust Developers</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-text-primary">
            Compile Blanc Engine from Source
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Prefer compiling directly with Rust and Cargo? Clone the repository and run the editor in release mode:
          </p>
          <div class="mt-2 rounded-md border border-border-default bg-bg-secondary p-3 font-mono text-[11px] text-text-primary overflow-x-auto">
            <code>git clone https://github.com/Kharisdestianmaulana-hub/blanc-engine.git<br/>cd blanc-engine<br/>cargo run -p blanc_editor --release</code>
          </div>
        </div>

        <!-- Banner to Blanc Archive -->
        <div class="lg:w-80 shrink-0 rounded-lg border border-accent-primary/30 bg-accent-subtle/30 p-5 space-y-3">
          <div class="flex items-center gap-2 font-bold text-xs text-accent-primary">
            <FolderArchive class="h-4 w-4" />
            <span>Looking for Past Versions?</span>
          </div>
          <p class="text-xs text-text-secondary leading-relaxed">
            Browse our dedicated archive portal for previous stable releases, changelogs, and beta preview builds.
          </p>
          <a
            href="/download/archive/"
            class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-accent-primary py-2 text-xs font-semibold text-text-on-accent transition-colors hover:bg-accent-hover cursor-pointer"
          >
            <span>Open Blanc Archive</span>
            <ArrowRight class="h-3.5 w-3.5" />
